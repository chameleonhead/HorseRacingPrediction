@implements IAsyncDisposable
@using HorseRacingPrediction.Contracts.Races

<div class="race-search-form" role="search">
    <ResponsiveStack Class="race-filter-group">
        <FluentTextInput TextInputType="TextInputType.Search"
                         Placeholder="レース名..."
                         Immediate="true"
                         @bind-Value="Name"
                         @oninput="OnNameInput"
                         @onkeydown="HandleNameKeyDownAsync">

            <StartTemplate>
                <FluentIcon Value="@(new Icons.Regular.Size20.Search())" />
            </StartTemplate>
        </FluentTextInput>
        <FilterSelection Label="開催場"
                         Value="@Course"
                         ValueChanged="OnCourseInput"
                         Items="@CourseOptions" />

        <FilterDateRangePicker From="@From"
                               FromChanged="OnDateFromChanged"
                               To="@To"
                               ToChanged="OnDateToChanged"
                               OnDateFilterChanged="OnDateFilterChangedAsync"
                               Enabled="@DateRangeEnabled"
                               EnabledChanged="DateRangeEnabledChanged" />
    </ResponsiveStack>
</div>

<FluentTabs Class="race-period-tabs"
            ActiveTabId="@Period.ToQueryValue()"
            ActiveTabIdChanged="OnPeriodTabChangedAsync"
            Appearance="TabsAppearance.Subtle"
            Size="TabsSize.Small">
    <FluentTab Id="today" Header="今日" DeferredLoading="true">
        <RaceList Result="@Result" Loading="@Loading" Error="@Error" Page="@Page" PageSize="@PageSize"
                  OnRetry="OnRetry" OnClear="OnClear" OnPreviousPage="OnPreviousPage" OnNextPage="OnNextPage" />
    </FluentTab>
    <FluentTab Id="week" Header="今週" DeferredLoading="true">
        <RaceList Result="@Result" Loading="@Loading" Error="@Error" Page="@Page" PageSize="@PageSize"
                  OnRetry="OnRetry" OnClear="OnClear" OnPreviousPage="OnPreviousPage" OnNextPage="OnNextPage" />
    </FluentTab>
    <FluentTab Id="past-month" Header="過去一ヶ月" DeferredLoading="true">
        <RaceList Result="@Result" Loading="@Loading" Error="@Error" Page="@Page" PageSize="@PageSize"
                  OnRetry="OnRetry" OnClear="OnClear" OnPreviousPage="OnPreviousPage" OnNextPage="OnNextPage" />
    </FluentTab>
    <FluentTab Id="all" Header="すべての期間" DeferredLoading="true">
        <RaceList Result="@Result" Loading="@Loading" Error="@Error" Page="@Page" PageSize="@PageSize"
                  OnRetry="OnRetry" OnClear="OnClear" OnPreviousPage="OnPreviousPage" OnNextPage="OnNextPage" />
    </FluentTab>
</FluentTabs>

@if (!string.IsNullOrWhiteSpace(ValidationMessage))
{
    <FluentMessageBar Intent="@MessageBarIntent.Error">@ValidationMessage</FluentMessageBar>
}

@code {
    private static readonly FilterSelectionOption[] CourseOptions =
    [
        new(string.Empty, "すべて"),
        new("札幌", "札幌競馬場"),
        new("函館", "函館競馬場"),
        new("福島", "福島競馬場"),
        new("新潟", "新潟競馬場"),
        new("東京", "東京競馬場"),
        new("中山", "中山競馬場"),
        new("中京", "中京競馬場"),
        new("京都", "京都競馬場"),
        new("阪神", "阪神競馬場"),
        new("小倉", "小倉競馬場")
    ];

    [Parameter] public string? Name { get; set; }
    [Parameter] public EventCallback<string?> NameChanged { get; set; }
    [Parameter] public string? Course { get; set; }
    [Parameter] public EventCallback<string?> CourseChanged { get; set; }
    [Parameter] public DateOnly? From { get; set; }
    [Parameter] public EventCallback<DateOnly?> FromChanged { get; set; }
    [Parameter] public DateOnly? To { get; set; }
    [Parameter] public EventCallback<DateOnly?> ToChanged { get; set; }
    [Parameter] public bool DateRangeEnabled { get; set; }
    [Parameter] public EventCallback<bool> DateRangeEnabledChanged { get; set; }
    [Parameter] public RacePeriod Period { get; set; }
    [Parameter] public EventCallback<RacePeriod> PeriodChanged { get; set; }
    [Parameter] public SearchRacesResponse? Result { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 50;
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback OnPreviousPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public string? ValidationMessage { get; set; }

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;

    private DateOnly Today => TimeProvider.TodayInJapan();

    private async Task OnPeriodTabChangedAsync(string? tabId)
    {
        if (!RacePeriodExtensions.TryParse(tabId, out var period) || period == Period)
        {
            return;
        }

        var (start, end) = period.ResolveDates(Today);

        await FromChanged.InvokeAsync(start);
        await ToChanged.InvokeAsync(end);
        await PeriodChanged.InvokeAsync(period);
        await DateRangeEnabledChanged.InvokeAsync(period != RacePeriod.All);
        await SearchImmediatelyAsync();
    }

    private async Task OnDateFilterChangedAsync()
    {
        await PeriodChanged.InvokeAsync(RacePeriod.All);
        await SearchImmediatelyAsync();
    }

    private Task OnDateFromChanged(DateOnly? value) => FromChanged.InvokeAsync(value);

    private Task OnDateToChanged(DateOnly? value) => ToChanged.InvokeAsync(value);

    private CancellationTokenSource? nameSearchDebounce;

    private async Task SearchImmediatelyAsync()
    {
        nameSearchDebounce?.Cancel();
        nameSearchDebounce?.Dispose();
        nameSearchDebounce = null;
        await OnSearch.InvokeAsync();
    }

    private async Task HandleNameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.IsComposing)
        {
            await SearchImmediatelyAsync();
        }
    }

    private async Task ClearFiltersImmediatelyAsync()
    {
        nameSearchDebounce?.Cancel();
        nameSearchDebounce?.Dispose();
        nameSearchDebounce = null;
        await OnClear.InvokeAsync();
    }

    private async Task OnNameInput(ChangeEventArgs args)
    {
        await NameChanged.InvokeAsync(args.Value?.ToString());
        nameSearchDebounce?.Cancel();
        nameSearchDebounce?.Dispose();
        nameSearchDebounce = new CancellationTokenSource();
        _ = SearchNameAfterPauseAsync(nameSearchDebounce.Token);
    }

    private async Task SearchNameAfterPauseAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(350), token);
            await SearchImmediatelyAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task OnCourseInput(string? value)
    {
        await CourseChanged.InvokeAsync(value);
        await SearchImmediatelyAsync();
    }

    public ValueTask DisposeAsync()
    {
        nameSearchDebounce?.Cancel();
        nameSearchDebounce?.Dispose();
        return ValueTask.CompletedTask;
    }

}
