<div class="race-search-form" role="search">
    <nav class="race-period-tabs" aria-label="開催期間">
        <button type="button" class="@(IsSelected(PeriodToday) ? "selected" : null)" aria-pressed="@(IsSelected(PeriodToday) ? "true" : "false")" @onclick="() => SelectPeriodAsync(PeriodToday)">今日</button>
        <button type="button" class="@(IsSelected(PeriodWeek) ? "selected" : null)" aria-pressed="@(IsSelected(PeriodWeek) ? "true" : "false")" @onclick="() => SelectPeriodAsync(PeriodWeek)">今週</button>
        <button type="button" class="@(IsSelected(PeriodMonth) ? "selected" : null)" aria-pressed="@(IsSelected(PeriodMonth) ? "true" : "false")" @onclick="() => SelectPeriodAsync(PeriodMonth)">今月</button>
        <button type="button" class="@(IsSelected(PeriodAll) ? "selected" : null)" aria-pressed="@(IsSelected(PeriodAll) ? "true" : "false")" @onclick="() => SelectPeriodAsync(PeriodAll)">すべての期間</button>
    </nav>

    <FluentTextInput Class="race-name-filter" Placeholder="レース名" Value="@Name" @oninput="OnNameInput" />

    <div class="race-filter-group">
        <FilterSelection Label="開催場"
                         Value="@Course"
                         ValueChanged="OnCourseInput"
                         Items="@CourseOptions" />

        <FilterDateRangePicker @bind-From="From"
                               @bind-To="To"
                               @bind-Enabled="DateRangeEnabled" />
    </div>

    <div class="search-actions">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OnSearch">検索</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="OnClear">条件をクリア</FluentButton>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ValidationMessage))
{
    <FluentMessageBar Intent="@MessageBarIntent.Error">@ValidationMessage</FluentMessageBar>
}

@code {
    private const string PeriodToday = "today";
    private const string PeriodWeek = "week";
    private const string PeriodMonth = "month";
    private const string PeriodAll = "all";

    private static readonly FilterSelectionOption[] CourseOptions =
    [
        new(string.Empty, "すべて"),
        new("札幌", "札幌競馬場"),
        new("函館", "函館競馬場"),
        new("福島", "福島競馬場"),
        new("新潟", "新潟競馬場"),
        new("東京", "東京競馬場"),
        new("中山", "中山競馬場"),
        new("中京", "中京競馬場"),
        new("京都", "京都競馬場"),
        new("阪神", "阪神競馬場"),
        new("小倉", "小倉競馬場")
    ];

    [Parameter] public string? Name { get; set; }
    [Parameter] public EventCallback<string?> NameChanged { get; set; }
    [Parameter] public string? Course { get; set; }
    [Parameter] public EventCallback<string?> CourseChanged { get; set; }
    [Parameter] public DateOnly? From { get; set; }
    [Parameter] public EventCallback<DateOnly?> FromChanged { get; set; }
    [Parameter] public DateOnly? To { get; set; }
    [Parameter] public EventCallback<DateOnly?> ToChanged { get; set; }
    [Parameter] public bool DateRangeEnabled { get; set; }
    [Parameter] public EventCallback<bool> DateRangeEnabledChanged { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public string? ValidationMessage { get; set; }

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetUtcNow().ToOffset(TimeSpan.FromHours(9)).Date);

    private bool IsSelected(string period)
    {
        if (period == PeriodAll)
        {
            return From is null && To is null;
        }

        var (start, end) = GetPeriod(period);
        return From == start && To == end;
    }

    private async Task SelectPeriodAsync(string period)
    {
        DateOnly? start = null;
        DateOnly? end = null;

        if (period != PeriodAll)
        {
            (start, end) = GetPeriod(period);
        }

        await FromChanged.InvokeAsync(start);
        await ToChanged.InvokeAsync(end);
        await DateRangeEnabledChanged.InvokeAsync(period != PeriodAll);
        await OnSearch.InvokeAsync();
    }

    private (DateOnly Start, DateOnly End) GetPeriod(string period)
    {
        return period switch
        {
            PeriodToday => (Today, Today),
            PeriodWeek => WeekRange(),
            PeriodMonth => MonthRange(),
            _ => throw new ArgumentOutOfRangeException(nameof(period))
        };
    }

    private (DateOnly Start, DateOnly End) WeekRange()
    {
        var start = Today.AddDays(-(((int)Today.DayOfWeek + 6) % 7));
        return (start, start.AddDays(6));
    }

    private (DateOnly Start, DateOnly End) MonthRange()
    {
        var start = new DateOnly(Today.Year, Today.Month, 1);
        return (start, new DateOnly(Today.Year, Today.Month, DateTime.DaysInMonth(Today.Year, Today.Month)));
    }

    private Task OnNameInput(ChangeEventArgs args)
        => NameChanged.InvokeAsync(args.Value?.ToString());

    private Task OnCourseInput(string? args)
        => CourseChanged.InvokeAsync(args);

}
