@using HorseRacingPrediction.Contracts.Races
@using HorseRacingPrediction.ApiClient.Races
@using Refit
@inject IRacesApi RacesApi

<section aria-labelledby="race-basic-edit-heading">
    <h2 id="race-basic-edit-heading">基本情報</h2>
    <div class="form-grid">
        <label>レース名<input aria-label="レース名" @bind="raceName" /></label>
        <label>開催場コード<input aria-label="開催場コード" @bind="racecourseCode" /></label>
        <label>レース番号<input aria-label="レース番号" type="number" @bind="raceNumber" /></label>
        <label>グレード<input aria-label="グレード" @bind="gradeCode" /></label>
        <label>馬場<input aria-label="馬場" @bind="surfaceCode" /></label>
        <label>距離(m)<input aria-label="距離" type="number" @bind="distanceMeters" /></label>
        <label>回り<input aria-label="回り" @bind="directionCode" /></label>
        <label>補正理由<input aria-label="補正理由" @bind="reason" /></label>
    </div>
    @if (message is not null) { <p role="status">@message</p> }
    @if (error is not null) { <p role="alert">@error</p> }
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveAsync" Disabled="@saving">基本情報を保存</FluentButton>
</section>

@code {
    [Parameter, EditorRequired] public RaceDto Race { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnSaved { get; set; }
    private string? raceName;
    private string? racecourseCode;
    private string? gradeCode;
    private string? surfaceCode;
    private string? directionCode;
    private string? reason;
    private string? message;
    private string? error;
    private int? raceNumber, distanceMeters;
    private bool saving;

    protected override void OnParametersSet()
    {
        raceName = Race.RaceName;
        racecourseCode = Race.RacecourseCode;
        raceNumber = Race.RaceNumber;
        gradeCode = Race.GradeCode;
        surfaceCode = Race.SurfaceCode;
        distanceMeters = Race.DistanceMeters;
        directionCode = Race.DirectionCode;
    }

    private async Task SaveAsync()
    {
        saving = true;
        message = null;
        error = null;
        try
        {
            var response = await RacesApi.CorrectRaceDataAsync(new CorrectRaceDataRequest(new CorrectRaceDataInputDto(raceName, racecourseCode, raceNumber, gradeCode, surfaceCode, distanceMeters, directionCode, reason)));
            if (!response.IsSuccessStatusCode)
            {
                error = "基本情報を保存できませんでした。";
                return;
            }

            message = "基本情報を保存しました。";
            await OnSaved.InvokeAsync();
        }
        catch (ApiException)
        {
            error = "基本情報を保存できませんでした。";
        }
        catch (HttpRequestException)
        {
            error = "APIに接続できませんでした。";
        }
        finally
        {
            saving = false;
        }
    }
}
