@using HorseRacingPrediction.Contracts.Races
@using HorseRacingPrediction.ApiClient.Races
@using Refit

@inject IRacesApi RacesApi

<section aria-labelledby="race-entries-edit-heading">
    <h2 id="race-entries-edit-heading">出走馬情報</h2>
    @if (Race.Entries.Count == 0)
    {
        <p>出走馬情報はありません。</p>
    }
    else
    {
        <FluentDataGrid Items="@values.AsQueryable()" aria-label="出走馬編集">
            <PropertyColumn Property="@(x => x.Entry.HorseNumber)" Title="馬番" />
            <PropertyColumn Property="@(x => x.Entry.HorseName)" Title="馬名" />
            <TemplateColumn Title="馬体重"><input aria-label="@(context.Entry.HorseName ?? context.Entry.HorseId) 馬体重" type="number" @bind="context.Weight" /></TemplateColumn>
            <TemplateColumn Title="増減"><input aria-label="@(context.Entry.HorseName ?? context.Entry.HorseId) 増減" type="number" @bind="context.WeightDiff" /></TemplateColumn>
            <TemplateColumn Title="馬主"><input aria-label="@(context.Entry.HorseName ?? context.Entry.HorseId) 馬主" @bind="context.OwnerName" /></TemplateColumn>
            <TemplateColumn Title="操作"><FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => SaveAsync(context))" Disabled="@saving">保存</FluentButton></TemplateColumn>
        </FluentDataGrid>
    }
    @if (message is not null)
    {
        <p role="status">@message</p>
    }
    @if (error is not null)
    {
        <p role="alert">@error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public RaceDto Race { get; set; } = default!;
    private List<EntryEditValue> values = [];
    private bool saving;
    private string? message;
    private string? error;

    protected override void OnParametersSet()
        => values = Race.Entries
            .Select(x => new EntryEditValue(x, x.DeclaredWeight, x.DeclaredWeightDiff, x.OwnerName))
            .ToList();
    private async Task SaveAsync(EntryEditValue value)
    {
        saving = true;
        message = null;
        error = null;
        try
        {
            var request = new UpdateEntryCollectedDataRequest(
                new UpdateEntryCollectedDataInputDto(value.Weight, value.WeightDiff, value.OwnerName))
            {
                RaceId = Race.RaceId,
                EntryId = value.Entry.EntryId
            };
            var response = await RacesApi.UpdateEntryCollectedDataAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                error = "出走馬情報を保存できませんでした。";
                return;
            }
            message = $"{value.Entry.HorseName ?? value.Entry.HorseId} の情報を保存しました。";
        }
        catch (ApiException)
        {
            error = "出走馬情報を保存できませんでした。";
        }
        catch (HttpRequestException)
        {
            error = "APIに接続できませんでした。";
        }
        finally
        {
            saving = false;
        }
    }
    private sealed class EntryEditValue(RaceEntryDto entry, decimal? weight, decimal? weightDiff, string? ownerName)
    {
        public RaceEntryDto Entry { get; } = entry;
        public decimal? Weight { get; set; } = weight;
        public decimal? WeightDiff { get; set; } = weightDiff;
        public string? OwnerName { get; set; } = ownerName;
    }
}
