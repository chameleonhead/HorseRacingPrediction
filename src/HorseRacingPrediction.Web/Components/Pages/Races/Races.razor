@using HorseRacingPrediction.Contracts.Races
@using HorseRacingPrediction.ApiClient.Races
@using HorseRacingPrediction.Web.Components.Races
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using Refit

@page "/races"
@rendermode InteractiveServer
@inject IRacesApi RacesApi
@inject NavigationManager Navigation

<PageTitle>レース</PageTitle>

<PageHeader Title="レース" Description="レース情報を検索・確認します。">
    <Actions>
        <a href="/races/new">レースを新規作成</a>
    </Actions>
</PageHeader>

<RaceSearchForm @bind-Name="name"
                @bind-Course="course"
                @bind-From="from"
                @bind-To="to"
                @bind-DateRangeEnabled="dateRangeEnabled"
                @bind-Period="period"
                ValidationMessage="@validationError"
                OnSearch="SearchAsync"
                OnClear="ClearFiltersAsync" />

<RaceList Result="@result"
          Loading="@loading"
          Error="@error"
          Page="@currentPage"
          PageSize="@PageSize"
          OnRetry="LoadAsync"
          OnClear="ClearFiltersAsync"
          OnPreviousPage="PreviousPageAsync"
          OnNextPage="NextPageAsync" />

@code {
    private const int PageSize = 50;
    private string? name;
    private string? course;
    private string? error;
    private string? validationError;
    private DateOnly? from;
    private DateOnly? to;
    private bool dateRangeEnabled;
    private RacePeriod period = RacePeriod.All;
    private bool loading;
    private int currentPage = 1;
    private SearchRacesResponse? result;

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;

    private DateOnly Today => TimeProvider.TodayInJapan();

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        name = Text(query, "name");
        course = Text(query, "course");
        if (!RacePeriodExtensions.TryParse(Text(query, "period"), out period))
        {
            period = RacePeriod.All;
        }
        DateOnly? queryFrom = DateOnly.TryParse(Text(query, "from"), out var fromValue) ? fromValue : null;
        DateOnly? queryTo = DateOnly.TryParse(Text(query, "to"), out var toValue) ? toValue : null;
        if (period != RacePeriod.All && (queryFrom is null || queryTo is null))
        {
            (from, to) = period.ResolveDates(Today);
        }
        else
        {
            from = queryFrom;
            to = queryTo;
        }

        dateRangeEnabled = from is not null || to is not null || Text(query, "dateRange") == "true";
        currentPage = int.TryParse(Text(query, "page"), out var pageValue) && pageValue > 0
            ? pageValue
            : 1;

        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        validationError = ValidateFilters();
        if (validationError is not null)
        {
            return;
        }

        currentPage = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        name = null;
        course = null;
        from = null;
        to = null;
        dateRangeEnabled = false;
        period = RacePeriod.All;
        validationError = null;
        currentPage = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            var response = await RacesApi.SearchRacesAsync(new SearchRacesRequest
            {
                RaceName = name,
                RaceCourseCode = course,
                RaceDateFrom = from,
                RaceDateTo = to,
                Page = currentPage,
                PageSize = PageSize,
                SortBy = "raceDate",
                SortDescending = true
            });

            if (response.IsSuccessStatusCode)
            {
                result = response.Content;
                UpdateUrl();
            }
            else
            {
                error = "レース一覧を取得できませんでした。";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private string? ValidateFilters()
    {
        if (from is not null && to is not null && from > to)
        {
            return "終了日は開始日以降の日付を指定してください。";
        }

        return null;
    }

    private async Task PreviousPageAsync()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdateUrl();
            await LoadAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (result is not null && currentPage < result.Pagination.TotalPages)
        {
            currentPage++;
            UpdateUrl();
            await LoadAsync();
        }
    }

    private void UpdateUrl()
    {
        var values = new Dictionary<string, string?>
        {
            ["name"] = name,
            ["course"] = course,
            ["period"] = period.ToQueryValue(),
            ["from"] = from?.ToString("yyyy-MM-dd"),
            ["to"] = to?.ToString("yyyy-MM-dd"),
            ["dateRange"] = dateRangeEnabled && from is null && to is null ? "true" : null,
            ["page"] = currentPage.ToString()
        };

        var uri = QueryHelpers.AddQueryString(
            "/races",
            values.Where(x => !string.IsNullOrWhiteSpace(x.Value)));

        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery != Navigation.ToAbsoluteUri(uri).PathAndQuery)
        {
            Navigation.NavigateTo(uri, replace: true);
        }
    }

    private static string? Text(IDictionary<string, StringValues> query, string key) => query.TryGetValue(key, out var value) ? value.ToString() : null;
}
