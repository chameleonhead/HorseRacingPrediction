@using HorseRacingPrediction.Contracts.Races
@using HorseRacingPrediction.ApiClient.Races
@using HorseRacingPrediction.Web.Components.Races
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives
@using Refit

@page "/races"
@rendermode InteractiveServer
@implements IDisposable
@inject IRacesApi RacesApi
@inject NavigationManager Navigation

<PageTitle>レース</PageTitle>

<PageHeader Title="レース" Description="レース情報を検索・確認します。">
    <Actions>
        <a href="/races/new">レースを新規作成</a>
    </Actions>
</PageHeader>

<RaceSearchForm @bind-Name="NameFilter"
                @bind-Course="CourseFilter"
                @bind-From="FromFilter"
                @bind-To="ToFilter"
                @bind-DateRangeEnabled="DateRangeEnabledFilter"
                @bind-Period="PeriodFilter"
                ValidationMessage="@validationError"
                OnSearch="SearchAsync"
                OnClear="ClearFiltersAsync" />

<RaceList Result="@result"
          Loading="@loading"
          Error="@error"
          Page="@filters.Page"
          PageSize="@PageSize"
          OnRetry="ReloadAsync"
          OnClear="ClearFiltersAsync"
          OnPreviousPage="PreviousPageAsync"
          OnNextPage="NextPageAsync" />

@code {
    private const int PageSize = 50;
    private string? error;
    private string? validationError;
    private bool loading;
    private SearchRacesResponse? result;
    private SearchFilters filters = new(null, null, null, null, false, RacePeriod.Today, 1);
    private long requestVersion;

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;

    private DateOnly Today => TimeProvider.TodayInJapan();

    private string? NameFilter
    {
        get => filters.Name;
        set => filters = filters with { Name = value };
    }

    private string? CourseFilter
    {
        get => filters.Course;
        set => filters = filters with { Course = value };
    }

    private DateOnly? FromFilter
    {
        get => filters.From;
        set => filters = filters with { From = value };
    }

    private DateOnly? ToFilter
    {
        get => filters.To;
        set => filters = filters with { To = value };
    }

    private bool DateRangeEnabledFilter
    {
        get => filters.DateRangeEnabled;
        set => filters = filters with { DateRangeEnabled = value };
    }

    private RacePeriod PeriodFilter
    {
        get => filters.Period;
        set => filters = filters with { Period = value };
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        filters = ReadFiltersFromUrl();
        NavigateToFilters(filters);
        validationError = ValidateFilters(filters);
        if (validationError is null)
        {
            await LoadAsync(filters);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(async () =>
        {
            await ApplyLocationAsync();
            StateHasChanged();
        });

    private async Task ApplyLocationAsync()
    {
        var urlFilters = ReadFiltersFromUrl();
        NavigateToFilters(urlFilters);
        if (urlFilters == filters)
        {
            return;
        }

        filters = urlFilters;
        validationError = ValidateFilters(urlFilters);
        StateHasChanged();
        if (validationError is null)
        {
            await LoadAsync(urlFilters);
        }
        else
        {
            InvalidateCurrentRequest();
        }
    }

    private async Task SearchAsync()
    {
        validationError = ValidateFilters(filters);
        if (validationError is not null)
        {
            InvalidateCurrentRequest();
            return;
        }

        validationError = null;
        filters = filters with { Page = 1 };
        NavigateToFilters(filters);
        await LoadAsync(filters);
    }

    private async Task ClearFiltersAsync()
    {
        filters = new(null, null, null, null, false, RacePeriod.All, 1);
        validationError = null;
        NavigateToFilters(filters);
        await LoadAsync(filters);
    }

    private async Task LoadAsync(SearchFilters requestFilters)
    {
        var version = Interlocked.Increment(ref requestVersion);
        loading = true;
        error = null;

        try
        {
            var response = await RacesApi.SearchRacesAsync(new SearchRacesRequest
            {
                RaceName = requestFilters.Name,
                RaceCourseCode = requestFilters.Course,
                RaceDateFrom = requestFilters.From,
                RaceDateTo = requestFilters.To,
                Page = requestFilters.Page,
                PageSize = PageSize,
                SortBy = "raceDate",
                SortDescending = true
            });

            if (version != Volatile.Read(ref requestVersion))
            {
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                result = response.Content;
            }
            else
            {
                error = "レース一覧を取得できませんでした。";
            }
        }
        catch (Exception ex)
        {
            if (version == Volatile.Read(ref requestVersion))
            {
                error = ex.Message;
            }
        }
        finally
        {
            if (version == Volatile.Read(ref requestVersion))
            {
                loading = false;
            }
        }
    }

    private static string? ValidateFilters(SearchFilters current)
    {
        if (current.From is not null && current.To is not null && current.From > current.To)
        {
            return "終了日は開始日以降の日付を指定してください。";
        }

        return null;
    }

    private async Task PreviousPageAsync()
    {
        if (filters.Page > 1)
        {
            filters = filters with { Page = filters.Page - 1 };
            NavigateToFilters(filters);
            await LoadAsync(filters);
        }
    }

    private async Task NextPageAsync()
    {
        if (result is not null && filters.Page < result.Pagination.TotalPages)
        {
            filters = filters with { Page = filters.Page + 1 };
            NavigateToFilters(filters);
            await LoadAsync(filters);
        }
    }

    private Task ReloadAsync() => LoadAsync(filters);

    private void InvalidateCurrentRequest()
    {
        Interlocked.Increment(ref requestVersion);
        loading = false;
    }

    private SearchFilters ReadFiltersFromUrl()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        DateOnly? parsedFrom = DateOnly.TryParse(Text(query, "from"), out var fromValue) ? fromValue : null;
        DateOnly? parsedTo = DateOnly.TryParse(Text(query, "to"), out var toValue) ? toValue : null;
        if (!RacePeriodExtensions.TryParse(Text(query, "period"), out var parsedPeriod))
        {
            parsedPeriod = parsedFrom is null && parsedTo is null && Text(query, "dateRange") != "true"
                ? RacePeriod.Today
                : RacePeriod.All;
        }

        if (parsedPeriod != RacePeriod.All && (parsedFrom is null || parsedTo is null))
        {
            (parsedFrom, parsedTo) = parsedPeriod.ResolveDates(Today);
        }

        var enabled = parsedFrom is not null || parsedTo is not null || Text(query, "dateRange") == "true";
        var page = int.TryParse(Text(query, "page"), out var pageValue) && pageValue > 0 ? pageValue : 1;
        return new SearchFilters(Text(query, "name"), Text(query, "course"), parsedFrom, parsedTo, enabled, parsedPeriod, page);
    }

    private void NavigateToFilters(SearchFilters current)
    {
        var relativeDates = current.Period.ResolveDates(Today);
        var useRelativeDates = current.Period != RacePeriod.All
                               && current.From == relativeDates.From
                               && current.To == relativeDates.To;
        var values = new Dictionary<string, string?>
        {
            ["name"] = current.Name,
            ["course"] = current.Course,
            ["period"] = current.Period.ToQueryValue(),
            ["from"] = useRelativeDates ? null : current.From?.ToString("yyyy-MM-dd"),
            ["to"] = useRelativeDates ? null : current.To?.ToString("yyyy-MM-dd"),
            ["dateRange"] = current.DateRangeEnabled && current.From is null && current.To is null ? "true" : null,
            ["page"] = current.Page.ToString()
        };

        var uri = QueryHelpers.AddQueryString(
            "/races",
            values.Where(x => !string.IsNullOrWhiteSpace(x.Value)));

        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery != Navigation.ToAbsoluteUri(uri).PathAndQuery)
        {
            Navigation.NavigateTo(uri, replace: true);
        }
    }

    private sealed record SearchFilters(
        string? Name,
        string? Course,
        DateOnly? From,
        DateOnly? To,
        bool DateRangeEnabled,
        RacePeriod Period,
        int Page);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private static string? Text(IDictionary<string, StringValues> query, string key) => query.TryGetValue(key, out var value) ? value.ToString() : null;
}
