@using HorseRacingPrediction.Contracts.Races
@using HorseRacingPrediction.ApiClient.Races
@using Refit

@page "/races/{RaceId}"
@rendermode InteractiveServer
@inject IRacesApi RacesApi
@inject NavigationManager Navigation

<PageTitle></PageTitle>

<PageTitle>レース詳細</PageTitle>
<p>
    <a href="/races">← レース一覧に戻る</a>
</p>
@if (loading)
{
    <p>読み込み中…</p>
}
else if (error is not null)
{

    <p role="alert">@error</p><FluentButton Appearance="ButtonAppearance.Primary" OnClick="LoadAsync">再試行</FluentButton>
}
else if (race is null)
{

    <p>レースが見つかりません。</p>
}
else
{
    <div class="race-detail-header">
        <div>
            <h1>@(race.RaceName ?? race.RaceId)</h1>
            <p>@race.RaceDate?.ToString("yyyy/MM/dd")　@race.RacecourseCode　@(race.RaceNumber)R　状態: <StatusBadge Label="@StatusLabel(race.Status)" /></p>
        </div>
        <a href="@($"/races/{Uri.EscapeDataString(race.RaceId)}/edit")">レースを編集</a>
    </div>
    <FluentTabs ShowActiveIndicator="true" aria-label="レース詳細">
        <FluentTab Label="概要" Id="overview">
            <dl class="race-overview">
                <dt>グレード</dt>
                <dd>@(race.GradeCode ?? "未登録")</dd>
                <dt>発走時刻</dt>
                <dd>@(race.StartTime?.ToString("HH:mm") ?? "未登録")</dd>
                <dt>距離</dt>
                <dd>@(race.DistanceMeters?.ToString() ?? "未登録") @((race.DirectionCode ?? "") is string direction && !string.IsNullOrWhiteSpace(direction) ? $"（{direction}）" : "")</dd>
                <dt>コース補足</dt>
                <dd>@(race.CourseLayout ?? "未登録")</dd>
                <dt>馬場</dt>
                <dd>@TrackLabel()</dd>
                <dt>天候</dt>
                <dd>@(race.WeatherObservations.LastOrDefault()?.WeatherText ?? "未取得")</dd>
                <dt>ペース</dt>
                <dd>@(race.OverallPaceText ?? "未取得")</dd>
                <dt>コーナー通過</dt>
                <dd>@(race.CornerPassagesText ?? "未取得")</dd>
                <dt>結果確定</dt>
                <dd>@(race.ResultDeclaredAt?.ToString("yyyy/MM/dd HH:mm") ?? "未確定")</dd>
                <dt>勝ち馬</dt>
                <dd>@(race.WinningHorseName ?? "未確定")</dd>
            </dl>
        </FluentTab>
        <FluentTab Label="出走表" Id="entries">
            @if (race.Entries.Count == 0)
            {
                <p>出走馬情報はまだ登録されていません。</p>
            }
            else
            {
                <FluentDataGrid Items="@race.Entries.OrderBy(x => x.HorseNumber).AsQueryable()" aria-label="出走表">
                    <PropertyColumn Property="@(x => x.GateNumber)" Title="枠" />
                    <PropertyColumn Property="@(x => x.HorseNumber)" Title="馬番" />
                    <TemplateColumn Title="馬名"><EntityLink Segment="horses" Id="@context.HorseId" Label="@context.HorseName" /></TemplateColumn>
                    <TemplateColumn Title="騎手"><EntityLink Segment="jockeys" Id="@context.JockeyId" Label="@context.JockeyName" /></TemplateColumn>
                    <TemplateColumn Title="調教師"><EntityLink Segment="trainers" Id="@context.TrainerId" Label="@context.TrainerName" /></TemplateColumn>
                    <TemplateColumn Title="馬主"><EntityLink Segment="owners" Id="@context.OwnerId" Label="@context.OwnerName" /></TemplateColumn>
                    <TemplateColumn Title="結果">@(FinishLabel(context.HorseId))</TemplateColumn>
                </FluentDataGrid>
            }
        </FluentTab>
        <FluentTab Label="結果" Id="results">
            @if (race.EntryResults.Count == 0)
            {
                <p>結果情報はまだ登録されていません。</p>
            }
            else
            {
                <FluentDataGrid Items="@race.EntryResults.OrderBy(x => x.FinishPosition ?? int.MaxValue).AsQueryable()" aria-label="確定結果">
                    <PropertyColumn Property="@(x => x.FinishPosition)" Title="着順" />
                    <PropertyColumn Property="@(x => x.HorseNumber)" Title="馬番" />
                    <PropertyColumn Property="@(x => x.HorseName)" Title="馬名" />
                    <PropertyColumn Property="@(x => x.OfficialTime)" Title="タイム" />
                    <PropertyColumn Property="@(x => x.MarginText)" Title="着差" />
                </FluentDataGrid>
            }
        </FluentTab>
        @if (race.Odds is not null && (race.Odds.WinOdds.Count > 0 || race.Odds.PlaceOdds.Count > 0))
        {
            <FluentTab Label="オッズ" Id="odds">
                @if (race.Odds.WinOdds.Count > 0)
                {
                    <h2>単勝</h2><FluentDataGrid Items="@race.Odds.WinOdds.AsQueryable()" aria-label="単勝オッズ"><PropertyColumn Property="@(x => x.HorseNumber)" Title="馬番" /><PropertyColumn Property="@(x => x.HorseName)" Title="馬名" /><PropertyColumn Property="@(x => x.Odds)" Title="オッズ" /><PropertyColumn Property="@(x => x.Popularity)" Title="人気" /></FluentDataGrid>
                }
                @if (race.Odds.PlaceOdds.Count > 0)
                {
                    <h2>複勝</h2><FluentDataGrid Items="@race.Odds.PlaceOdds.AsQueryable()" aria-label="複勝オッズ"><PropertyColumn Property="@(x => x.HorseNumber)" Title="馬番" /><PropertyColumn Property="@(x => x.HorseName)" Title="馬名" /><TemplateColumn Title="オッズ">@context.OddsMin?.ToString("0.0")〜@context.OddsMax?.ToString("0.0")</TemplateColumn></FluentDataGrid>
                }
            </FluentTab>
        }
        @if (race.PayoutResult is not null)
        {
            <FluentTab Label="払戻" Id="payouts">
                <FluentDataGrid Items="@PayoutRows().AsQueryable()" aria-label="払戻">
                    <PropertyColumn Property="@(x => x.Kind)" Title="券種" />
                    <PropertyColumn Property="@(x => x.Combination)" Title="組み合わせ" />
                    <PropertyColumn Property="@(x => x.Amount)" Title="払戻金" />
                </FluentDataGrid>
            </FluentTab>
        }
    </FluentTabs>
}
@code {
    [Parameter] public string RaceId { get; set; } = string.Empty;
    private RaceDto? race; private bool loading; private string? error;
    private string FinishLabel(string horseId)
        => race?.EntryResults.FirstOrDefault(x => x.HorseId == horseId)?.FinishPosition is int finish ? $"{finish}着" : "未確定";

    private string TrackLabel()
    {
        var track = race?.TrackConditionObservations.OrderByDescending(x => x.ObservationTime).FirstOrDefault();
        if (track is null) return "未取得";
        var values = new[] { track.TurfConditionCode, track.DirtConditionCode, track.GoingDescriptionText }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        return string.Join(" / ", values.DefaultIfEmpty("取得済み"));
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = null;
        try { var response = await RacesApi.GetRaceAsync(new GetRaceRequest { RaceId = RaceId }); race = response.IsSuccessStatusCode ? response.Content?.Race : null; if (race is null) error = response.StatusCode == System.Net.HttpStatusCode.NotFound ? "指定されたレースは見つかりませんでした。" : "レース詳細を取得できませんでした。"; }
        catch (ApiException) { error = "レース詳細を取得できませんでした。"; }
        catch (HttpRequestException) { error = "APIに接続できませんでした。"; }
        finally { loading = false; }
    }

    private async Task LoadAsync() => await OnParametersSetAsync();
    private static string StatusLabel(RaceStatus status) => status switch
    {
        RaceStatus.Draft => "下書き",
        RaceStatus.CardPublished => "出馬表公開",
        RaceStatus.PreRaceOpen => "発走前",
        RaceStatus.InProgress => "レース中",
        RaceStatus.ResultDeclared => "結果確定",
        RaceStatus.PayoutDeclared => "払戻確定",
        RaceStatus.Closed => "締切",
        RaceStatus.Rescheduled => "開催変更",
        _ => "未登録"
    };

    private IEnumerable<(string Kind, string Combination, decimal Amount)> PayoutRows()
    {
        if (race?.PayoutResult is not { } payout) yield break;
        foreach (var item in payout.WinPayouts) yield return ("単勝", item.Combination, item.Amount);
        foreach (var item in payout.PlacePayouts) yield return ("複勝", item.Combination, item.Amount);
        foreach (var item in payout.QuinellaPayouts) yield return ("馬連", item.Combination, item.Amount);
        foreach (var item in payout.ExactaPayouts) yield return ("馬単", item.Combination, item.Amount);
        foreach (var item in payout.TrifectaPayouts) yield return ("三連単", item.Combination, item.Amount);
        foreach (var item in payout.BracketQuinellaPayouts ?? []) yield return ("枠連", item.Combination, item.Amount);
        foreach (var item in payout.WidePayouts ?? []) yield return ("ワイド", item.Combination, item.Amount);
        foreach (var item in payout.TrioPayouts ?? []) yield return ("三連複", item.Combination, item.Amount);
    }
}
