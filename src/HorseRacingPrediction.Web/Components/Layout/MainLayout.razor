@inherits LayoutComponentBase

@inject NavigationManager Navigation

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />

        <strong>Horse Racing Prediction</strong>

        <FluentSpacer />

        <FluentButton OnClick="Logout">
            ログアウト
        </FluentButton>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        @Body
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

@code {
    private async void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
}
