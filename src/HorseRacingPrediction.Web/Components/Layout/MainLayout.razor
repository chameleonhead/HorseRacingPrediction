@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />

        <strong>Horse Racing Prediction</strong>

        <FluentSpacer />

        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@(new Icons.Regular.Size20.Alert())"
                      Title="通知" />

        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@(new Icons.Regular.Size20.Person())">
            ユーザー
        </FluentButton>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation"
                      Padding="@Padding.All0">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content"
                      Padding="@Padding.All4">
        @Body
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />