@inherits LayoutComponentBase

@inject NavigationManager Navigation

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />

        <strong>Horse Racing Prediction</strong>

        <FluentSpacer />
        <form method="post" action="/logout" @formname="Logout">
            <AntiforgeryToken />

            <FluentButton Type="ButtonType.Submit">
                ログアウト
            </FluentButton>
        </form>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content">
        @Body
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

@code {
    private void Logout()
    {
        Navigation.NavigateTo(
            "/logout",
            forceLoad: true);
    }
}
