<FluentBadge Padding="12px" onclick="OnBadgeClick">
    <span style="font-weight: normal">@Label:</span>
    <bold>
        @(SelectedValues.Any() ? SelectedValues.Count() > 2 ? $"{SelectedValues.Count()}件が選択されています" : SelectedValues.First() : "すべて")
    </bold>
</FluentBadge>

<FluentPopover AnchorId="MyButton" @bind-Opened="@IsOpened">
    Content of the Popover
</FluentPopover>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = null!;
    [Parameter] public string[] SelectedValues { get; set; } = Array.Empty<string>();
    [Parameter] public IEnumerable<string> Items { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string[]?> OnChange { get; set; }

    private bool IsOpened { get; set; }

    private void OnBadgeClick(EventArgs e)
    {
        IsOpened = true;
    }
}
