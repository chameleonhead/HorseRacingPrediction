<FluentBadge Id="@AnchorId" Padding="12px" @onclick="TogglePopover">
    <span style="font-weight: normal">@Label:</span>
    <strong>
        @SelectedLabel
    </strong>
</FluentBadge>

<FluentPopover AnchorId="@AnchorId" @bind-Opened="@IsOpened" Padding="0">
    <FluentListbox TOption="FilterSelectionOption"
                   TValue="string"
                   Items="@Items"
                   OptionValue="@(item => item.Value)"
                   OptionText="@(item => item.Label)"
                   Value="@Value"
                   ValueChanged="OnValueChanged"
                   Appearance="ListAppearance.Transparent" />
</FluentPopover>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = null!;
    [Parameter] public string? Value { get; set; }
    [Parameter] public IEnumerable<FilterSelectionOption> Items { get; set; } = Array.Empty<FilterSelectionOption>();
    [Parameter] public EventCallback<string?> OnChange { get; set; }

    private readonly string AnchorId = $"filter-single-{Guid.NewGuid():N}";
    private bool IsOpened { get; set; }

    private string SelectedLabel
        => string.IsNullOrEmpty(Value)
            ? "すべて"
            : Items.FirstOrDefault(item => item.Value == Value)?.Label ?? Value;

    private void TogglePopover() => IsOpened = !IsOpened;

    private Task OnValueChanged(string? value) => OnChange.InvokeAsync(value);
}
