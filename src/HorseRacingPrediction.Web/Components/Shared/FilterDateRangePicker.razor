<div class="date-range-filter">
    <FilterSelection Label="@Label"
                     Value="@SelectedOption"
                     ValueChanged="OnSelectionChanged"
                     ActionValue="@CustomOption"
                     ActionValueSelected="OnSelectionChanged"
                     DisplayValue="@DisplayValue"
                     Items="@Options"
                     SelectionResetVersion="@SelectionResetVersion" />
</div>

<FluentDialog @ref="Drawer"
              Modal="true"
              Alignment="DialogAlignment.End"
              AriaLabelledby="@DrawerTitleId"
              Class="date-range-drawer"
              Style="inset-inline-start:auto;inset-inline-end:0;width:min(320px,100vw);height:100dvh;max-height:100dvh;margin:0;">
    @if (IsDrawerOpen)
    {
        <FluentDialogBody>
            <header class="date-range-drawer-header">
                <h2 id="@DrawerTitleId">@($"{Label}の期間を指定")</h2>
                <button type="button" aria-label="閉じる" @onclick="CancelDrawer">×</button>
            </header>
            <div class="date-range-drawer-fields">
                <label>
                    開始日
                    <FluentDatePicker TValue="DateOnly?"
                                      Autofocus="true"
                                      AriaLabel="開始日"
                                      Placeholder="開始日"
                                      Value="@DraftFrom"
                                      ValueChanged="OnDraftFromChanged" />
                </label>
                <label>
                    終了日
                    <FluentDatePicker TValue="DateOnly?"
                                      AriaLabel="終了日"
                                      Placeholder="終了日"
                                      Value="@DraftTo"
                                      ValueChanged="OnDraftToChanged" />
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(ValidationMessage))
            {
                <FluentMessageBar Intent="@MessageBarIntent.Error">@ValidationMessage</FluentMessageBar>
            }
        </FluentDialogBody>
        <div class="date-range-drawer-footer">
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="CancelDrawer">キャンセル</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ApplyCustomRangeAsync" Disabled="@(!CanApplyCustomRange)">適用</FluentButton>
        </div>
    }
</FluentDialog>

@code {
    private const string AllOption = "all";
    private const string TodayOption = "today";
    private const string TenDaysOption = "last-10-days";
    private const string MonthOption = "last-month";
    private const string YearOption = "last-year";
    private const string CustomOption = "custom";

    private static readonly FilterSelectionOption[] DefaultOptions =
    [
        new(AllOption, "すべて"),
        new(TodayOption, "今日"),
        new(TenDaysOption, "10日以内"),
        new(MonthOption, "1か月以内"),
        new(YearOption, "1年以内"),
        new(CustomOption, "期間を指定する")
    ];

    [Parameter] public string Label { get; set; } = "開催日";
    [Parameter] public IReadOnlyList<FilterSelectionOption> Options { get; set; } = DefaultOptions;
    [Parameter] public DateOnly? From { get; set; }
    [Parameter] public EventCallback<DateOnly?> FromChanged { get; set; }
    [Parameter] public DateOnly? To { get; set; }
    [Parameter] public EventCallback<DateOnly?> ToChanged { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public EventCallback OnDateFilterChanged { get; set; }

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;

    private FluentDialog? Drawer { get; set; }
    private readonly string DrawerTitleId = $"date-range-title-{Guid.NewGuid():N}";
    private DateOnly? DraftFrom { get; set; }
    private DateOnly? DraftTo { get; set; }
    private bool IsDrawerOpen { get; set; }
    private bool ShouldShowDrawer { get; set; }
    private string? ValidationMessage { get; set; }
    private int SelectionResetVersion { get; set; }
    private DateOnly Today => TimeProvider.TodayInJapan();
    private bool CanApplyCustomRange
        => (DraftFrom is not null || DraftTo is not null)
           && (DraftFrom is null || DraftTo is null || DraftFrom <= DraftTo);

    private DateOnly? DisplayFrom => From;
    private DateOnly? DisplayTo => To;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldShowDrawer && Drawer is not null)
        {
            ShouldShowDrawer = false;
            await Drawer.ShowAsync();
        }
    }

    private string SelectedOption
    {
        get
        {
            if (DisplayFrom is null && DisplayTo is null)
            {
                return AllOption;
            }

            if (DisplayFrom == Today && DisplayTo == Today)
            {
                return TodayOption;
            }

            if ((DisplayFrom, DisplayTo) == (Today.AddDays(-9), Today))
            {
                return TenDaysOption;
            }

            if ((DisplayFrom, DisplayTo) == (Today.AddMonths(-1), Today))
            {
                return MonthOption;
            }

            if ((DisplayFrom, DisplayTo) == (Today.AddYears(-1), Today))
            {
                return YearOption;
            }

            return CustomOption;
        }
    }

    private string DisplayValue
    {
        get
        {
            var optionLabel = Options.FirstOrDefault(option => option.Value == SelectedOption)?.Label;
            if (optionLabel is not null)
            {
                return SelectedOption == CustomOption && (DisplayFrom is not null || DisplayTo is not null)
                    ? FormatDateRange()
                    : optionLabel;
            }

            return DisplayFrom is null && DisplayTo is null ? "すべて" : FormatDateRange();
        }
    }

    private string FormatDateRange()
        => (DisplayFrom, DisplayTo) switch
        {
            (not null, not null) => $"{DisplayFrom:yyyy/MM/dd} - {DisplayTo:yyyy/MM/dd}",
            (not null, null) => $"{DisplayFrom:yyyy/MM/dd}から",
            (null, not null) => $"{DisplayTo:yyyy/MM/dd}まで",
            _ => "すべて"
        };

    private async Task OnSelectionChanged(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (value == CustomOption)
        {
            DraftFrom = From;
            DraftTo = To;
            IsDrawerOpen = true;
            ShouldShowDrawer = true;
            ValidationMessage = null;
            return;
        }

        var (from, to) = ResolveOption(value);
        await FromChanged.InvokeAsync(from);
        await ToChanged.InvokeAsync(to);
        await EnabledChanged.InvokeAsync(value != AllOption);
        await OnDateFilterChanged.InvokeAsync();
    }

    private (DateOnly? From, DateOnly? To) ResolveOption(string value) => value switch
    {
        AllOption => (null, null),
        TodayOption => (Today, Today),
        TenDaysOption => (Today.AddDays(-9), Today),
        MonthOption => (Today.AddMonths(-1), Today),
        YearOption => (Today.AddYears(-1), Today),
        _ => (From, To)
    };

    private async Task ApplyCustomRangeAsync()
    {
        if (DraftFrom is not null && DraftTo is not null && DraftFrom > DraftTo)
        {
            ValidationMessage = "終了日は開始日以降の日付を指定してください。";
            return;
        }

        await FromChanged.InvokeAsync(DraftFrom);
        await ToChanged.InvokeAsync(DraftTo);
        await EnabledChanged.InvokeAsync(true);
        IsDrawerOpen = false;
        ValidationMessage = null;
        SelectionResetVersion++;
        await Drawer!.HideAsync();
        await OnDateFilterChanged.InvokeAsync();
    }

    private async Task CancelDrawer()
    {
        DraftFrom = DisplayFrom;
        DraftTo = DisplayTo;
        IsDrawerOpen = false;
        ValidationMessage = null;
        SelectionResetVersion++;
        if (Drawer is not null)
        {
            await Drawer.HideAsync();
        }
    }

    private void OnDraftFromChanged(DateOnly? value)
    {
        DraftFrom = value;
        ValidateDraftRange();
    }

    private void OnDraftToChanged(DateOnly? value)
    {
        DraftTo = value;
        ValidateDraftRange();
    }

    private void ValidateDraftRange()
    {
        ValidationMessage = DraftFrom is not null && DraftTo is not null && DraftFrom > DraftTo
            ? "終了日は開始日以降の日付を指定してください。"
            : null;
    }
}
