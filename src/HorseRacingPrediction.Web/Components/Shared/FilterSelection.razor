<button id="@AnchorId"
        type="button"
        class="filter-selection-trigger"
        aria-haspopup="listbox"
        aria-expanded="@(IsOpened ? "true" : "false")"
        aria-label="@TriggerLabel"
        @onclick="TogglePopover">
    <span style="font-weight: normal">@Label:</span>
    <strong>@SelectionSummary</strong>
</button>

<FluentPopover AnchorId="@AnchorId" @bind-Opened="IsOpened" Padding="0">
    @if (Multiple)
    {
        <FluentListbox TOption="FilterSelectionOption"
                       TValue="string"
                       Multiple="true"
                       Items="@Items"
                       OptionValue="@(item => item.Value)"
                       OptionText="@(item => item.Label)"
                       SelectedItems="@SelectedOptions"
                       SelectedItemsChanged="OnSelectedItemsChanged"
                       Appearance="ListAppearance.Transparent" />
    }
    else
    {
        <FluentListbox TOption="FilterSelectionOption"
                       TValue="string"
                       Items="@Items"
                       OptionValue="@(item => item.Value)"
                       OptionText="@(item => item.Label)"
                       OptionTemplate="@RenderOption"
                       Value="@ListboxValue"
                       ValueChanged="OnValueChanged"
                       Appearance="ListAppearance.Transparent" />
    }
</FluentPopover>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = null!;
    [Parameter] public IEnumerable<FilterSelectionOption> Items { get; set; } = Array.Empty<FilterSelectionOption>();
    [Parameter] public string? DisplayValue { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? ActionValue { get; set; }
    [Parameter] public EventCallback<string?> ActionValueSelected { get; set; }
    [Parameter] public string[] SelectedValues { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string[]> SelectedValuesChanged { get; set; }

    private readonly string AnchorId = $"filter-selection-{Guid.NewGuid():N}";
    private bool IsOpened { get; set; }
    private string TriggerLabel => $"{Label}: {SelectionSummary}";

    private IEnumerable<FilterSelectionOption> SelectedOptions
        => Items.Where(item => SelectedValues.Contains(item.Value));
    private string? ListboxValue => Value == ActionValue ? null : Value;

    private RenderFragment<FilterSelectionOption> RenderOption => option => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "filter-selection-option-button");
        builder.AddAttribute(3, "data-filter-option", option.Value);
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => SelectOptionAsync(option)));
        builder.AddAttribute(5, "onclick:stopPropagation", true);
        builder.AddContent(6, option.Label);
        builder.CloseElement();
    };

    private string SelectionSummary
    {
        get
        {
            if (DisplayValue is not null)
            {
                return DisplayValue;
            }

            if (Multiple)
            {
                var selectedLabels = SelectedOptions.Select(item => item.Label).ToArray();
                return selectedLabels.Length switch
                {
                    0 => "すべて",
                    1 => selectedLabels[0],
                    _ => $"{selectedLabels.Length}件選択"
                };
            }

            return string.IsNullOrEmpty(Value)
                ? "すべて"
                : Items.FirstOrDefault(item => item.Value == Value)?.Label ?? Value;
        }
    }

    private void TogglePopover()
    {
        IsOpened = !IsOpened;
        if (IsOpened)
        {
            PendingOptionValue = null;
        }
    }

    private Task OnValueChanged(string? value)
    {
        var option = Items.FirstOrDefault(item => item.Value == value);
        return option is null ? Task.CompletedTask : SelectOptionAsync(option);
    }

    private async Task SelectOptionAsync(FilterSelectionOption option)
    {
        if (PendingOptionValue == option.Value)
        {
            return;
        }

        PendingOptionValue = option.Value;
        if (option.Value == ActionValue)
        {
            await ActionValueSelected.InvokeAsync(ActionValue);
            IsOpened = false;
            return;
        }

        await ValueChanged.InvokeAsync(option.Value);
        IsOpened = false;
    }

    private Task OnSelectedItemsChanged(IEnumerable<FilterSelectionOption>? selectedItems)
        => SelectedValuesChanged.InvokeAsync(selectedItems?.Select(item => item.Value).ToArray() ?? []);

    private string? PendingOptionValue { get; set; }
}
