@page "/jobs/{JobId}"
@inject ProcessingStateStore Store
@inject CollectionExecutionTrigger ExecutionTrigger

<h1>ジョブ詳細</h1>
<p class="hint"><a href="jobs">← ジョブ一覧へ戻る</a></p>

@if (loading)
{
    <p>読み込み中…</p>
}
else if (detail is null)
{
    <p>JobId「@JobId」のジョブは見つかりませんでした。</p>
}
else
{
    <section class="card">
        <h2>@detail.JobType</h2>
        <dl class="meta">
            <dt>JobId</dt><dd><code>@detail.JobId</code></dd>
            <dt>DeduplicationKey</dt><dd><code>@detail.DeduplicationKey</code></dd>
            <dt>Status</dt><dd><span class="pill">@detail.Status</span></dd>
            <dt>Priority</dt><dd>@detail.Priority</dd>
            <dt>AttemptCount</dt><dd>@detail.AttemptCount</dd>
            <dt>FirstQueuedAt</dt><dd>@Fmt(detail.FirstQueuedAt)</dd>
            <dt>AvailableAt</dt><dd>@Fmt(detail.AvailableAt)</dd>
            <dt>StartedAt</dt><dd>@Fmt(detail.StartedAt)</dd>
            <dt>LeaseExpiresAt</dt><dd>@Fmt(detail.LeaseExpiresAt)</dd>
            <dt>CreatedAt</dt><dd>@Fmt(detail.CreatedAt)</dd>
            <dt>UpdatedAt</dt><dd>@Fmt(detail.UpdatedAt)</dd>
        </dl>
        <div class="toolbar">
            @if (!confirmingRequeue)
            {
                <button class="btn primary" @onclick="() => confirmingRequeue = true">再キューする</button>
            }
            <button class="btn" @onclick="LoadAsync">再読み込み</button>
        </div>
        @if (confirmingRequeue)
        {
            <div class="confirmation" role="group" aria-label="再キューの確認">
                <strong>このジョブを再キューしますか？</strong>
                <p class="hint">実行中の処理と重複しないよう、表示後に状態が変わっていた場合は中止します。</p>
                <div class="toolbar">
                    <button class="btn primary" @onclick="RequeueAsync" disabled="@requeueing">確認して再キュー</button>
                    <button class="btn" @onclick="() => confirmingRequeue = false" disabled="@requeueing">キャンセル</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="hint">@message</p>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(detail.LastError))
    {
        <section class="card">
            <h3>最終エラー</h3>
            <pre class="error">@detail.LastError</pre>
        </section>
    }

    <section class="card">
        <h3>ペイロード</h3>
        <pre class="payload">@FormatPayload(detail.Payload)</pre>
    </section>
}

@code {
    [Parameter] public string JobId { get; set; } = string.Empty;

    private bool loading;
    private AgentJobDetailReadModel? detail;
    private string? message;
    private bool confirmingRequeue;
    private bool requeueing;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            detail = await Store.GetJobDetailAsync(JobId);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RequeueAsync()
    {
        if (detail is null) return;
        requeueing = true;
        var result = await Store.ForceRequeueJobAsync(detail.JobId, detail.UpdatedAt, DateTimeOffset.UtcNow);
        if (result == ForceRequeueJobResult.Requeued)
        {
            ExecutionTrigger.Signal();
            message = "再キューしました。";
        }
        else if (result == ForceRequeueJobResult.Conflict)
        {
            message = "ジョブの状態が更新されていたため再キューしませんでした。最新状態を確認してください。";
        }
        else
        {
            message = "対象のジョブが見つかりませんでした。";
        }
        confirmingRequeue = false;
        requeueing = false;
        await LoadAsync();
    }

    private static string Fmt(DateTimeOffset? d) => d?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
    private static string Fmt(DateTimeOffset d) => d.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string FormatPayload(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload)) return "(empty)";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(payload);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return payload;
        }
    }
}
