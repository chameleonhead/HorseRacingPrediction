@page "/acquisition-statuses"
@inject IProcessingStateStore Store

<h1>取得ステータス</h1>
<div class="toolbar">
    <label>From: <input type="date" @bind="from" /></label>
    <label>To: <input type="date" @bind="to" /></label>
    <label>
        SubjectType:
        <select @bind="subjectType">
            <option value="">(指定なし)</option>
            @foreach (var t in Enum.GetValues<AgentAcquisitionSubjectType>())
            {
                <option value="@t">@t</option>
            }
        </select>
    </label>
    <label>
        Status:
        <select @bind="status">
            <option value="">(指定なし)</option>
            @foreach (var s in Enum.GetValues<RaceDataCollectionState>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>
    <button class="btn primary" @onclick="LoadAsync">再読み込み</button>
</div>

@if (loading) { <p>読み込み中…</p> }
else if (items is null || items.Count == 0) { <p>該当データはありません。</p> }
else
{
    <div class="operation-list">
        @foreach (var i in PagedItems)
        {
            <article class="operation-row"><div class="operation-primary"><strong>@i.SubjectName</strong><span class="hint">@i.SubjectType · @i.ProviderType</span></div><div><span class="operation-label">処理</span>@i.OperationType</div><div><span class="operation-label">状態</span><span class="pill">@i.Status</span></div><div class="operation-reason"><span class="operation-label">エラー</span>@(i.ErrorReason ?? "—")</div><div><span class="operation-label">更新</span>@i.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div></article>
        }
    </div>
    <Pagination TotalCount="items.Count" Page="page" PageSize="pageSize" PageChanged="GoPage" />
}

@code {
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
    private DateOnly to = DateOnly.FromDateTime(DateTime.Today);
    private AgentAcquisitionSubjectType? subjectType;
    private RaceDataCollectionState? status;
    private bool loading;
    private IReadOnlyList<AgentAcquisitionStatusReadModel>? items;
    private int page = 1;
    private const int pageSize = 50;
    private IEnumerable<AgentAcquisitionStatusReadModel> PagedItems => (items ?? []).Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (from > to) return;
        loading = true;
        try
        {
            items = await Store.GetAgentAcquisitionStatusesAsync(from, to, subjectType, status);
            page = 1;
        }
        finally
        {
            loading = false;
        }
    }
    private Task GoPage(int value) { page = value; return Task.CompletedTask; }
}
