@page "/jra-tool"
@inject JraJsonExtractionService Extractor

<h1>JRA URL 抽出ツール</h1>
<p class="hint">JRA サイトの URL を入力すると、ページ種別判定と JSON 抽出結果を確認できます。</p>

<section class="card">
    <div class="toolbar">
        <label class="grow">
            URL:
            <input class="grow" @bind="url" placeholder="https://www.jra.go.jp/..." />
        </label>
        <label>
            <input type="checkbox" @bind="includeSnapshot" />
            Snapshot を含める
        </label>
        <button class="btn primary" @onclick="ExtractAsync" disabled="@busy">@(busy ? "実行中…" : "抽出")</button>
    </div>
    @if (!string.IsNullOrEmpty(error))
    {
        <pre class="error">@error</pre>
    }
</section>

@if (response is not null)
{
    <section class="card">
        <h3>抽出結果</h3>
        <dl class="meta">
            <dt>InputUrl</dt><dd>@response.InputUrl</dd>
            <dt>ResolvedUrl</dt><dd>@response.ResolvedUrl</dd>
            <dt>PageKind</dt><dd>@response.PageKind</dd>
            <dt>ExtractionMode</dt><dd>@response.ExtractionMode</dd>
            <dt>Title</dt><dd>@response.Title</dd>
            <dt>Tables / Links</dt><dd>@response.TableCount / @response.LinkCount</dd>
        </dl>
        @if (!string.IsNullOrEmpty(response.Error))
        {
            <pre class="error">@response.Error</pre>
        }
        <h4>Data</h4>
        <pre class="payload">@SerializeJson(response.Data)</pre>
        @if (response.Snapshot is not null)
        {
            <h4>Snapshot</h4>
            <pre class="payload">@SerializeJson(response.Snapshot)</pre>
        }
    </section>
}

@code {
    private string url = "";
    private bool includeSnapshot;
    private bool busy;
    private string? error;
    private JraJsonExtractionResponse? response;

    private async Task ExtractAsync()
    {
        error = null;
        response = null;
        if (string.IsNullOrWhiteSpace(url))
        {
            error = "URL を入力してください。";
            return;
        }
        busy = true;
        try
        {
            response = await Extractor.ExtractAsync(url, includeSnapshot);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string SerializeJson(object? value)
    {
        if (value is null) return "(null)";
        try
        {
            return System.Text.Json.JsonSerializer.Serialize(value, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            return $"<serialize error: {ex.Message}>";
        }
    }
}
