@page "/result-days"
@inject IProcessingStateStore Store
@inject CollectionExecutionTrigger ExecutionTrigger

<h1>日次収集状況</h1>
<div class="toolbar">
    <label>From: <input type="date" @bind="from" /></label>
    <label>To: <input type="date" @bind="to" /></label>
    <button class="btn primary" @onclick="LoadAsync">再読み込み</button>
</div>

@if (loading)
{
    <UiState Kind="loading" Title="日次収集状況を読み込んでいます" />
}
else if (items is null || items.Count == 0)
{
    <UiState Title="対象期間の収集状況はありません" Message="期間を変更するか、探索ジョブを開始してください。" />
}
else
{
    <div class="operation-list">
        @foreach (var s in PagedItems)
        {
            <article class="operation-row"><div class="operation-primary"><strong>@s.TargetDate</strong><span class="hint">@s.ProviderType · 更新 @s.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span></div><div><span class="operation-label">状態</span><span class="pill">@s.Status</span></div><div><span class="operation-label">完了</span>@s.CompletedRaceCount / @s.ExpectedRaceCount レース</div><div class="operation-reason"><span class="operation-label">未完了理由</span>@(s.IncompleteReason ?? "—")</div><div class="operation-actions"><button class="btn small" @onclick="() => RequeueDiscoveryAsync(s)">探索から再実行</button><a class="btn small" href="@CollectionJobUrl(s)">収集ジョブ詳細</a></div></article>
        }
    </div>
    <Pagination TotalCount="items.Count" Page="page" PageSize="pageSize" PageChanged="GoPage" />
}

@if (!string.IsNullOrEmpty(message)) { <p class="hint">@message</p> }

@code {
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today.AddDays(-14));
    private DateOnly to = DateOnly.FromDateTime(DateTime.Today);
    private bool loading;
    private IReadOnlyList<ResultDayCollectionStatusReadModel>? items;
    private string? message;
    private int page = 1;
    private const int pageSize = 50;
    private IEnumerable<ResultDayCollectionStatusReadModel> PagedItems => (items ?? []).Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (from > to) { message = "From は To 以下にしてください。"; return; }
        loading = true;
        try
        {
            items = await Store.GetResultDayCollectionStatusesAsync(from, to);
            page = 1;
        }
        finally
        {
            loading = false;
        }
    }
    private Task GoPage(int value) { page = value; return Task.CompletedTask; }

    private async Task RequeueDiscoveryAsync(ResultDayCollectionStatusReadModel s)
    {
        var now = DateTimeOffset.UtcNow;
        await Store.UpsertResultDayCollectionStatusAsync(
            s.ProviderType, s.TargetDate, ResultDayCollectionState.RetryScheduled,
            null, null, null, null, now, null, now);
        await Store.ScheduleJobAsync(
            AgentJobType.ResultDayDiscoveryRequest,
            AgentJobKeyFactory.BuildResultDayDiscoveryRequestKey(s.ProviderType, s.TargetDate),
            AgentJobPayloadSerializer.Serialize(new ResultDayDiscoveryRequestPayload(s.TargetDate, s.ProviderType)),
            now,
            priority: 170);
        ExecutionTrigger.Signal();
        message = $"Discovery 再投入: {s.ProviderType} {s.TargetDate}";
        await LoadAsync();
    }

    private static string CollectionJobUrl(ResultDayCollectionStatusReadModel status)
        => $"jobs/{Uri.EscapeDataString(ProcessingStateStore.ComposeJobId(AgentJobType.ResultDayCollectionRequest, AgentJobKeyFactory.BuildResultDayCollectionRequestKey(status.ProviderType, status.TargetDate)))}";
}
