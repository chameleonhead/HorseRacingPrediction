<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HorseRacingPrediction.ApiClient\HorseRacingPrediction.ApiClient.csproj" />
    <ProjectReference Include="..\HorseRacingPrediction.Scraping\HorseRacingPrediction.Scraping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.16" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\HorseRacingPrediction.AgentClient\Http\**\*.cs" Link="Http\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\HorseRacingPrediction.AgentClient\Scheduling\**\*.cs" Link="Scheduling\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\HorseRacingPrediction.AgentClient\Scheduling\AgentAcquisitionStatusEndpointExtensions.cs" />
    <Compile Remove="..\HorseRacingPrediction.AgentClient\Scheduling\AgentCollectionStatusEndpointExtensions.cs" />
    <Compile Remove="..\HorseRacingPrediction.AgentClient\Scheduling\AgentDashboardEndpointExtensions.cs" />
    <Compile Remove="..\HorseRacingPrediction.AgentClient\Scheduling\PredictionExecutionService.cs" />
    <Compile Remove="..\HorseRacingPrediction.AgentClient\Scheduling\HistoricalDataRequestTracker.cs" />
    <Compile Remove="..\HorseRacingPrediction.AgentClient\Scheduling\RaceTextInsightCollector.cs" />
  </ItemGroup>

</Project>
