@page "/collection-tasks/{JobId}"
@inject IProcessingStateStore Store
@inject CollectionExecutionTrigger ExecutionTrigger

<h1>収集タスク詳細</h1>
<p class="hint"><a href="/collection-tasks">← 収集タスク一覧へ戻る</a></p>

@if (detail is null)
{
    <p>指定されたジョブは見つかりませんでした。</p>
}
else
{
    <nav class="detail-tabs" aria-label="詳細セクション">
        <ul class="detail-tab-list">
            <li><a href="#overview">概要</a></li>
            @if (!string.IsNullOrWhiteSpace(detail.LastError)) { <li><a href="#errors">失敗理由</a></li> }
            @if (detail.ParentJob is not null || detail.ChildJobs.Count > 0) { <li><a href="#relations">親子タスク</a></li> }
            <li><a href="#payload">ペイロード</a></li>
        </ul>
    </nav>

    <div class="detail-sections">
    <section id="overview" class="card detail-section">
        <h2>@detail.JobType</h2>
        <dl class="meta">
            <dt>JobId</dt><dd><code>@detail.JobId</code></dd>
            <dt>キー</dt><dd><code>@detail.DeduplicationKey</code></dd>
            <dt>状態</dt><dd><span class="pill">@detail.Status</span></dd>
            <dt>試行回数</dt><dd>@detail.AttemptCount</dd>
            <dt>開始（JST）</dt><dd>@Fmt(detail.StartedAt)</dd>
            <dt>更新（JST）</dt><dd>@Fmt(detail.UpdatedAt)</dd>
        </dl>
        <div class="toolbar">
            @if (!confirmingRequeue)
            {
                <button class="btn primary" @onclick="() => confirmingRequeue = true">再投入する</button>
                <button class="btn" @onclick="() => confirmingCancel = true">取り消す</button>
            }
            <button class="btn" @onclick="LoadAsync">再読み込み</button>
        </div>
        @if (confirmingRequeue)
        {
            <div class="confirmation" role="group" aria-label="再投入の確認">
                <strong>このジョブを再投入しますか？</strong>
                <p class="hint">表示後にジョブの状態が変わっていた場合は、重複実行を防ぐため再投入しません。</p>
                <div class="toolbar">
                    <button class="btn primary" @onclick="RequeueAsync" disabled="@requeueing">確認して再投入</button>
                    <button class="btn" @onclick="() => confirmingRequeue = false" disabled="@requeueing">キャンセル</button>
                </div>
            </div>
        }
        @if (confirmingCancel)
        {
            <div class="confirmation" role="group" aria-label="取消の確認">
                <strong>このジョブを取り消しますか？</strong>
                <label>理由 <input @bind="cancelReason" /></label>
                <div class="toolbar">
                    <button class="btn primary" @onclick="CancelAsync" disabled="@(cancelling || string.IsNullOrWhiteSpace(cancelReason))">確認して取り消す</button>
                    <button class="btn" @onclick="() => confirmingCancel = false" disabled="@cancelling">キャンセル</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="hint" role="status">@message</p>
        }
    </section>
    @if (!string.IsNullOrWhiteSpace(detail.LastError))
    {
        <section id="errors" class="card detail-section"><h3>失敗理由</h3><pre class="error">@detail.LastError</pre></section>
    }
    @if (detail.ParentJob is not null || detail.ChildJobs.Count > 0)
    {
        <section id="relations" class="card detail-section">
            <h3>親子タスク</h3>
            @if (detail.ParentJob is not null)
            {
                <p><span class="object-label">親</span><a href="@(Url(detail.ParentJob.JobId))">@detail.ParentJob.DeduplicationKey</a> <span class="pill">@detail.ParentJob.Status</span></p>
            }
            <div class="operation-list">
                @foreach (var child in detail.ChildJobs)
                {
                    <a class="operation-row related-job" href="@(Url(child.JobId))"><strong>@child.DeduplicationKey</strong><span class="pill">@child.Status</span><span class="hint">更新（JST） @Fmt(child.UpdatedAt)</span></a>
                }
            </div>
        </section>
    }
    <section id="payload" class="card detail-section"><h3>ペイロード</h3><pre class="payload">@detail.Payload</pre></section>
    </div>
}

@code {
    [Parameter] public string JobId { get; set; } = string.Empty;
    private AgentJobDetailReadModel? detail;
    private string? message;
    private bool confirmingRequeue;
    private bool requeueing;
    private bool confirmingCancel;
    private bool cancelling;
    private string cancelReason = string.Empty;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync() => detail = await Store.GetJobDetailAsync(JobId);

    private async Task RequeueAsync()
    {
        if (detail is null) return;

        requeueing = true;
        try
        {
            var result = await Store.ForceRequeueJobAsync(
                detail.JobId,
                detail.UpdatedAt,
                DateTimeOffset.UtcNow);
            message = result switch
            {
                ForceRequeueJobResult.Requeued => "再投入しました。",
                ForceRequeueJobResult.Conflict => "ジョブの状態が更新されていたため再投入しませんでした。最新状態を確認してください。",
                _ => "対象のジョブが見つかりませんでした。"
            };
            if (result == ForceRequeueJobResult.Requeued)
            {
                ExecutionTrigger.Signal();
            }
        }
        finally
        {
            confirmingRequeue = false;
            requeueing = false;
            await LoadAsync();
        }
    }

    private async Task CancelAsync()
    {
        if (detail is null || string.IsNullOrWhiteSpace(cancelReason)) return;
        cancelling = true;
        try
        {
            var result = await Store.CancelJobAsync(detail.JobId, detail.UpdatedAt, "admin-ui", cancelReason, DateTimeOffset.UtcNow);
            message = result switch
            {
                ForceRequeueJobResult.Requeued => "取り消しました。",
                ForceRequeueJobResult.Conflict => "ジョブの状態が更新されていたため取り消しませんでした。",
                _ => "対象のジョブが見つかりませんでした。"
            };
        }
        finally
        {
            confirmingCancel = false;
            cancelling = false;
            cancelReason = string.Empty;
            await LoadAsync();
        }
    }

    private static string Fmt(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
    private static string Url(string jobId) => $"/collection-tasks/{Uri.EscapeDataString(jobId)}";
}
