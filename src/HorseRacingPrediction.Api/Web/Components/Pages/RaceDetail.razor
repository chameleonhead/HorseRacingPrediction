@page "/races/{RaceId}"
@attribute [Authorize]
@inject AdminApiClient Api

<RaceOpsObjectHeader BackHref="/races" BackLabel="← レース一覧に戻る" Title="@(race?.RaceName ?? "レース詳細")" Section="レース・予想 / レース">
    <Actions><FluentButton Appearance="@Appearance.Outline" Href="@($"/races/{Uri.EscapeDataString(RaceId)}/edit")">編集</FluentButton></Actions>
</RaceOpsObjectHeader>

@if (loading) { <p>読み込み中…</p> }
else if (race is null) { <p>RaceId「@RaceId」のレースは見つかりませんでした。</p> }
else
{
    <section class="profile-facts" aria-label="レース基本情報">
        <div class="profile-fact"><span>コース</span><strong>@FormatDistanceSurface(race.DistanceMeters, race.SurfaceCode, race.DirectionCode)</strong></div>
        <div class="profile-fact"><span>天候・馬場</span><strong>@FormatWeatherAndTrack(race)</strong></div>
        <div class="profile-fact"><span>グレード</span><strong>@(string.IsNullOrWhiteSpace(race.GradeCode) ? "未設定" : race.GradeCode)</strong></div>
        <div class="profile-fact"><span>状態</span><strong><span class="badge @Races.StatusClass(race.Status)">@Races.StatusLabel(race.Status)</span></strong></div>
    </section>

    <RaceOpsDetailTabs>
    <FluentTab Label="概要" Id="overview">
    <section class="detail-card detail-section">
        <h2>@(race.RaceName ?? race.RaceId)</h2>
        <dl class="meta">
            <dt>RaceId</dt><dd><code>@race.RaceId</code></dd>
            <dt>日付</dt><dd>@race.RaceDate</dd>
            <dt>競馬場 / R</dt><dd>@race.RacecourseCode / @race.RaceNumber</dd>
            <dt>結果確定</dt><dd>@race.ResultDeclaredAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
            <dt>勝ち馬</dt>
            <dd>
                @if (!string.IsNullOrEmpty(race.WinningHorseId))
                {
                    <a href="@($"/horses/{Uri.EscapeDataString(race.WinningHorseId!)}")">@race.WinningHorseName</a>
                }
                else { @race.WinningHorseName }
            </dd>
        </dl>
    </section>

    <section id="status" class="detail-card detail-section" aria-label="取得状況">
        <h3>取得状況</h3>
        <dl class="meta">
            <dt>天候</dt><dd>@(race.WeatherObservations.Count == 0 ? "未取得" : (race.WeatherObservations.OrderByDescending(x => x.ObservationTime).First().WeatherText ?? race.WeatherObservations.OrderByDescending(x => x.ObservationTime).First().WeatherCode ?? "取得済み"))</dd>
            <dt>馬場</dt><dd>@(race.TrackConditionObservations.Count == 0 ? "未取得" : FormatTrackCondition(race.TrackConditionObservations.OrderByDescending(x => x.ObservationTime).First()))</dd>
            <dt>払戻</dt><dd>@(race.PayoutResult is null ? (race.EntryResults.Count == 0 ? "未取得" : "該当なし・未確定") : "取得済み")</dd>
        </dl>
    </section>
    </FluentTab>

    @if (race.Odds is not null && (race.Odds.WinOdds.Count > 0 || race.Odds.PlaceOdds.Count > 0))
    {
        <FluentTab Label="オッズ" Id="odds"><section class="detail-card detail-section" aria-labelledby="odds-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">MARKET DATA</p>
                    <h3 id="odds-heading">オッズ</h3>
                </div>
                <span class="hint">取得済みの券種のみ表示</span>
            </div>
            <div class="odds-layout">
                @if (race.Odds.WinOdds.Count > 0)
                {
                    <div class="odds-panel">
                        <h4>単勝</h4>
                        <table class="data-table odds-table">
                            <thead><tr><th scope="col">馬番</th><th scope="col">馬名</th><th scope="col">オッズ</th><th scope="col">人気</th></tr></thead>
                            <tbody>
                            @foreach (var odds in race.Odds.WinOdds.OrderBy(x => x.Odds ?? decimal.MaxValue))
                            {
                                <tr>
                                    <th scope="row">@odds.HorseNumber</th>
                                    <td>@EntityLink("horses", race.Entries.FirstOrDefault(x => x.HorseNumber == odds.HorseNumber)?.HorseId, odds.HorseName)</td>
                                    <td class="numeric">@(odds.Odds?.ToString("0.0") ?? "—")</td>
                                    <td class="numeric">@(odds.Popularity?.ToString() ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                @if (race.Odds.PlaceOdds.Count > 0)
                {
                    <div class="odds-panel">
                        <h4>複勝</h4>
                        <table class="data-table odds-table">
                            <thead><tr><th scope="col">馬番</th><th scope="col">馬名</th><th scope="col">オッズ</th></tr></thead>
                            <tbody>
                            @foreach (var odds in race.Odds.PlaceOdds.OrderBy(x => x.HorseNumber))
                            {
                                <tr>
                                    <th scope="row">@odds.HorseNumber</th>
                                    <td>@EntityLink("horses", race.Entries.FirstOrDefault(x => x.HorseNumber == odds.HorseNumber)?.HorseId, odds.HorseName)</td>
                                    <td class="numeric">@(FormatOddsRange(odds.OddsMin, odds.OddsMax))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section></FluentTab>
    }

    @if (race.Entries.Count > 0)
    {
        <FluentTab Label="出走表" Id="participants"><section class="entity-section detail-section">
            <h3>出走表</h3>
            <table class="data-table participant-table">
                <thead>
                    <tr>
                        <th scope="col">枠</th>
                        <th scope="col">馬番</th>
                        <th scope="col">馬名</th>
                        <th scope="col">性齢</th>
                        <th scope="col">馬体重</th>
                        <th scope="col">騎手</th>
                        <th scope="col">調教師</th>
                        <th scope="col">馬主</th>
                        <th scope="col">結果</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in race.Entries.OrderBy(x => x.HorseNumber))
                {
                    var result = race.EntryResults.FirstOrDefault(x => x.HorseId == e.HorseId);
                    <tr>
                        <td class="numeric">@e.GateNumber</td>
                        <th scope="row">@e.HorseNumber</th>
                        <td><a href="@($"/horses/{Uri.EscapeDataString(e.HorseId)}")">@(e.HorseName ?? e.HorseId)</a></td>
                        <td>@e.SexCode@e.Age</td>
                        <td class="numeric">@FormatBodyWeight(e.DeclaredWeight, e.DeclaredWeightDiff)</td>
                        <td>@EntityLink("jockeys", e.JockeyId, e.JockeyName)</td>
                        <td>@EntityLink("trainers", e.TrainerId, e.TrainerName)</td>
                        <td>@EntityLink("owners", e.OwnerId, e.OwnerName)</td>
                        <td>
                            <strong>@(result?.FinishPosition is null ? "結果未確定" : $"{result.FinishPosition}着")</strong>
                            <span class="hint">@(result?.OfficialTime ?? "タイム未確定")</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section></FluentTab>

        @if (race.EntryResults.Count > 0)
        {
            <FluentTab Label="結果" Id="results"><section class="entity-section detail-section">
                <h3>確定結果</h3>
                <table class="data-table participant-table">
                    <thead>
                        <tr>
                            <th scope="col">着順</th>
                            <th scope="col">馬番</th>
                            <th scope="col">馬名</th>
                            <th scope="col">タイム</th>
                            <th scope="col">騎手</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var result in race.EntryResults.OrderBy(x => x.FinishPosition ?? int.MaxValue))
                    {
                        var entry = race.Entries.FirstOrDefault(x => x.HorseId == result.HorseId);
                        <tr>
                            <th scope="row">@(result.FinishPosition is null ? "—" : $"{result.FinishPosition}着")</th>
                            <td class="numeric">@(entry?.HorseNumber.ToString() ?? "—")</td>
                            <td>@EntityLink("horses", result.HorseId, entry?.HorseName ?? result.HorseId)</td>
                            <td>@(result.OfficialTime ?? "タイム未登録")</td>
                            <td>@EntityLink("jockeys", entry?.JockeyId, entry?.JockeyName)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section></FluentTab>
        }
    }

    @if (!string.IsNullOrWhiteSpace(race.StewardReportText))
    {
        <FluentTab Label="概況" Id="report"><section class="detail-card detail-section">
            <h3>レース概況</h3>
            <pre class="payload">@race.StewardReportText</pre>
        </section></FluentTab>
    }

    <FluentTab Label="管理" Id="management"><section class="detail-card detail-section">
        <h3>管理情報</h3>
        <p class="hint">誤登録されたデータの補正は専用画面で行います。新規作成・出走登録・結果確定などのライフサイクル進行はCollector/Predictorが自動で行うため、ここでは対象外です。</p>
        <div class="action-row">
            <FluentButton Appearance="@Appearance.Accent" Href="@($"/races/{Uri.EscapeDataString(RaceId)}/edit")">データを補正する</FluentButton>
        </div>
    </section></FluentTab>

    <FluentTab Label="メモ" Id="memo"><div class="detail-section">
        <MemoPanel SubjectType="Race" SubjectId="@RaceId" />
    </div></FluentTab>
    </RaceOpsDetailTabs>
}

@code {
    [Parameter] public string RaceId { get; set; } = string.Empty;

    private bool loading;
    private RaceResponse? race;

    private string? correctRaceName;
    private string? correctRacecourseCode;
    private int? correctRaceNumber;
    private string? correctGradeCode;
    private string? correctSurfaceCode;
    private int? correctDistanceMeters;
    private string? correctDirectionCode;
    private string? correctReason;
    private bool correctArmed;
    private bool correcting;
    private IReadOnlyList<string> correctErrors = Array.Empty<string>();
    private bool HasPendingOperation => correcting || correctArmed;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            race = await Api.GetRaceAsync(RaceId);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CorrectAsync()
    {
        correcting = true;
        try
        {
            var result = await Api.CorrectRaceDataAsync(RaceId, new CorrectRaceDataRequest(
                correctRaceName, correctRacecourseCode, correctRaceNumber, correctGradeCode,
                correctSurfaceCode, correctDistanceMeters, correctDirectionCode, correctReason));
            correctErrors = result.Success ? Array.Empty<string>() : result.Errors;
            correctArmed = false;
            if (result.Success)
            {
                correctRaceName = null; correctRacecourseCode = null; correctRaceNumber = null;
                correctGradeCode = null; correctSurfaceCode = null; correctDistanceMeters = null;
                correctDirectionCode = null; correctReason = null;
                await LoadAsync();
            }
        }
        finally
        {
            correcting = false;
        }
    }

    private static RenderFragment EntityLink(string segment, string? id, string? label) => builder =>
    {
        if (string.IsNullOrWhiteSpace(id)) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", $"/{segment}/{Uri.EscapeDataString(id)}");
        builder.AddContent(3, string.IsNullOrWhiteSpace(label) ? id : label);
        builder.CloseElement();
    };

    private static string FormatBodyWeight(decimal? bodyWeight, decimal? bodyWeightDiff)
    {
        if (!bodyWeight.HasValue)
        {
            return string.Empty;
        }

        if (!bodyWeightDiff.HasValue || bodyWeightDiff.Value == 0m)
        {
            return bodyWeight.Value.ToString("0.#");
        }

        var diffPrefix = bodyWeightDiff.Value > 0m ? "+" : string.Empty;
        return $"{bodyWeight.Value:0.#} ({diffPrefix}{bodyWeightDiff.Value:0.#})";
    }

    private static string FormatDistanceSurface(int? distanceMeters, string? surfaceCode, string? directionCode)
    {
        var distance = distanceMeters.HasValue ? $"{distanceMeters.Value}m" : "未設定";
        var surface = string.IsNullOrWhiteSpace(surfaceCode) ? "未設定" : surfaceCode;
        var direction = string.IsNullOrWhiteSpace(directionCode) ? string.Empty : $"・{directionCode}";
        return $"{surface}{direction} {distance}";
    }

    private static string FormatWeatherAndTrack(RaceResponse race)
    {
        var weather = race.WeatherObservations.Count == 0
            ? "未取得"
            : (race.WeatherObservations.OrderByDescending(x => x.ObservationTime).First().WeatherText
               ?? race.WeatherObservations.OrderByDescending(x => x.ObservationTime).First().WeatherCode
               ?? "取得済み");
        var track = race.TrackConditionObservations.Count == 0
            ? "未取得"
            : FormatTrackCondition(race.TrackConditionObservations.OrderByDescending(x => x.ObservationTime).First());
        return $"{weather}・{track}";
    }

    private static string FormatTrackCondition(RaceTrackConditionResponse observation) =>
        observation.GoingDescriptionText ?? observation.TurfConditionCode ?? observation.DirtConditionCode ?? "取得済み";

    private static string FormatOddsRange(decimal? min, decimal? max)
    {
        if (!min.HasValue && !max.HasValue) return "—";
        if (min.HasValue && max.HasValue && min.Value != max.Value) return $"{min.Value:0.0}–{max.Value:0.0}";
        return (min ?? max)!.Value.ToString("0.0");
    }
}
