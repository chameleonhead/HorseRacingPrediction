@page "/trainers/{TrainerId}"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsObjectHeader BackHref="/trainers" BackLabel="← 調教師一覧に戻る" Title="@(trainer?.DisplayName ?? "調教師詳細")" Section="データ / 調教師">
    <Actions><FluentButton Appearance="@Appearance.Outline" Href="@($"/trainers/{Uri.EscapeDataString(TrainerId)}/edit")">編集</FluentButton></Actions>
</RaceOpsObjectHeader>

@if (loading) { <p>読み込み中…</p> }
else if (trainer is null) { <p>TrainerId「@TrainerId」の調教師は見つかりませんでした。</p> }
else
{
    <div class="detail-stack">
    <section class="profile-facts" aria-label="概要">
        <div class="profile-fact"><span>所属</span><strong>@(string.IsNullOrWhiteSpace(trainer.AffiliationCode) ? "未登録" : trainer.AffiliationCode)</strong></div>
        <div class="profile-fact"><span>登録表記</span><strong>@(trainer.Aliases.Count + 1) 件</strong></div>
        <div class="profile-fact"><span>関連する馬</span><strong>@relationships.Count(x => x.ObjectType == "Horse") 頭</strong></div>
    </section>

    <section class="detail-group" aria-label="関係"><RaceOpsRelationshipGrid SectionId="relations-section" Title="関連する馬（過去3年の獲得賞金順・上位5頭）" Items="@TopHorses" Url="@RelationshipUrl" /></section>

    <section class="detail-group" aria-label="履歴"><section class="entity-section detail-section">
        <h3>管理馬の出走履歴</h3>
        <div class="action-row"><label for="trainer-history-search">履歴を検索</label><input id="trainer-history-search" class="text-input" value="@historySearch" @oninput="OnHistorySearchInput" placeholder="馬名・競馬場・レース名" /></div>
        @if (historyEntries.Count == 0)
        {
            <p class="hint">出走履歴はありません。</p>
        }
        else
        {
            <ol class="history-list">
                @foreach (var entry in FilteredHistory)
                {
                    <li class="history-item">
                        <div class="history-event">
                            <a class="history-race" href="@($"/races/{Uri.EscapeDataString(entry.RaceId)}")">@(entry.RaceDate?.ToString("yyyy/MM/dd") ?? "日付未登録") @(entry.RacecourseCode ?? "—")@(entry.RaceNumber is null ? "" : $" {entry.RaceNumber}R")</a>
                            <span class="hint">@(entry.RaceName ?? entry.RaceId)</span>
                        </div>
                        <div class="history-result"><strong>@(entry.FinishPosition is null ? "結果 —" : $"{entry.FinishPosition}着")</strong><span class="hint">@(entry.PrizeMoney is null ? "賞金 —" : $"賞金 {entry.PrizeMoney:N0}")</span></div>
                        <div class="history-relations">
                            <div class="history-field"><span class="relationship-kind">馬</span><a href="@($"/horses/{Uri.EscapeDataString(entry.HorseId)}")">@entry.HorseName</a></div>
                            <div class="history-field"><span class="relationship-kind">騎手</span>@EntityLink("jockeys", entry.JockeyId, entry.JockeyName)</div>
                            <div class="history-field"><span class="relationship-kind">レース時点の馬主</span><span>@(entry.OwnerName ?? "—")</span></div>
                        </div>
                    </li>
                }
            </ol>
            @if (historyHasMore)
            {
                <div class="action-row">
                    <FluentButton Appearance="@Appearance.Outline" OnClick="@LoadMoreHistory">次の10件を読み込む</FluentButton>
                </div>
            }
        }
    </section>
    </section>

    @if (trainer.Aliases.Count > 0)
    {
        <section class="detail-group" aria-label="別名"><section class="detail-card detail-section">
            <h3>別名</h3>
            <ul>
                @foreach (var a in trainer.Aliases)
                {
                    <li><span class="pill">@a.AliasType</span> @a.AliasValue <span class="hint">(出典: @a.SourceName@(a.IsPrimary ? " / 主別名" : ""))</span></li>
                }
            </ul>
        </section>
        </section>
    }

    <section class="detail-group" aria-label="管理"><section class="detail-card detail-section">
        <h3>管理情報</h3>
        <p class="hint">プロフィール更新、別名統合、データ補正は専用画面で行います。</p>
        <div class="action-row">
            <FluentButton Appearance="@Appearance.Accent" Href="@($"/trainers/{Uri.EscapeDataString(TrainerId)}/edit")">データを補正する</FluentButton>
        </div>
    </section>
    </section>

    <section class="detail-group" aria-label="メモ"><div class="detail-section">
        <MemoPanel SubjectType="Trainer" SubjectId="@TrainerId" />
    </div>
    </section>
    </div>
}

@code {
    [Parameter] public string TrainerId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "historySearch")] public string? HistorySearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "historyPage")] public int? HistoryPageQuery { get; set; }

    private bool loading;
    private TrainerProfileResponse? trainer;
    private IReadOnlyList<ParticipationHistoryEntryResponse> historyEntries = Array.Empty<ParticipationHistoryEntryResponse>();
    private IReadOnlyList<RelationshipSummaryResponse> relationships = Array.Empty<RelationshipSummaryResponse>();
    private bool historyHasMore;
    private const int historyBatchSize = 10;
    private string historySearch = string.Empty;
    private int historyPage = 1;
    private IEnumerable<ParticipationHistoryEntryResponse> FilteredHistory => historyEntries.Where(x => string.IsNullOrWhiteSpace(historySearch) || $"{x.HorseName} {x.RaceName} {x.RacecourseCode}".Contains(historySearch, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<RelationshipSummaryResponse> TopHorses => relationships.Where(x => x.ObjectType == "Horse").OrderByDescending(x => x.PrizeMoneyTotal).ThenByDescending(x => x.ParticipationCount).Take(5);

    private string? editDisplayName;
    private string? editNormalizedName;
    private string? editAffiliationCode;
    private bool updating;
    private IReadOnlyList<string> updateErrors = Array.Empty<string>();

    private string? aliasType;
    private string? aliasValue;
    private string? aliasSourceName;
    private bool aliasIsPrimary;
    private bool mergingAlias;
    private IReadOnlyList<string> aliasErrors = Array.Empty<string>();

    private string? correctDisplayName;
    private string? correctNormalizedName;
    private string? correctAffiliationCode;
    private string? correctReason;
    private bool correcting;
    private bool correctArmed;
    private IReadOnlyList<string> correctErrors = Array.Empty<string>();
    private bool HasPendingOperation => updating || mergingAlias || correcting || correctArmed;

    protected override async Task OnParametersSetAsync()
    {
        historySearch = HistorySearchQuery ?? string.Empty;
        historyPage = Math.Max(1, HistoryPageQuery ?? 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var profileTask = Api.GetTrainerAsync(TrainerId);
            var participationsTask = Api.GetTrainerParticipationsAsync(TrainerId, historyBatchSize * historyPage, 0);
            await Task.WhenAll(profileTask, participationsTask);
            trainer = await profileTask;
            var participations = await participationsTask;
            historyEntries = participations?.Entries ?? Array.Empty<ParticipationHistoryEntryResponse>();
            relationships = participations?.Relationships ?? Array.Empty<RelationshipSummaryResponse>();
            historyHasMore = participations?.HasMore ?? false;
            if (trainer is not null)
            {
                editDisplayName = trainer.DisplayName;
                editNormalizedName = trainer.NormalizedName;
                editAffiliationCode = trainer.AffiliationCode;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void LoadMoreHistory()
    {
        if (!historyHasMore) return;
        NavigateHistory(historySearch, historyPage + 1);
    }

    private void OnHistorySearchInput(ChangeEventArgs args)
        => NavigateHistory(args.Value?.ToString() ?? string.Empty, 1);

    private void NavigateHistory(string search, int page)
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["historySearch"] = string.IsNullOrWhiteSpace(search) ? null : search,
            ["historyPage"] = page <= 1 ? null : page
        });
        Navigation.NavigateTo(uri, replace: true);
    }

    private static string RelationshipUrl(RelationshipSummaryResponse relationship) => relationship.ObjectType switch
    {
        "Horse" => $"/horses/{Uri.EscapeDataString(relationship.ObjectId)}",
        "Jockey" => $"/jockeys/{Uri.EscapeDataString(relationship.ObjectId)}",
        _ => "/trainers"
    };

    private static RenderFragment EntityLink(string segment, string? id, string? label) => builder =>
    {
        if (string.IsNullOrWhiteSpace(id)) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", $"/{segment}/{Uri.EscapeDataString(id)}");
        builder.AddContent(3, string.IsNullOrWhiteSpace(label) ? id : label);
        builder.CloseElement();
    };

    private async Task UpdateProfileAsync()
    {
        updating = true;
        try
        {
            var result = await Api.UpdateTrainerProfileAsync(TrainerId, new UpdateTrainerProfileRequest(
                editDisplayName, editNormalizedName, editAffiliationCode));
            updateErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success) await LoadAsync();
        }
        finally
        {
            updating = false;
        }
    }

    private async Task MergeAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(aliasType) || string.IsNullOrWhiteSpace(aliasValue) || string.IsNullOrWhiteSpace(aliasSourceName))
        {
            aliasErrors = new[] { "種別・値・出典はすべて必須です。" };
            return;
        }

        mergingAlias = true;
        try
        {
            var result = await Api.MergeTrainerAliasAsync(TrainerId, new MergeAliasRequest(
                aliasType!, aliasValue!, aliasSourceName!, aliasIsPrimary));
            aliasErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success)
            {
                aliasType = null; aliasValue = null; aliasSourceName = null; aliasIsPrimary = false;
                await LoadAsync();
            }
        }
        finally
        {
            mergingAlias = false;
        }
    }

    private async Task CorrectAsync()
    {
        correcting = true;
        try
        {
            var result = await Api.CorrectTrainerDataAsync(TrainerId, new CorrectTrainerDataRequest(
                correctDisplayName, correctNormalizedName, correctAffiliationCode, correctReason));
            correctErrors = result.Success ? Array.Empty<string>() : result.Errors;
            correctArmed = false;
            if (result.Success)
            {
                correctDisplayName = null; correctNormalizedName = null; correctAffiliationCode = null; correctReason = null;
                await LoadAsync();
            }
        }
        finally
        {
            correcting = false;
        }
    }
}
