@page "/races"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation
@using HorseRacingPrediction.Contracts

<RaceOpsPageHeader Section="レース・予想" Title="レース" Description="期間を問わず同じ行形式で検索・ページングします。" />

<FluentCard class="filter-card">
    <nav class="view-tabs" aria-label="期間プリセット">
        <button type="button" class="@(PresetClass("today"))" aria-current="@(IsPresetActive("today") ? "page" : null)" @onclick="@ApplyTodayAsync">今日</button>
        <button type="button" class="@(PresetClass("week"))" aria-current="@(IsPresetActive("week") ? "page" : null)" @onclick="@ApplyWeekAsync">今週</button>
        <button type="button" class="@(PresetClass("confirmed"))" aria-current="@(IsPresetActive("confirmed") ? "page" : null)" @onclick="@ApplyConfirmedAsync">結果確定</button>
        <button type="button" class="@(PresetClass("all"))" aria-current="@(IsPresetActive("all") ? "page" : null)" @onclick="@ApplyAllAsync">すべて</button>
    </nav>
    <div class="filter-toolbar">
        <div class="filter-field filter-field-primary"><FluentTextField aria-label="レース検索" Placeholder="レース名を検索" @bind-Value="raceName" /></div>
        <div class="filter-field filter-field-compact"><input aria-label="開始日" type="date" @bind="from" /></div>
        <div class="filter-field filter-field-compact"><input aria-label="終了日" type="date" @bind="to" /></div>
        <div class="filter-field filter-field-compact"><FluentTextField aria-label="開催場" @bind-Value="racecourse" Placeholder="開催場" /></div>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">検索</FluentButton>
    </div>
    <details class="advanced-filters">
        <summary>詳細条件</summary>
        <div class="advanced-filter-grid">
            <input aria-label="レース番号" type="number" @bind="raceNo" min="1" max="12" placeholder="レース番号" />
            <FluentTextField aria-label="勝ち馬" Placeholder="勝ち馬" @bind-Value="winningHorse" />
        </div>
    </details>
    <RaceOpsFilterSummary Chips="@BuildFilterChips()" OnClearAll="@ClearFiltersAsync" />
</FluentCard>

@if (loading && result is null) { <UiState Kind="loading" Title="レースを読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当するレースはありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading) { <p class="hint">検索中… 直前の結果を表示しています。</p> }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <RaceOpsObjectList Label="レース一覧">
        @foreach (var r in result.Items)
        {
            <RaceOpsSelectableRow Href="@RaceUrl(r.RaceId)" Class="race-row">
                <span class="object-list-main">
                    <strong>@(r.RaceName ?? r.RaceId)</strong>
                    <span class="hint">
                        <a href="@DateFilterUrl(r.RaceDate)" @onclick="() => FilterByDateAsync(r.RaceDate)" @onclick:preventDefault @onclick:stopPropagation>@(r.RaceDate?.ToString("yyyy/MM/dd") ?? "日付未登録")</a>
                        · <a href="@RacecourseFilterUrl(r.RacecourseCode)" @onclick="() => FilterByRacecourseAsync(r.RacecourseCode)" @onclick:preventDefault @onclick:stopPropagation>@(r.RacecourseCode ?? "開催場未登録")</a>
                        · @($"{r.RaceNumber}R")
                    </span>
                </span>
                <span class="badge @StatusClass(r.Status)">@StatusLabel(r.Status)</span>
                <span class="object-list-meta">頭数 @(r.EntryCount?.ToString() ?? "—") ・ 勝ち馬 @(r.WinningHorseName ?? "—")</span>
                <span class="object-list-affordance">詳細</span>
            </RaceOpsSelectableRow>
        }
    </RaceOpsObjectList>
    <Pagination TotalCount="result.TotalCount" Page="page" PageSize="pageSize" PageChanged="GoPageAsync" />
}

@code {
    private DateOnly? from = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
    private DateOnly? to = DateOnly.FromDateTime(DateTime.Today);
    private string? racecourse;
    private int? raceNo;
    private string? raceName;
    private string? winningHorse;
    private RaceStatus? status;
    private int page = 1;
    private const int pageSize = 50;
    private bool loading;
    private PagedResponse<RaceSummaryResponse>? result;

    private string? lastSyncedQuery;
    private bool isFirstQuerySync = true;

    // Blazor はルートの再解決だけでは OnInitializedAsync を再実行しない（同一コンポーネント
    // インスタンスが再利用されるため）。開催場リンクなど、同じ /races 内でクエリ文字列だけが
    // 変わるナビゲーションでも検索条件を反映できるよう、毎回のパラメーター設定時に呼ばれる
    // OnParametersSetAsync で URL を読み直す。自分自身の UpdateUrl による NavigateTo で
    // 二重にロードしないよう、直前に同期済みの URL と比較してから処理する。
    protected override async Task OnParametersSetAsync()
    {
        var currentQuery = Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery;
        if (currentQuery == lastSyncedQuery)
        {
            return;
        }

        lastSyncedQuery = currentQuery;

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        // クエリ文字列が全く無い初回アクセス（/races 単体でのナビゲーション）に限り、
        // フィールド宣言時の既定値（直近30日など）を維持する。以降のナビゲーションでは
        // 未指定のパラメーターは明示的なクリアとして扱う（日付/開催場リンクは他の条件を
        // 引き継がず単一条件で絞り込む設計のため）。
        var useDeclaredDefaults = isFirstQuerySync && query.Count == 0;
        isFirstQuerySync = false;

        from = ParseDate(query, "from", useDeclaredDefaults ? from : null);
        to = ParseDate(query, "to", useDeclaredDefaults ? to : null);
        racecourse = ParseText(query, "racecourse");
        raceName = ParseText(query, "raceName");
        winningHorse = ParseText(query, "winningHorse");
        status = Enum.TryParse<RaceStatus>(ParseText(query, "status"), out var requestedStatus) ? requestedStatus : null;
        raceNo = int.TryParse(ParseText(query, "raceNo"), out var raceNumber) ? raceNumber : null;
        page = int.TryParse(ParseText(query, "page"), out var requestedPage) && requestedPage > 0 ? requestedPage : 1;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            result = await Api.SearchRacesAsync(new SearchRacesRequest
            {
                RaceDateFrom = from,
                RaceDateTo = to,
                RacecourseCode = racecourse,
                RaceNumber = raceNo,
                RaceName = raceName,
                WinningHorseName = winningHorse,
                Status = status,
                Page = page,
                PageSize = pageSize,
                SortBy = "raceDate",
                SortDescending = true
            });
        }
        finally { loading = false; }
    }

    private async Task GoPageAsync(int value)
    {
        page = value;
        UpdateUrl();
        await LoadAsync();
    }

    // 一覧行内の日付・開催場リンクは href も持たせて別タブ表示に対応しているが、通常
    // クリックは href の再ナビゲーション（OnParametersSetAsync 経由の再パース）だけに
    // 頼らず、ここで直接フィルター条件を設定してから読み込む。UpdateUrl による置換
    // ナビゲーションと href ナビゲーションが競合し、絞り込み表示が更新されないことが
    // あるため（Jobs.razor の日別サマリーリンクと同種の不具合）。
    private async Task FilterByDateAsync(DateOnly? date)
    {
        if (date is null) { return; }
        from = date; to = date; racecourse = null; raceNo = null; raceName = null; winningHorse = null; status = null;
        page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private async Task FilterByRacecourseAsync(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) { return; }
        racecourse = code; from = null; to = null; raceNo = null; raceName = null; winningHorse = null; status = null;
        page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    private void UpdateUrl()
    {
        var values = new Dictionary<string, string?>
        {
            ["from"] = from?.ToString("yyyy-MM-dd"),
            ["to"] = to?.ToString("yyyy-MM-dd"),
            ["racecourse"] = racecourse,
            ["raceNo"] = raceNo?.ToString(),
            ["raceName"] = raceName,
            ["winningHorse"] = winningHorse,
            ["status"] = status?.ToString(),
            ["page"] = page.ToString()
        };
        NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/races", values.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    }

    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }

    private static DateOnly? ParseDate(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key, DateOnly? fallback) => DateOnly.TryParse(ParseText(q, key), out var value) ? value : fallback;
    private static string? ParseText(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key) => q.TryGetValue(key, out var value) ? value.ToString() : null;
    private List<RaceOpsFilterChip> BuildFilterChips()
    {
        var chips = new List<RaceOpsFilterChip>();
        if (from is not null || to is not null)
        {
            chips.Add(new($"期間 {from?.ToString("yyyy/MM/dd") ?? "開始なし"}〜{to?.ToString("yyyy/MM/dd") ?? "終了なし"}", async () => { from = null; to = null; page = 1; UpdateUrl(); await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(racecourse))
        {
            chips.Add(new($"開催場 {racecourse}", async () => { racecourse = null; page = 1; UpdateUrl(); await LoadAsync(); }));
        }
        if (raceNo is not null)
        {
            chips.Add(new($"{raceNo}R", async () => { raceNo = null; page = 1; UpdateUrl(); await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(raceName))
        {
            chips.Add(new($"レース名 {raceName}", async () => { raceName = null; page = 1; UpdateUrl(); await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(winningHorse))
        {
            chips.Add(new($"勝ち馬 {winningHorse}", async () => { winningHorse = null; page = 1; UpdateUrl(); await LoadAsync(); }));
        }
        if (status is not null)
        {
            chips.Add(new($"状態 {StatusLabel(status)}", async () => { status = null; page = 1; UpdateUrl(); await LoadAsync(); }));
        }
        return chips;
    }
    private async Task ApplyPeriodAsync(string preset)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        switch (preset)
        {
            case "today": from = today; to = today; status = null; break;
            case "week":
                from = today.AddDays(-((int)today.DayOfWeek + 6) % 7);
                to = from.Value.AddDays(6);
                status = null;
                break;
            case "confirmed": from = null; to = null; status = RaceStatus.ResultDeclared; break;
            default: from = null; to = null; status = null; break;
        }
        page = 1;
        UpdateUrl();
        await LoadAsync();
    }
    private Task ApplyTodayAsync() => ApplyPeriodAsync("today");
    private Task ApplyWeekAsync() => ApplyPeriodAsync("week");
    private Task ApplyConfirmedAsync() => ApplyPeriodAsync("confirmed");
    private Task ApplyAllAsync() => ApplyPeriodAsync("all");
    private bool IsPresetActive(string preset) => preset switch
    {
        "today" => from == DateOnly.FromDateTime(DateTime.Today) && to == from && status is null,
        "week" => from == DateOnly.FromDateTime(DateTime.Today.AddDays(-((int)DateTime.Today.DayOfWeek + 6) % 7)) && status is null,
        "confirmed" => from is null && to is null && status == RaceStatus.ResultDeclared,
        "all" => from is null && to is null && status is null,
        _ => false
    };
    private string PresetClass(string preset) => IsPresetActive(preset) ? "active" : string.Empty;
    private async Task ClearFiltersAsync()
    {
        from = null; to = null; racecourse = null; raceNo = null; raceName = null; winningHorse = null; status = null; page = 1;
        UpdateUrl();
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 初回レンダリング後に URL を同期する（プリレンダリング中の NavigateTo を回避）
            UpdateUrl();
        }
        return Task.CompletedTask;
    }
    private static string RaceUrl(string id) => $"/races/{Uri.EscapeDataString(id)}";
    private static string DateFilterUrl(DateOnly? date) => date is null ? "/races" : $"/races?from={date:yyyy-MM-dd}&to={date:yyyy-MM-dd}";
    private static string RacecourseFilterUrl(string? code) => string.IsNullOrWhiteSpace(code) ? "/races" : $"/races?racecourse={Uri.EscapeDataString(code)}";
    internal static string StatusClass(object? status) => status switch
    {
        RaceStatus.ResultDeclared or RaceStatus.PayoutDeclared => "ok",
        RaceStatus.InProgress or RaceStatus.PreRaceOpen => "warn",
        RaceStatus.CardPublished => "info",
        RaceStatus.Closed => "bad",
        _ => "info"
    };
    internal static string StatusLabel(RaceStatus? value) => value switch
    {
        RaceStatus.Draft => "下書き", RaceStatus.CardPublished => "出馬表公開", RaceStatus.PreRaceOpen => "発走前", RaceStatus.InProgress => "レース中", RaceStatus.ResultDeclared => "結果確定", RaceStatus.PayoutDeclared => "払戻確定", RaceStatus.Closed => "締切", _ => "状態未登録"
    };
}
