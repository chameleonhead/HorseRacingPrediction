@page "/collection-tasks"
@page "/collection-tasks/{JobId}"
@inject NavigationManager Navigation
@code {
    [Parameter] public string? JobId { get; set; }
    protected override void OnInitialized() => Navigation.NavigateTo(string.IsNullOrWhiteSpace(JobId) ? "/jobs" : $"/jobs/{Uri.EscapeDataString(JobId)}", replace: true);
}
