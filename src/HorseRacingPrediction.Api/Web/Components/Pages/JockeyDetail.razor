@page "/jockeys/{JockeyId}"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsObjectHeader BackHref="/jockeys" BackLabel="← 騎手一覧に戻る" Title="@(jockey?.DisplayName ?? "騎手詳細")" Section="データ / 騎手">
    <Actions><FluentButton Appearance="@Appearance.Outline" Href="@($"/jockeys/{Uri.EscapeDataString(JockeyId)}/edit")">編集</FluentButton></Actions>
</RaceOpsObjectHeader>

@if (loading) { <p>読み込み中…</p> }
else if (jockey is null) { <p>JockeyId「@JockeyId」の騎手は見つかりませんでした。</p> }
else
{
    <div class="detail-stack">
    <section class="profile-facts" aria-label="概要">
        <div class="profile-fact"><span>所属</span><strong>@(string.IsNullOrWhiteSpace(jockey.AffiliationCode) ? "未登録" : jockey.AffiliationCode)</strong></div>
        <div class="profile-fact"><span>登録表記</span><strong>@(jockey.Aliases.Count + 1) 件</strong></div>
        <div class="profile-fact"><span>関連する馬</span><strong>@relationships.Count(x => x.ObjectType == "Horse") 頭</strong></div>
    </section>

    <section class="detail-group" aria-label="関係"><RaceOpsRelationshipGrid SectionId="relations-section" Title="関連する馬（過去3年の獲得賞金順・上位5頭）" ParticipationUnit="鞍" Ranked="true" Items="@TopHorses" Url="@RelationshipUrl" /></section>

    <section class="detail-group" aria-label="履歴"><section class="entity-section detail-section">
        <h3>騎乗履歴</h3>
        <div class="filter-toolbar history-filter">
            <div class="filter-field filter-field-primary"><input aria-label="騎乗履歴を検索" @bind="historySearchInput" placeholder="馬名・レース名を検索" /></div>
            <div class="filter-field filter-field-compact"><input aria-label="開始日" type="date" @bind="historyFromInput" /></div>
            <div class="filter-field filter-field-compact"><input aria-label="終了日" type="date" @bind="historyToInput" /></div>
            <div class="filter-field filter-field-compact"><input aria-label="開催場" @bind="historyRacecourseInput" placeholder="開催場" /></div>
            <FluentButton Appearance="@Appearance.Accent" OnClick="@ApplyHistoryFilters">検索</FluentButton>
        </div>
        <p class="hint">開催日の新しい順</p>
        @if (historyEntries.Count == 0)
        {
            <p class="hint">騎乗履歴はありません。</p>
        }
        else
        {
            <ol class="history-list">
                @foreach (var entry in FilteredHistory)
                {
                    <li class="history-item">
                        <div class="history-event">
                            <a class="history-race" href="@($"/races/{Uri.EscapeDataString(entry.RaceId)}")">@(entry.RaceDate?.ToString("yyyy/MM/dd") ?? "日付未登録") @Display(entry.RacecourseCode)@(entry.RaceNumber is null ? "" : $" {entry.RaceNumber}R")</a>
                            <span class="hint">@(entry.RaceName ?? entry.RaceId)</span>
                        </div>
                        <div class="history-result"><strong>@FormatFinish(entry.FinishPosition)</strong><span class="hint">@(entry.PrizeMoney is null ? "賞金 —" : $"賞金 {entry.PrizeMoney:N0}")</span></div>
                        <div class="history-relations">
                            <div class="history-field"><span class="relationship-kind">馬</span><a href="@($"/horses/{Uri.EscapeDataString(entry.HorseId)}")">@entry.HorseName</a></div>
                            <div class="history-field"><span class="relationship-kind">調教師</span>@EntityLink("trainers", entry.TrainerId, entry.TrainerName)</div>
                            <div class="history-field"><span class="relationship-kind">レース時点の馬主</span><span>@(entry.OwnerName ?? "—")</span></div>
                        </div>
                    </li>
                }
            </ol>
            @if (FilteredHistoryCount > historyBatchSize)
            {
                <Pagination TotalCount="@FilteredHistoryCount" Page="@historyPage" PageSize="@historyBatchSize" PageChanged="@ChangeHistoryPage" />
            }
        }
    </section>
    </section>

    @if (jockey.Aliases.Count > 0)
    {
        <section class="detail-group" aria-label="別名"><section class="detail-card detail-section">
            <h3>別名</h3>
            <ul>
                @foreach (var a in jockey.Aliases)
                {
                    <li><span class="pill">@a.AliasType</span> @a.AliasValue <span class="hint">(出典: @a.SourceName@(a.IsPrimary ? " / 主別名" : ""))</span></li>
                }
            </ul>
        </section>
        </section>
    }

    <section class="detail-group" aria-label="管理"><section class="detail-card detail-section">
        <h3>管理情報</h3>
        <p class="hint">プロフィール更新、別名統合、データ補正は専用画面で行います。</p>
        <div class="action-row">
            <FluentButton Appearance="@Appearance.Accent" Href="@($"/jockeys/{Uri.EscapeDataString(JockeyId)}/edit")">データを補正する</FluentButton>
        </div>
    </section>
    </section>

    <section class="detail-group" aria-label="メモ"><div class="detail-section">
        <MemoPanel SubjectType="Jockey" SubjectId="@JockeyId" />
    </div>
    </section>
    </div>
}

@code {
    [Parameter] public string JockeyId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "historySearch")] public string? HistorySearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "historyPage")] public int? HistoryPageQuery { get; set; }
    [SupplyParameterFromQuery(Name = "historyFrom")] public DateOnly? HistoryFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "historyTo")] public DateOnly? HistoryToQuery { get; set; }
    [SupplyParameterFromQuery(Name = "historyRacecourse")] public string? HistoryRacecourseQuery { get; set; }

    private bool loading;
    private JockeyProfileResponse? jockey;
    private IReadOnlyList<ParticipationHistoryEntryResponse> historyEntries = Array.Empty<ParticipationHistoryEntryResponse>();
    private IReadOnlyList<RelationshipSummaryResponse> relationships = Array.Empty<RelationshipSummaryResponse>();
    private const int historyBatchSize = 10;
    private string historySearch = string.Empty;
    private string historySearchInput = string.Empty;
    private DateOnly? historyFrom;
    private DateOnly? historyFromInput;
    private DateOnly? historyTo;
    private DateOnly? historyToInput;
    private string historyRacecourse = string.Empty;
    private string historyRacecourseInput = string.Empty;
    private int historyPage = 1;
    private IEnumerable<ParticipationHistoryEntryResponse> MatchingHistory => historyEntries.Where(x =>
        (string.IsNullOrWhiteSpace(historySearch) || $"{x.HorseName} {x.RaceName}".Contains(historySearch, StringComparison.OrdinalIgnoreCase))
        && (!historyFrom.HasValue || x.RaceDate >= historyFrom)
        && (!historyTo.HasValue || x.RaceDate <= historyTo)
        && (string.IsNullOrWhiteSpace(historyRacecourse) || string.Equals(x.RacecourseCode, historyRacecourse, StringComparison.OrdinalIgnoreCase)));
    private int FilteredHistoryCount => MatchingHistory.Count();
    private IEnumerable<ParticipationHistoryEntryResponse> FilteredHistory => MatchingHistory.Skip((historyPage - 1) * historyBatchSize).Take(historyBatchSize);
    private IEnumerable<RelationshipSummaryResponse> TopHorses => relationships.Where(x => x.ObjectType == "Horse").OrderByDescending(x => x.PrizeMoneyTotal).ThenByDescending(x => x.ParticipationCount).Take(5);

    private string? editDisplayName;
    private string? editNormalizedName;
    private string? editAffiliationCode;
    private bool updating;
    private IReadOnlyList<string> updateErrors = Array.Empty<string>();

    private string? aliasType;
    private string? aliasValue;
    private string? aliasSourceName;
    private bool aliasIsPrimary;
    private bool mergingAlias;
    private IReadOnlyList<string> aliasErrors = Array.Empty<string>();

    private string? correctDisplayName;
    private string? correctNormalizedName;
    private string? correctAffiliationCode;
    private string? correctReason;
    private bool correcting;
    private bool correctArmed;
    private IReadOnlyList<string> correctErrors = Array.Empty<string>();
    private bool HasPendingOperation => updating || mergingAlias || correcting || correctArmed;

    protected override async Task OnParametersSetAsync()
    {
        historySearch = HistorySearchQuery ?? string.Empty;
        historySearchInput = historySearch;
        historyFrom = historyFromInput = HistoryFromQuery;
        historyTo = historyToInput = HistoryToQuery;
        historyRacecourse = historyRacecourseInput = HistoryRacecourseQuery ?? string.Empty;
        historyPage = Math.Max(1, HistoryPageQuery ?? 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var profileTask = Api.GetJockeyAsync(JockeyId);
            var historyTask = Api.GetJockeyParticipationsAsync(JockeyId, 10000, 0);
            await Task.WhenAll(profileTask, historyTask);
            jockey = await profileTask;
            var history = await historyTask;
            historyEntries = history?.Entries ?? Array.Empty<ParticipationHistoryEntryResponse>();
            relationships = history?.Relationships ?? Array.Empty<RelationshipSummaryResponse>();
            if (jockey is not null)
            {
                editDisplayName = jockey.DisplayName;
                editNormalizedName = jockey.NormalizedName;
                editAffiliationCode = jockey.AffiliationCode;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyHistoryFilters() => NavigateHistory(historySearchInput, historyFromInput, historyToInput, historyRacecourseInput, 1);
    private Task ChangeHistoryPage(int page) { NavigateHistory(historySearch, historyFrom, historyTo, historyRacecourse, page); return Task.CompletedTask; }
    private void NavigateHistory(string search, DateOnly? from, DateOnly? to, string racecourse, int page)
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["historySearch"] = string.IsNullOrWhiteSpace(search) ? null : search,
            ["historyFrom"] = from,
            ["historyTo"] = to,
            ["historyRacecourse"] = string.IsNullOrWhiteSpace(racecourse) ? null : racecourse,
            ["historyPage"] = page <= 1 ? null : page
        });
        Navigation.NavigateTo(uri, replace: true);
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatFinish(int? position) => position is null ? "結果 —" : $"{position}着";

    private static string RelationshipUrl(RelationshipSummaryResponse relationship) => relationship.ObjectType switch
    {
        "Horse" => $"/horses/{Uri.EscapeDataString(relationship.ObjectId)}",
        "Trainer" => $"/trainers/{Uri.EscapeDataString(relationship.ObjectId)}",
        _ => "/jockeys"
    };

    private static RenderFragment EntityLink(string segment, string? id, string? label) => builder =>
    {
        if (string.IsNullOrWhiteSpace(id)) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", $"/{segment}/{Uri.EscapeDataString(id)}");
        builder.AddContent(3, string.IsNullOrWhiteSpace(label) ? id : label);
        builder.CloseElement();
    };


    private async Task UpdateProfileAsync()
    {
        updating = true;
        try
        {
            var result = await Api.UpdateJockeyProfileAsync(JockeyId, new UpdateJockeyProfileRequest(
                editDisplayName, editNormalizedName, editAffiliationCode));
            updateErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success) await LoadAsync();
        }
        finally
        {
            updating = false;
        }
    }

    private async Task MergeAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(aliasType) || string.IsNullOrWhiteSpace(aliasValue) || string.IsNullOrWhiteSpace(aliasSourceName))
        {
            aliasErrors = new[] { "種別・値・出典はすべて必須です。" };
            return;
        }

        mergingAlias = true;
        try
        {
            var result = await Api.MergeJockeyAliasAsync(JockeyId, new MergeAliasRequest(
                aliasType!, aliasValue!, aliasSourceName!, aliasIsPrimary));
            aliasErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success)
            {
                aliasType = null; aliasValue = null; aliasSourceName = null; aliasIsPrimary = false;
                await LoadAsync();
            }
        }
        finally
        {
            mergingAlias = false;
        }
    }

    private async Task CorrectAsync()
    {
        correcting = true;
        try
        {
            var result = await Api.CorrectJockeyDataAsync(JockeyId, new CorrectJockeyDataRequest(
                correctDisplayName, correctNormalizedName, correctAffiliationCode, correctReason));
            correctErrors = result.Success ? Array.Empty<string>() : result.Errors;
            correctArmed = false;
            if (result.Success)
            {
                correctDisplayName = null; correctNormalizedName = null; correctAffiliationCode = null; correctReason = null;
                await LoadAsync();
            }
        }
        finally
        {
            correcting = false;
        }
    }
}
