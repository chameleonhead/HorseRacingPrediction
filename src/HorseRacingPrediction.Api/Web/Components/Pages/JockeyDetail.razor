@page "/jockeys/{JockeyId}"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>騎手詳細</h1>
<p class="hint"><a href="jockeys">← 騎手検索へ戻る</a></p>

@if (loading) { <p>読み込み中…</p> }
else if (jockey is null) { <p>JockeyId「@JockeyId」の騎手は見つかりませんでした。</p> }
else
{
    <section class="card">
        <h2>@jockey.DisplayName</h2>
        <dl class="meta">
            <dt>JockeyId</dt><dd><code>@jockey.JockeyId</code></dd>
            <dt>正規化名</dt><dd>@jockey.NormalizedName</dd>
            <dt>所属</dt><dd>@jockey.AffiliationCode</dd>
        </dl>
    </section>

    @if (participations?.Relationships.Count > 0)
    {
        <section class="entity-section">
            <h3>この騎手に関係する馬・調教師</h3>
            <div class="relationship-grid">
                @foreach (var relationship in participations.Relationships.Take(6))
                {
                    <a class="relationship-link" href="@RelationshipUrl(relationship)">
                        <span class="relationship-kind">@relationship.RelationshipName</span>
                        <strong>@relationship.DisplayName</strong>
                        <span class="hint">@relationship.ParticipationCount 鞍・最終 @(relationship.LastParticipationDate?.ToString("yyyy/MM/dd") ?? "—")</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="entity-section">
        <h3>騎乗履歴</h3>
        @if (participations is null || participations.Entries.Count == 0)
        {
            <p class="hint">騎乗履歴はありません。</p>
        }
        else
        {
            <ol class="history-list">
                @foreach (var entry in participations.Entries)
                {
                    <li class="history-item">
                        <div class="history-event">
                            <a class="history-race" href="@($"races/{Uri.EscapeDataString(entry.RaceId)}")">@(entry.RaceDate?.ToString("yyyy/MM/dd") ?? "日付未登録") @Display(entry.RacecourseCode)@(entry.RaceNumber is null ? "" : $" {entry.RaceNumber}R")</a>
                            <span class="hint">@(entry.RaceName ?? entry.RaceId)</span>
                        </div>
                        <div class="history-result"><strong>@FormatFinish(entry.FinishPosition)</strong><span class="hint">@(entry.PrizeMoney is null ? "賞金 —" : $"賞金 {entry.PrizeMoney:N0}")</span></div>
                        <div class="history-relations">
                            <div class="history-field"><span class="relationship-kind">馬</span><a href="@($"horses/{Uri.EscapeDataString(entry.HorseId)}")">@entry.HorseName</a></div>
                            <div class="history-field"><span class="relationship-kind">調教師</span>@EntityLink("trainers", entry.TrainerId, entry.TrainerName)</div>
                            <div class="history-field"><span class="relationship-kind">レース時点の馬主</span><span>@(entry.OwnerName ?? "—")</span></div>
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    @if (jockey.Aliases.Count > 0)
    {
        <section class="card">
            <h3>別名</h3>
            <ul>
                @foreach (var a in jockey.Aliases)
                {
                    <li><span class="pill">@a.AliasType</span> @a.AliasValue <span class="hint">(出典: @a.SourceName@(a.IsPrimary ? " / 主別名" : ""))</span></li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <h3>プロフィール更新</h3>
        <div class="form-grid">
            <label>表示名<input @bind="editDisplayName" /></label>
            <label>正規化名<input @bind="editNormalizedName" /></label>
            <label>所属<input @bind="editAffiliationCode" /></label>
        </div>
        <div class="toolbar">
            <button class="btn primary small" @onclick="UpdateProfileAsync" disabled="@updating">更新</button>
        </div>
        @if (updateErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in updateErrors) { <li>@e</li> }</ul>
        }
    </section>

    <section class="card">
        <h3>別名の追加・統合</h3>
        <div class="form-grid">
            <label>種別<input @bind="aliasType" placeholder="例: netkeiba" /></label>
            <label>値<input @bind="aliasValue" /></label>
            <label>出典<input @bind="aliasSourceName" /></label>
            <label><input type="checkbox" @bind="aliasIsPrimary" /> 主別名にする</label>
        </div>
        <div class="toolbar">
            <button class="btn primary small" @onclick="MergeAliasAsync" disabled="@mergingAlias">追加</button>
        </div>
        @if (aliasErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in aliasErrors) { <li>@e</li> }</ul>
        }
    </section>

    <section class="card">
        <h3>データ訂正</h3>
        <p class="hint">誤登録されたデータの訂正用です。理由の記録が残ります。</p>
        <div class="form-grid">
            <label>表示名<input @bind="correctDisplayName" /></label>
            <label>正規化名<input @bind="correctNormalizedName" /></label>
            <label>所属<input @bind="correctAffiliationCode" /></label>
            <label>訂正理由<input @bind="correctReason" /></label>
        </div>
        <div class="toolbar">
            @if (correctArmed) { <span class="hint">入力した内容で訂正しますか？</span><button class="btn primary small" @onclick="CorrectAsync" disabled="@correcting">訂正を保存する</button><button class="btn small" @onclick="() => correctArmed = false">キャンセル</button> }
            else { <button class="btn primary small" @onclick="() => correctArmed = true">訂正内容を確認</button> }
        </div>
        @if (correctErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in correctErrors) { <li>@e</li> }</ul>
        }
    </section>

    <MemoPanel SubjectType="Jockey" SubjectId="@JockeyId" />
}

@code {
    [Parameter] public string JockeyId { get; set; } = string.Empty;

    private bool loading;
    private JockeyProfileResponse? jockey;
    private ParticipationHistoryResponse? participations;

    private string? editDisplayName;
    private string? editNormalizedName;
    private string? editAffiliationCode;
    private bool updating;
    private IReadOnlyList<string> updateErrors = Array.Empty<string>();

    private string? aliasType;
    private string? aliasValue;
    private string? aliasSourceName;
    private bool aliasIsPrimary;
    private bool mergingAlias;
    private IReadOnlyList<string> aliasErrors = Array.Empty<string>();

    private string? correctDisplayName;
    private string? correctNormalizedName;
    private string? correctAffiliationCode;
    private string? correctReason;
    private bool correcting;
    private bool correctArmed;
    private IReadOnlyList<string> correctErrors = Array.Empty<string>();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var profileTask = Api.GetJockeyAsync(JockeyId);
            var historyTask = Api.GetJockeyParticipationsAsync(JockeyId);
            await Task.WhenAll(profileTask, historyTask);
            jockey = await profileTask;
            participations = await historyTask;
            if (jockey is not null)
            {
                editDisplayName = jockey.DisplayName;
                editNormalizedName = jockey.NormalizedName;
                editAffiliationCode = jockey.AffiliationCode;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatFinish(int? position) => position is null ? "結果 —" : $"{position}着";

    private static string RelationshipUrl(RelationshipSummaryResponse relationship) => relationship.ObjectType switch
    {
        "Horse" => $"horses/{Uri.EscapeDataString(relationship.ObjectId)}",
        "Trainer" => $"trainers/{Uri.EscapeDataString(relationship.ObjectId)}",
        _ => "jockeys"
    };

    private static RenderFragment EntityLink(string segment, string? id, string? label) => builder =>
    {
        if (string.IsNullOrWhiteSpace(id)) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", $"{segment}/{Uri.EscapeDataString(id)}");
        builder.AddContent(3, string.IsNullOrWhiteSpace(label) ? id : label);
        builder.CloseElement();
    };


    private async Task UpdateProfileAsync()
    {
        updating = true;
        try
        {
            var result = await Api.UpdateJockeyProfileAsync(JockeyId, new UpdateJockeyProfileRequest(
                editDisplayName, editNormalizedName, editAffiliationCode));
            updateErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success) await LoadAsync();
        }
        finally
        {
            updating = false;
        }
    }

    private async Task MergeAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(aliasType) || string.IsNullOrWhiteSpace(aliasValue) || string.IsNullOrWhiteSpace(aliasSourceName))
        {
            aliasErrors = new[] { "種別・値・出典はすべて必須です。" };
            return;
        }

        mergingAlias = true;
        try
        {
            var result = await Api.MergeJockeyAliasAsync(JockeyId, new MergeAliasRequest(
                aliasType!, aliasValue!, aliasSourceName!, aliasIsPrimary));
            aliasErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success)
            {
                aliasType = null; aliasValue = null; aliasSourceName = null; aliasIsPrimary = false;
                await LoadAsync();
            }
        }
        finally
        {
            mergingAlias = false;
        }
    }

    private async Task CorrectAsync()
    {
        correcting = true;
        try
        {
            var result = await Api.CorrectJockeyDataAsync(JockeyId, new CorrectJockeyDataRequest(
                correctDisplayName, correctNormalizedName, correctAffiliationCode, correctReason));
            correctErrors = result.Success ? Array.Empty<string>() : result.Errors;
            correctArmed = false;
            if (result.Success)
            {
                correctDisplayName = null; correctNormalizedName = null; correctAffiliationCode = null; correctReason = null;
                await LoadAsync();
            }
        }
        finally
        {
            correcting = false;
        }
    }
}
