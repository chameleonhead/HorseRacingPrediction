@page "/trainers"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsPageHeader Section="データ" Title="調教師" Description="調教師名またはIDで検索します。" />

<FluentCard class="filter-card">
    <div class="filter-grid">
        <FluentTextField Label="キーワード" @bind-Value="query" Placeholder="調教師名 / ID" />
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">検索</FluentButton>
    </div>
</FluentCard>

@if (loading && result is null) { <UiState Kind="loading" Title="調教師を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する調教師はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading) { <p class="hint">検索中… 直前の結果を表示しています。</p> }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <div class="data-list" aria-label="調教師一覧">
        @foreach (var t in result.Items)
        {
            <article class="data-list-row selectable-row" tabindex="0" role="link" @onclick="() => OpenTrainer(t.TrainerId)" @onkeydown="e => OpenTrainerFromKey(e, t.TrainerId)">
                <div class="object-primary"><a href="@TrainerUrl(t.TrainerId)" @onclick:stopPropagation>@t.DisplayName</a><span class="hint">@t.TrainerId</span></div>
                <div><span class="object-label">所属</span>@(t.AffiliationCode ?? "—")</div>
                <div><span class="object-label">別名</span>@t.AliasCount 件</div>
            </article>
        }
    </div>
    <Pagination TotalCount="result.TotalCount" Page="page" PageSize="pageSize" PageChanged="GoAsync" />
}

@code {
    private string? query;
    private int page = 1;
    private const int pageSize = 50;
    private bool loading;
    private PagedResponse<TrainerSummaryResponse>? result;

    protected override async Task OnInitializedAsync()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        query = ParseText(q, "query");
        if (int.TryParse(ParseText(q, "page"), out var p) && p > 0) page = p;
        await LoadAsync();
    }

    private async Task SearchAsync() { page = 1; await LoadAsync(); }
    private async Task LoadAsync()
    {
        UpdateUrl();
        loading = true;
        try { result = await Api.SearchTrainersAsync(new SearchTrainersRequest { Query = query, Page = page, PageSize = pageSize }); }
        finally { loading = false; }
    }
    private async Task GoAsync(int value) { page = value; await LoadAsync(); }
    private void UpdateUrl() => NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/trainers", new Dictionary<string, string?> { ["query"] = query, ["page"] = page.ToString() }.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string? ParseText(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key) => q.TryGetValue(key, out var value) ? value.ToString() : null;
    private void OpenTrainer(string id) => Navigation.NavigateTo(TrainerUrl(id));
    private void OpenTrainerFromKey(KeyboardEventArgs e, string id) { if (e.Key is "Enter" or " ") OpenTrainer(id); }
    private static string TrainerUrl(string id) => $"/trainers/{Uri.EscapeDataString(id)}";
}
