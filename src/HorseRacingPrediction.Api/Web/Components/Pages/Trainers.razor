@page "/trainers"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>調教師検索</h1>
<div class="toolbar">
    <label>キーワード: <input @bind="query" placeholder="調教師名 / ID" /></label>
    <button class="btn primary" @onclick="LoadAsync">検索</button>
</div>

@if (loading && result is null) { <UiState Kind="loading" Title="調教師を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する調教師はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading)
    {
        <p class="hint">検索中… 直前の結果を表示しています。</p>
    }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <div class="object-list">
        @foreach (var t in result.Items)
        {
            <article class="object-row">
                <div class="object-primary"><a href="@($"trainers/{Uri.EscapeDataString(t.TrainerId)}")">@t.DisplayName</a><span class="hint">@t.TrainerId</span></div>
                <div><span class="object-label">所属</span>@(t.AffiliationCode ?? "—")</div>
                <div><span class="object-label">別名</span>@t.AliasCount 件</div>
            </article>
        }
    </div>
    <div class="toolbar">
        <button class="btn" disabled="@(page <= 1)" @onclick="() => GoAsync(page - 1)">前</button>
        <span>@(page) / @result.TotalPages</span>
        <button class="btn" disabled="@(page >= result.TotalPages)" @onclick="() => GoAsync(page + 1)">次</button>
    </div>
}

@code {
    private string? query;
    private int page = 1;
    private int pageSize = 50;
    private bool loading;
    private PagedResponse<TrainerSummaryResponse>? result;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            result = await Api.SearchTrainersAsync(new SearchTrainersRequest
            {
                Query = query,
                Page = page,
                PageSize = pageSize
            });
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GoAsync(int p) { page = p; await LoadAsync(); }
}
