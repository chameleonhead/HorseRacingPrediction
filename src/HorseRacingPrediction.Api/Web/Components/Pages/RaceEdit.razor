@page "/races/{RaceId}/edit"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Nav

<h1>レースの管理情報</h1>
<p class="hint"><a href="@($"/races/{Uri.EscapeDataString(RaceId)}")">← レース詳細へ戻る</a></p>

@if (loading)
{
    <UiState Kind="loading" Title="レースの管理情報を読み込んでいます" />
}
else if (race is null)
{
    <UiState Title="レースが見つかりません" Message="対象の RaceId を確認してください。" />
}
else
{
    <section class="detail-card">
        <h2>@(race.RaceName ?? race.RaceId)</h2>
        <dl class="meta">
            <dt>RaceId</dt><dd><code>@race.RaceId</code></dd>
            <dt>日付</dt><dd>@race.RaceDate</dd>
            <dt>競馬場 / R</dt><dd>@race.RacecourseCode / @race.RaceNumber</dd>
            <dt>状態</dt><dd>@race.Status</dd>
            <dt>距離 / 馬場</dt><dd>@FormatDistanceSurface(race.DistanceMeters, race.SurfaceCode, race.DirectionCode)</dd>
        </dl>
    </section>

    <section class="detail-card">
        <h3>データ補正</h3>
        <p class="hint">誤登録されたデータの補正用です。理由は任意です。</p>
        <div class="form-grid">
            <label>レース名<input @bind="correctRaceName" /></label>
            <label>競馬場コード<input @bind="correctRacecourseCode" /></label>
            <label>レース番号<input type="number" @bind="correctRaceNumber" /></label>
            <label>グレード<input @bind="correctGradeCode" /></label>
            <label>馬場<input @bind="correctSurfaceCode" /></label>
            <label>距離(m)<input type="number" @bind="correctDistanceMeters" /></label>
            <label>回り<input @bind="correctDirectionCode" /></label>
            <label>補正理由<input @bind="correctReason" /></label>
        </div>
        <div class="action-row">
            <button class="app-button primary small" @onclick="CorrectAsync" disabled="@correcting">補正を保存する</button>
            <button class="app-button small" @onclick="Back">キャンセル</button>
        </div>
        @if (correctErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in correctErrors) { <li>@e</li> }</ul>
        }
    </section>
}

@code {
    [Parameter] public string RaceId { get; set; } = string.Empty;

    private bool loading;
    private RaceResponse? race;

    private string? correctRaceName;
    private string? correctRacecourseCode;
    private int? correctRaceNumber;
    private string? correctGradeCode;
    private string? correctSurfaceCode;
    private int? correctDistanceMeters;
    private string? correctDirectionCode;
    private string? correctReason;
    private bool correcting;
    private IReadOnlyList<string> correctErrors = Array.Empty<string>();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            race = await Api.GetRaceAsync(RaceId);
            if (race is not null)
            {
                correctRaceName = race.RaceName;
                correctRacecourseCode = race.RacecourseCode;
                correctRaceNumber = race.RaceNumber;
                correctGradeCode = race.GradeCode;
                correctSurfaceCode = race.SurfaceCode;
                correctDistanceMeters = race.DistanceMeters;
                correctDirectionCode = race.DirectionCode;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void Back() => Nav.NavigateTo($"/races/{Uri.EscapeDataString(RaceId)}");

    private async Task CorrectAsync()
    {
        correcting = true;
        try
        {
            var result = await Api.CorrectRaceDataAsync(RaceId, new CorrectRaceDataRequest(
                correctRaceName, correctRacecourseCode, correctRaceNumber, correctGradeCode,
                correctSurfaceCode, correctDistanceMeters, correctDirectionCode, correctReason));
            correctErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success)
            {
                correctRaceName = null; correctRacecourseCode = null; correctRaceNumber = null;
                correctGradeCode = null; correctSurfaceCode = null; correctDistanceMeters = null;
                correctDirectionCode = null; correctReason = null;
                Back();
            }
        }
        finally
        {
            correcting = false;
        }
    }

    private static string FormatDistanceSurface(int? distanceMeters, string? surfaceCode, string? directionCode)
    {
        var distance = distanceMeters.HasValue ? $"{distanceMeters.Value}m" : "未設定";
        var surface = string.IsNullOrWhiteSpace(surfaceCode) ? "未設定" : surfaceCode;
        var direction = string.IsNullOrWhiteSpace(directionCode) ? string.Empty : $" {directionCode}";
        return $"{distance} / {surface}{direction}";
    }
}
