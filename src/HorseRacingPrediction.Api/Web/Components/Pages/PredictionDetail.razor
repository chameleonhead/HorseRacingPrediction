@page "/predictions/{PredictionTicketId}"
@attribute [Authorize]
@inject AdminApiClient Api

<RaceOpsObjectHeader BackHref="/predictions" BackLabel="← 予想票一覧に戻る" Title="@(prediction is null ? "予想票詳細" : $"{RaceDisplayName(prediction)} 予想票")" Section="レース・予想 / 予想票" />

@if (loading) { <UiState Kind="loading" Title="予想票を読み込んでいます" /> }
else if (prediction is null) { <UiState Title="予想票が見つかりません" Message="一覧へ戻り、対象を選び直してください。" /> }
else
{
    <div class="detail-stack">
    <section class="profile-facts" aria-label="予想票の概要">
        <div class="profile-fact"><small>状態</small><strong><RaceOpsStatusBadge Label="@TicketStatusLabel(prediction.TicketStatus)" Tone="@TicketStatusTone(prediction.TicketStatus)" /></strong></div>
        <div class="profile-fact"><small>本命</small><strong>@(PrimaryMark?.HorseName ?? "—")</strong></div>
        <div class="profile-fact"><small>信頼度</small><strong>@prediction.ConfidenceScore / 100</strong></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(prediction.RaceId))
    {
        <section class="entity-section detail-section" aria-labelledby="prediction-related-heading">
            <h2 id="prediction-related-heading">関連</h2>
            <RaceOpsObjectList Label="関連するレース">
                <RaceOpsObjectListItem Href="@RaceUrl(prediction.RaceId)" Title="@RaceDisplayName(prediction)" Description="@(prediction.RaceDate?.ToString("yyyy/MM/dd") ?? "開催日未設定")" Metadata="レース詳細" />
            </RaceOpsObjectList>
        </section>
    }

    @if (prediction.Marks.Count > 0)
    {
        <section class="detail-group" aria-label="印"><section class="detail-card detail-section">
            <h3>印</h3>
            <div class="mark-list">
                @foreach (var m in prediction.Marks)
                {
                    <article class="mark-row">
                        <div class="mark-primary"><span class="pill">@m.MarkCode</span><strong>@if (!string.IsNullOrWhiteSpace(m.HorseId)) { <a href="@HorseUrl(m.HorseId)">@(m.HorseName ?? "馬詳細")</a> } else { <text>@(m.HorseName ?? "出走馬未設定")</text> }</strong></div>
                        <div><span class="object-label">予想着順</span>@m.PredictedRank</div>
                        <div><span class="object-label">スコア</span>@m.Score</div>
                        <div class="mark-comment"><span class="object-label">コメント</span>@(string.IsNullOrWhiteSpace(m.Comment) ? "—" : m.Comment)</div>
                    </article>
                }
            </div>
        </section>
        </section>
    }

    </div>
}

@code {
    [Parameter] public string PredictionTicketId { get; set; } = string.Empty;

    private bool loading;
    private PredictionTicketResponse? prediction;
    private PredictionMarkResponse? PrimaryMark => prediction?.Marks.OrderBy(x => x.PredictedRank).FirstOrDefault();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            prediction = await Api.GetPredictionAsync(PredictionTicketId);
        }
        finally
        {
            loading = false;
        }
    }

    private static string RaceUrl(string id) => $"/races/{Uri.EscapeDataString(id)}";
    private static string HorseUrl(string id) => $"/horses/{Uri.EscapeDataString(id)}";
    private static string RaceDisplayName(PredictionTicketResponse value)
    {
        var display = string.Join(" ", new[] { value.RacecourseCode, value.RaceNumber is null ? null : $"{value.RaceNumber}R", value.RaceName }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(display) ? "対象レース" : display;
    }
    private static string TicketStatusLabel(TicketStatus value) => value switch { TicketStatus.Draft => "作成中", TicketStatus.Finalized => "確定", TicketStatus.Withdrawn => "取下げ", TicketStatus.LateSubmitted => "締切後", _ => value.ToString() };
    private static string TicketStatusTone(TicketStatus value) => value == TicketStatus.Finalized ? "success" : value == TicketStatus.Withdrawn ? "neutral" : "info";

}
