@page "/predictions/{PredictionTicketId}"
@attribute [Authorize]
@inject AdminApiClient Api

<RaceOpsObjectHeader BackHref="/predictions" BackLabel="← 予想票一覧に戻る" Title="@(prediction?.SummaryComment ?? "予想票詳細")" Section="予想票" />

@if (loading) { <p>読み込み中…</p> }
else if (prediction is null) { <p>PredictionTicketId「@PredictionTicketId」の予想票は見つかりませんでした。</p> }
else
{
    <section class="detail-card">
        <h2>予想票の概要</h2>
        <dl class="meta">
            <dt>RaceId</dt><dd><a href="@($"/races/{Uri.EscapeDataString(prediction.RaceId ?? string.Empty)}")">@prediction.RaceId</a></dd>
            <dt>予想者</dt><dd>@prediction.PredictorType / @prediction.PredictorId</dd>
            <dt>信頼度</dt><dd>@prediction.ConfidenceScore</dd>
            <dt>コメント</dt><dd>@prediction.SummaryComment</dd>
            <dt>予想日時</dt><dd>@prediction.PredictedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </section>

    @if (prediction.Marks.Count > 0)
    {
        <section class="detail-card">
            <h3>印</h3>
            <div class="mark-list">
                @foreach (var m in prediction.Marks)
                {
                    <article class="mark-row">
                        <div class="mark-primary"><span class="pill">@m.MarkCode</span><strong>@m.EntryId</strong></div>
                        <div><span class="object-label">予想着順</span>@m.PredictedRank</div>
                        <div><span class="object-label">スコア</span>@m.Score</div>
                        <div class="mark-comment"><span class="object-label">コメント</span>@(string.IsNullOrWhiteSpace(m.Comment) ? "—" : m.Comment)</div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="detail-card">
        <h3>予想票の操作</h3>
        <p class="hint">予想票の編集・取り下げ操作は、予想業務の扱いを再整理するまで画面には表示しません。</p>
    </section>
}

@code {
    [Parameter] public string PredictionTicketId { get; set; } = string.Empty;

    private bool loading;
    private PredictionTicketResponse? prediction;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            prediction = await Api.GetPredictionAsync(PredictionTicketId);
        }
        finally
        {
            loading = false;
        }
    }

}
