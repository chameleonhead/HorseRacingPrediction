@page "/predictions"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>予想票検索</h1>
<div class="toolbar">
    <label>RaceId: <input @bind="raceId" /></label>
    <label>予想者種別: <input @bind="predictorType" /></label>
    <button class="btn primary" @onclick="LoadAsync">検索</button>
</div>

@if (loading) { <p>読み込み中…</p> }
else if (result is null || result.Items.Count == 0) { <p>該当する予想票はありません。</p> }
else
{
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <table class="data">
        <thead>
            <tr>
                <th>RaceId</th>
                <th>予想者</th>
                <th>状態</th>
                <th>評価</th>
                <th>信頼度</th>
                <th>予想日時</th>
                <th>印数</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in result.Items)
            {
                <tr>
                    <td>@p.RaceId</td>
                    <td>@p.PredictorType / @p.PredictorId</td>
                    <td><a href="@($"predictions/{Uri.EscapeDataString(p.PredictionTicketId)}")">@p.TicketStatus</a></td>
                    <td>@p.EvaluationStatus</td>
                    <td>@p.ConfidenceScore</td>
                    <td>@p.PredictedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@p.MarkCount</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="toolbar">
        <button class="btn" disabled="@(page <= 1)" @onclick="() => GoAsync(page - 1)">前</button>
        <span>@(page) / @result.TotalPages</span>
        <button class="btn" disabled="@(page >= result.TotalPages)" @onclick="() => GoAsync(page + 1)">次</button>
    </div>
}

@code {
    private string? raceId;
    private string? predictorType;
    private int page = 1;
    private int pageSize = 50;
    private bool loading;
    private PagedResponse<PredictionTicketSummaryResponse>? result;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            result = await Api.SearchPredictionsAsync(new SearchPredictionTicketsRequest
            {
                RaceId = raceId,
                PredictorType = predictorType,
                Page = page,
                PageSize = pageSize
            });
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GoAsync(int p) { page = p; await LoadAsync(); }
}
