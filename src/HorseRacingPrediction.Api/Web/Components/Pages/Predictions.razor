@page "/predictions"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsPageHeader Section="レース・予想" Title="予想票" Description="レースごとの予想と評価状態を確認します。" />

<FluentCard class="filter-card">
    <div class="filter-toolbar">
        <div class="filter-field filter-field-primary"><FluentTextField aria-label="レース名・開催日を検索" Placeholder="レース名・開催日を検索" @bind-Value="query" /></div>
        <div class="filter-field filter-field-compact"><FluentTextField aria-label="予想者種別" Placeholder="予想者種別" @bind-Value="predictorType" /></div>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">検索</FluentButton>
    </div>
    <RaceOpsFilterSummary Chips="@BuildFilterChips()" OnClearAll="@ClearFiltersAsync" />
</FluentCard>

@if (loading && result is null) { <UiState Kind="loading" Title="予想票を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する予想票はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading) { <p class="hint">検索中… 直前の結果を表示しています。</p> }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <RaceOpsObjectList Label="予想票一覧">
        @foreach (var p in result.Items)
        {
            <RaceOpsObjectListItem Href="@PredictionUrl(p.PredictionTicketId)"
                                    Title="@RaceDisplayName(p)"
                                    Description="@($"{(p.RaceDate?.ToString("yyyy/MM/dd") ?? "開催日未設定")} · 本命 {p.PrimaryHorseName ?? "—"}")"
                                    Status="@TicketStatusLabel(p.TicketStatus)"
                                    StatusTone="@TicketStatusTone(p.TicketStatus)"
                                    Metadata="@($"{EvaluationStatusLabel(p.EvaluationStatus)} ・ 信頼度 {p.ConfidenceScore} ・ 印 {p.MarkCount} 件")" />
        }
    </RaceOpsObjectList>
    <Pagination TotalCount="result.TotalCount" Page="page" PageSize="pageSize" PageChanged="GoAsync" />
}

@code {
    private string? query;
    private string? predictorType;
    private int page = 1;
    private const int pageSize = 50;
    private bool loading;
    private PagedResponse<PredictionTicketSummaryResponse>? result;

    protected override async Task OnInitializedAsync()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        query = ParseText(q, "query") ?? ParseText(q, "raceId");
        predictorType = ParseText(q, "predictorType");
        if (int.TryParse(ParseText(q, "page"), out var p) && p > 0) page = p;
        await LoadAsync();
    }

    private async Task SearchAsync() { page = 1; await LoadAsync(); }
    private async Task LoadAsync()
    {
        UpdateUrl();
        loading = true;
        try { result = await Api.SearchPredictionsAsync(new SearchPredictionTicketsRequest { Query = query, PredictorType = predictorType, Page = page, PageSize = pageSize }); }
        finally { loading = false; }
    }
    private async Task GoAsync(int value) { page = value; await LoadAsync(); }
    private void UpdateUrl() => NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/predictions", new Dictionary<string, string?> { ["query"] = query, ["predictorType"] = predictorType, ["page"] = page.ToString() }.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string? ParseText(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key) => q.TryGetValue(key, out var value) ? value.ToString() : null;
    private static string PredictionUrl(string id) => $"/predictions/{Uri.EscapeDataString(id)}";
    private static string RaceDisplayName(PredictionTicketSummaryResponse value) => string.Join(" ", new[] { value.RacecourseCode, value.RaceNumber is null ? null : $"{value.RaceNumber}R", value.RaceName }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string TicketStatusLabel(TicketStatus value) => value switch { TicketStatus.Draft => "作成中", TicketStatus.Finalized => "確定", TicketStatus.Withdrawn => "取下げ", _ => value.ToString() };
    private static string TicketStatusTone(TicketStatus value) => value == TicketStatus.Finalized ? "success" : value == TicketStatus.Withdrawn ? "neutral" : "info";
    private static string EvaluationStatusLabel(EvaluationStatus value) => value switch { EvaluationStatus.Ready => "評価済み", EvaluationStatus.RecalculationRequired => "再評価待ち", EvaluationStatus.Failed => "評価失敗", _ => value.ToString() };
    private async Task ClearFiltersAsync() { query = null; predictorType = null; page = 1; await LoadAsync(); }
    private List<RaceOpsFilterChip> BuildFilterChips()
    {
        var chips = new List<RaceOpsFilterChip>();
        if (!string.IsNullOrWhiteSpace(query))
        {
            chips.Add(new($"レース名・開催日 {query}", async () => { query = null; page = 1; await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(predictorType))
        {
            chips.Add(new($"予想者種別 {predictorType}", async () => { predictorType = null; page = 1; await LoadAsync(); }));
        }
        return chips;
    }
}
