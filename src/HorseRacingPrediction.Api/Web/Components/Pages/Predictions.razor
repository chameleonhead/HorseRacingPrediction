@page "/predictions"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsPageHeader Section="レース・予想" Title="予想票" Description="レースごとの予想と評価状態を確認します。" />

<FluentCard class="filter-card">
    <div class="filter-toolbar">
        <div class="filter-field filter-field-primary"><FluentTextField aria-label="レース名・開催日を検索" Placeholder="レース名・開催日を検索" @bind-Value="raceId" /></div>
        <div class="filter-field filter-field-compact"><FluentTextField aria-label="予想者種別" Placeholder="予想者種別" @bind-Value="predictorType" /></div>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">検索</FluentButton>
    </div>
</FluentCard>

@if (loading && result is null) { <UiState Kind="loading" Title="予想票を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する予想票はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading) { <p class="hint">検索中… 直前の結果を表示しています。</p> }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <RaceOpsObjectList Label="予想票一覧">
        @foreach (var p in result.Items)
        {
            <article class="object-list-item prediction-row selectable-row" tabindex="0" role="link" @onclick="() => OpenPrediction(p.PredictionTicketId)" @onkeydown="e => OpenPredictionFromKey(e, p.PredictionTicketId)">
                <span class="object-list-main">
                    <strong>@p.TicketStatus</strong>
                    <span class="hint">@RaceLink(p.RaceId) · @($"{p.PredictorType} / {p.PredictorId}")</span>
                </span>
                <span class="badge info">@p.EvaluationStatus</span>
                <span class="object-list-meta">信頼度 @p.ConfidenceScore ・ 予想日時 @(p.PredictedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—") ・ 印 @p.MarkCount 件</span>
                <span class="object-list-affordance">詳細</span>
            </article>
        }
    </RaceOpsObjectList>
    <Pagination TotalCount="result.TotalCount" Page="page" PageSize="pageSize" PageChanged="GoAsync" />
}

@code {
    private string? raceId;
    private string? predictorType;
    private int page = 1;
    private const int pageSize = 50;
    private bool loading;
    private PagedResponse<PredictionTicketSummaryResponse>? result;

    protected override async Task OnInitializedAsync()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        raceId = ParseText(q, "raceId");
        predictorType = ParseText(q, "predictorType");
        if (int.TryParse(ParseText(q, "page"), out var p) && p > 0) page = p;
        await LoadAsync();
    }

    private async Task SearchAsync() { page = 1; await LoadAsync(); }
    private async Task LoadAsync()
    {
        UpdateUrl();
        loading = true;
        try { result = await Api.SearchPredictionsAsync(new SearchPredictionTicketsRequest { RaceId = raceId, PredictorType = predictorType, Page = page, PageSize = pageSize }); }
        finally { loading = false; }
    }
    private async Task GoAsync(int value) { page = value; await LoadAsync(); }
    private void UpdateUrl() => NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/predictions", new Dictionary<string, string?> { ["raceId"] = raceId, ["predictorType"] = predictorType, ["page"] = page.ToString() }.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string? ParseText(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key) => q.TryGetValue(key, out var value) ? value.ToString() : null;
    private void OpenPrediction(string id) => Navigation.NavigateTo(PredictionUrl(id));
    private void OpenPredictionFromKey(KeyboardEventArgs e, string id) { if (e.Key is "Enter" or " ") OpenPrediction(id); }
    private static string PredictionUrl(string id) => $"/predictions/{Uri.EscapeDataString(id)}";
    private static string RaceUrl(string id) => $"/races/{Uri.EscapeDataString(id)}";
    private static RenderFragment RaceLink(string? id) => builder =>
    {
        if (string.IsNullOrWhiteSpace(id)) { builder.AddContent(0, "Race: 未設定"); return; }
        var raceIdValue = id;
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", RaceUrl(raceIdValue));
        builder.AddEventStopPropagationAttribute(3, "onclick", true);
        builder.AddContent(4, $"Race: {id}");
        builder.CloseElement();
    };
}
