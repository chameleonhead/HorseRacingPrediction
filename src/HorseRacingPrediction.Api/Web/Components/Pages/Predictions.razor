@page "/predictions"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>予想票検索</h1>
<div class="toolbar">
    <label>RaceId: <input @bind="raceId" /></label>
    <label>予想者種別: <input @bind="predictorType" /></label>
    <button class="btn primary" @onclick="LoadAsync">検索</button>
</div>

@if (loading) { <UiState Kind="loading" Title="予想票を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する予想票はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <div class="object-list">
        @foreach (var p in result.Items)
        {
            <article class="object-row prediction-row">
                <div class="object-primary"><a href="@($"predictions/{Uri.EscapeDataString(p.PredictionTicketId)}")">@p.TicketStatus</a><span class="hint">Race: @p.RaceId</span></div>
                <div><span class="object-label">予想者</span>@p.PredictorType / @p.PredictorId</div>
                <div><span class="object-label">評価</span>@p.EvaluationStatus</div>
                <div><span class="object-label">信頼度</span>@p.ConfidenceScore</div>
                <div><span class="object-label">予想日時</span>@(p.PredictedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</div>
                <div><span class="object-label">印</span>@p.MarkCount 件</div>
            </article>
        }
    </div>
    <div class="toolbar">
        <button class="btn" disabled="@(page <= 1)" @onclick="() => GoAsync(page - 1)">前</button>
        <span>@(page) / @result.TotalPages</span>
        <button class="btn" disabled="@(page >= result.TotalPages)" @onclick="() => GoAsync(page + 1)">次</button>
    </div>
}

@code {
    private string? raceId;
    private string? predictorType;
    private int page = 1;
    private int pageSize = 50;
    private bool loading;
    private PagedResponse<PredictionTicketSummaryResponse>? result;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            result = await Api.SearchPredictionsAsync(new SearchPredictionTicketsRequest
            {
                RaceId = raceId,
                PredictorType = predictorType,
                Page = page,
                PageSize = pageSize
            });
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GoAsync(int p) { page = p; await LoadAsync(); }
}
