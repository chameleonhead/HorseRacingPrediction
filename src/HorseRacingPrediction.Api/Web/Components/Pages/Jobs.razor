@page "/jobs"
@attribute [Authorize]
@inject AdminApiClient Api

<RaceOpsPageHeader Section="運用" Title="収集管理" Description="Resourceを中心に、収集状態、Task、失敗、Backfillを管理します。">
 <Actions><FluentButton OnClick="LoadAsync" Disabled="busy">更新</FluentButton>@if(pipeline?.IsPaused==true){<FluentButton Appearance="@Appearance.Accent" OnClick="ResumeAsync" Disabled="busy">再開</FluentButton>}else{<FluentButton OnClick="PauseAsync" Disabled="@(busy||pipeline is null)">一時停止</FluentButton>}</Actions>
</RaceOpsPageHeader>
@if(pipeline?.IsPaused==true){<FluentMessageBar Intent="@MessageIntent.Warning" Title="収集パイプラインは一時停止中です">@(pipeline.Reason??"管理者により停止されています。")</FluentMessageBar>}
@if(errors.Count>0){<UiState Kind="error" Title="操作を完了できませんでした" Message="@string.Join(" ",errors)"/>}
@if(progress is not null){<section class="entity-section" aria-label="収集状態サマリー"><div class="detail-facts"><div><span class="object-label">Resources</span>@progress.ResourcesByType.Values.Sum()</div><div><span class="object-label">Active Tasks</span>@progress.ActiveTasksByLane.Values.Sum()</div><div><span class="object-label">Retry待ち</span>@progress.RetryWaiting</div><div><span class="object-label">Failed</span>@Count(CollectionStateStatus.Failed)</div></div></section>}
<nav class="view-tabs" aria-label="収集管理の表示">@foreach(var t in tabs){<button type="button" class="@(tab==t.Key?"active":null)" aria-current="@(tab==t.Key?"page":null)" @onclick="()=>tab=t.Key">@t.Value</button>}</nav>
@if(loading){<UiState Kind="loading" Title="収集管理情報を読み込んでいます"/>}
else if(tab=="resources"){
 <section class="filter-bar" aria-label="Resourceの絞り込み"><div class="filter-toolbar"><FluentTextField aria-label="Resource検索" Placeholder="ID、Provider、Definition" @bind-Value="query"/><FluentButton Appearance="@Appearance.Accent" OnClick="@(()=>filter=query.Trim())">絞り込む</FluentButton><FluentButton OnClick="OpenBulk">一括再取得</FluentButton></div></section>
 @if(Resources.Count==0){<UiState Title="Resourceはありません"/>}else{<FluentDataGrid Items="@Resources.AsQueryable()" TGridItem="CollectionTaskSummary" GridTemplateColumns="1fr 1.5fr 1.2fr .8fr" aria-label="Resource一覧"><PropertyColumn Property="@(x=>x.Resource.Type)" Title="Type" Sortable="true"/><TemplateColumn Title="Resource"><FluentButton Appearance="@Appearance.Stealth" OnClick="@(()=>SelectAsync(context))">@context.Resource.Provider / @context.Resource.Id</FluentButton></TemplateColumn><PropertyColumn Property="@(x=>x.Definition.Value)" Title="Definition"/><PropertyColumn Property="@(x=>x.Status)" Title="Task状態"/></FluentDataGrid>}
 @if(selected is not null){<FluentCard class="detail-card detail-section"><h2>@selected.Resource.Type / @selected.Resource.Id</h2>@if(detailLoading){<UiState Kind="loading" Title="Resource詳細を読み込んでいます"/>}else if(detail is null){<UiState Kind="error" Title="Resource詳細を取得できませんでした"/>}else if(state is null){<UiState Title="CollectionStateは未登録です"/>}else{<div class="detail-facts"><div><span class="object-label">状態</span>@state.Status</div><div><span class="object-label">Revision</span>@state.AppliedRevision / @state.RequiredRevision</div><div><span class="object-label">最終取得</span>@Time(state.LastCollectedAt)</div><div><span class="object-label">次回取得</span>@Time(state.NextCollectionAt)</div></div>}<h3>手動再取得</h3><FluentTextField Label="Explicit URL（任意）" @bind-Value="explicitUrl"/><FluentButton Appearance="@Appearance.Accent" OnClick="RequestAsync" Disabled="busy">このResourceを再取得</FluentButton>@if(detail is not null){<h3>Locations</h3>@if(detail.Locations.Count==0){<UiState Title="Locationはありません"/>}else{<FluentDataGrid Items="@detail.Locations.AsQueryable()" TGridItem="ResourceLocationCandidate" aria-label="ResourceLocation一覧"><PropertyColumn Property="@(x=>x.Url)" Title="URL"/><PropertyColumn Property="@(x=>x.Source)" Title="Source"/><PropertyColumn Property="@(x=>x.Status)" Title="状態"/><PropertyColumn Property="@(x=>x.LastVerifiedAt)" Title="最終確認"/></FluentDataGrid>}<h3>Requests / Tasks / Attempts</h3><p>@detail.Requests.Count requests ・ @detail.Tasks.Count tasks ・ @detail.Attempts.Count attempts</p>@if(detail.Attempts.Count==0){<UiState Title="Attemptはありません"/>}else{<FluentDataGrid Items="@detail.Attempts.AsQueryable()" TGridItem="CollectionAttemptSummary" aria-label="CollectionAttempt一覧"><PropertyColumn Property="@(x=>x.AttemptNumber)" Title="Attempt"/><PropertyColumn Property="@(x=>x.Result)" Title="結果"/><PropertyColumn Property="@(x=>x.StartedAt)" Title="開始"/><TemplateColumn Title="エラー">@(context.ErrorCode??"—") @context.ErrorMessage</TemplateColumn></FluentDataGrid>}}</FluentCard>}
}else if(tab=="tasks"){
 @if(tasks.Count==0){<UiState Title="Taskはありません"/>}else{<FluentDataGrid Items="@tasks.AsQueryable()" TGridItem="CollectionTaskSummary" GridTemplateColumns="1fr 1.5fr 1fr .8fr .8fr" aria-label="CollectionTask一覧"><PropertyColumn Property="@(x=>x.TaskId)" Title="Task"/><TemplateColumn Title="Resource">@context.Resource.Type / @context.Resource.Id</TemplateColumn><PropertyColumn Property="@(x=>x.Status)" Title="状態" Sortable="true"/><PropertyColumn Property="@(x=>x.Lane)" Title="Lane"/><PropertyColumn Property="@(x=>x.Priority)" Title="Priority"/></FluentDataGrid>}
}else if(tab=="batches"){
 @if(batches.Count==0){<UiState Title="Backfill Batchはありません"/>}else{<FluentDataGrid Items="@batches.AsQueryable()" TGridItem="BackfillBatchSnapshot" GridTemplateColumns="1.4fr 1fr .7fr .7fr .7fr .7fr" aria-label="Backfill Batch一覧"><PropertyColumn Property="@(x=>x.BatchId)" Title="Batch"/><TemplateColumn Title="期間">@context.From ～ @context.To</TemplateColumn><PropertyColumn Property="@(x=>x.Pending)" Title="Pending"/><PropertyColumn Property="@(x=>x.Running)" Title="Running"/><PropertyColumn Property="@(x=>x.Succeeded)" Title="Success"/><PropertyColumn Property="@(x=>x.Failed)" Title="Failed"/></FluentDataGrid>}
}else{
 @if(failures.Count==0){<UiState Title="未対応の失敗はありません"/>}else{<FluentDataGrid Items="@failures.AsQueryable()" TGridItem="PendingCollectionFailureNotification" GridTemplateColumns="1.5fr 1fr .8fr 2fr" aria-label="収集失敗一覧"><TemplateColumn Title="Resource">@context.Resource.Type / @context.Resource.Id</TemplateColumn><PropertyColumn Property="@(x=>x.Definition.Value)" Title="Definition"/><PropertyColumn Property="@(x=>x.Status)" Title="状態"/><TemplateColumn Title="エラー">@(context.ErrorCode??"—") @context.ErrorMessage</TemplateColumn></FluentDataGrid>}
}
<FluentDialog Hidden="@(!showBulk)" HiddenChanged="@(h=>showBulk=!h)" Modal="true" TrapFocus="true" AriaLabelledby="bulk-title" Style="width:min(680px,calc(100vw - 32px));"><FluentDialogHeader ShowDismiss="true"><h2 id="bulk-title">Resourceを一括再取得</h2></FluentDialogHeader><FluentDialogBody><p>プレビューと同じ対象集合だけを実行します。</p><FluentTextField Label="Resource Type" @bind-Value="bulkType"/><FluentTextField Label="Provider" @bind-Value="provider"/><FluentTextField Label="Definition" @bind-Value="definition"/><FluentTextField Label="Revision" @bind-Value="revision"/><FluentTextField Label="Resource IDs（カンマ区切り）" @bind-Value="ids"/>@if(preview is not null){<FluentMessageBar Intent="@MessageIntent.Info" Title="@($"プレビュー: {preview.TargetCount} 件")"/>}@if(bulkErrors.Count>0){<UiState Kind="error" Title="一括操作を実行できません" Message="@string.Join(" ",bulkErrors)"/>}</FluentDialogBody><FluentDialogFooter><FluentButton OnClick="@(()=>showBulk=false)">閉じる</FluentButton><FluentButton OnClick="PreviewAsync" Disabled="busy">プレビュー</FluentButton><FluentButton Appearance="@Appearance.Accent" OnClick="ExecuteAsync" Disabled="@(busy||preview is null)">実行</FluentButton></FluentDialogFooter></FluentDialog>

@code{
 private readonly Dictionary<string,string> tabs=new(){{"resources","Resources / States"},{"tasks","Tasks"},{"batches","Batches"},{"failures","Failures"}}; private string tab="resources",query="",filter="",bulkType="Horse",provider="JRA",definition="horse-profile",revision="1",ids=""; private string? explicitUrl; private bool loading=true,busy,detailLoading,showBulk; private IReadOnlyList<string> errors=[],bulkErrors=[]; private IReadOnlyList<CollectionTaskSummary> tasks=[]; private IReadOnlyList<BackfillBatchSnapshot> batches=[]; private IReadOnlyList<PendingCollectionFailureNotification> failures=[]; private CollectionProgressSnapshot? progress; private HorseRacingPrediction.CollectionOperations.CollectionPlatform.CollectionPipelineState? pipeline; private CollectionTaskSummary? selected; private CollectionStateSnapshot? state; private CollectionResourceDetail? detail; private CollectionBulkPreview? preview;
 private IReadOnlyList<CollectionTaskSummary> Resources=>tasks.Where(x=>string.IsNullOrWhiteSpace(filter)||$"{x.Resource.Type} {x.Resource.Provider} {x.Resource.Id} {x.Definition.Value}".Contains(filter,StringComparison.OrdinalIgnoreCase)).GroupBy(x=>new{x.Resource,x.Definition}).Select(g=>g.OrderByDescending(x=>x.AvailableAt).First()).ToList();
 protected override Task OnInitializedAsync()=>LoadAsync();
 private async Task LoadAsync(){loading=true;errors=[];try{var a=Api.GetCollectionProgressAsync();var b=Api.GetCollectionPipelineAsync();var c=Api.GetCollectionTasksAsync(limit:500);var d=Api.GetCollectionFailureNotificationsAsync();var e=Api.GetBackfillBatchesAsync();await Task.WhenAll(a,b,c,d,e);progress=await a;pipeline=await b;tasks=await c??[];failures=await d??[];batches=await e??[];}catch(Exception ex)when(ex is HttpRequestException or TaskCanceledException){errors=["APIへの接続を確認してください。"];}finally{loading=false;}}
 private int Count(CollectionStateStatus s)=>progress?.StatesByStatus.TryGetValue(s,out var n)==true?n:0;
 private async Task SelectAsync(CollectionTaskSummary x){selected=x;state=null;detail=null;detailLoading=true;try{detail=await Api.GetCollectionResourceDetailAsync(x.Resource,x.Definition);state=detail?.State;}finally{detailLoading=false;}}
 private async Task RequestAsync(){if(selected is null)return;busy=true;try{var r=await Api.RequestCollectionAsync(new(selected.Resource.Type,selected.Resource.Provider,selected.Resource.Id,selected.Definition.Value,Math.Max(selected.RequestedRevision,state?.RequiredRevision??0),CollectionReason.ManualRefresh,selected.Lane,selected.Priority,string.IsNullOrWhiteSpace(explicitUrl)?null:explicitUrl));if(!r.Success)errors=r.Errors;else await LoadAsync();}finally{busy=false;}}
 private Task PauseAsync()=>PipelineAsync(true);private Task ResumeAsync()=>PipelineAsync(false);private async Task PipelineAsync(bool pause){busy=true;try{var r=pause?await Api.PauseCollectionPipelineAsync("管理画面から一時停止"):await Api.ResumeCollectionPipelineAsync();if(!r.Success)errors=r.Errors;else await LoadAsync();}finally{busy=false;}}
 private void OpenBulk(){showBulk=true;preview=null;bulkErrors=[];}
 private BulkCollectionOperationRequest? Bulk(IReadOnlyList<ResourceKey>? expected=null){if(!Enum.TryParse<ResourceType>(bulkType,true,out var t)||!int.TryParse(revision,out var rev)||rev<1){bulkErrors=["TypeとRevisionを確認してください。"];return null;}var keys=ids.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Distinct().Select(id=>new ResourceKey(t,provider.Trim(),id)).ToArray();if(keys.Length==0){bulkErrors=["Resource IDを入力してください。"];return null;}return new(definition.Trim(),rev,CollectionReason.ManualRefresh,BulkCollectionSelection.SpecificResources,provider.Trim(),keys,ExpectedResources:expected);}
 private async Task PreviewAsync(){preview=null;bulkErrors=[];var q=Bulk();if(q is null)return;busy=true;try{var r=await Api.PreviewBulkCollectionAsync(q);if(r.Success)preview=r.Value;else bulkErrors=r.Errors;}finally{busy=false;}}
 private async Task ExecuteAsync(){if(preview is null)return;var q=Bulk(preview.Resources);if(q is null)return;busy=true;try{var r=await Api.ExecuteBulkCollectionAsync(q);if(r.Success){showBulk=false;await LoadAsync();}else bulkErrors=r.Errors;}finally{busy=false;}}
 private static string Time(DateTimeOffset? x)=>x?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")??"—";
}
