@page "/jobs"
@attribute [Authorize]
@inject AdminApiClient Api

<RaceOpsPageHeader Section="運用" Title="収集管理" Description="レースや競走馬などの収集状況を確認し、再取得や収集処理の停止・再開を行います。">
 <Actions><FluentButton OnClick="LoadAsync" Disabled="busy">最新の状態に更新</FluentButton>@if(pipeline?.IsPaused==true){<FluentButton Appearance="@Appearance.Accent" OnClick="ResumeAsync" Disabled="busy">収集を再開</FluentButton>}else{<FluentButton OnClick="PauseAsync" Disabled="@(busy||pipeline is null)">収集を一時停止</FluentButton>}</Actions>
</RaceOpsPageHeader>
@if(pipeline?.IsPaused==true){<FluentMessageBar Intent="@MessageIntent.Warning" Title="収集処理を一時停止しています">@(pipeline.Reason??"管理者が収集処理を停止しました。")</FluentMessageBar>}
@if(errors.Count>0){<UiState Kind="error" Title="操作を完了できませんでした" Message="@string.Join(" ",errors)"/>}
@if(progress is not null){<section class="entity-section" aria-label="収集状況の概要"><div class="detail-facts"><div><span class="object-label">収集対象</span>@progress.ResourcesByType.Values.Sum() 件</div><div><span class="object-label">収集済み</span>@Count(CollectionStateStatus.Current) 件</div><div><span class="object-label">処理待ち</span>@Count(CollectionStateStatus.Pending) 件</div><div><span class="object-label">収集中</span>@Count(CollectionStateStatus.Collecting) 件</div><div><span class="object-label">更新待ち</span>@Count(CollectionStateStatus.RefreshDue) 件</div><div><span class="object-label">要再取得</span>@Count(CollectionStateStatus.Stale) 件</div><div><span class="object-label">失敗</span>@Count(CollectionStateStatus.Failed) 件</div><div><span class="object-label">取得不可</span>@Count(CollectionStateStatus.Unavailable) 件</div><div><span class="object-label">再試行待ち</span>@progress.RetryWaiting 件</div></div></section>}
<nav class="view-tabs" aria-label="収集管理の表示切り替え">@foreach(var t in tabs){<button type="button" class="@(tab==t.Key?"active":null)" aria-current="@(tab==t.Key?"page":null)" @onclick="()=>tab=t.Key">@t.Value</button>}</nav>
@if(loading){<UiState Kind="loading" Title="収集状況を読み込んでいます"/>}
else if(tab=="resources"){
 <section class="filter-bar" aria-label="収集対象の絞り込み"><div class="filter-toolbar"><FluentTextField aria-label="収集対象を検索" Placeholder="対象ID、提供元、収集内容で検索" @bind-Value="query"/><FluentButton Appearance="@Appearance.Accent" OnClick="ApplyFilter">検索</FluentButton>@if(!string.IsNullOrWhiteSpace(filter)){<FluentButton OnClick="ClearFilter">検索条件をクリア</FluentButton>}<FluentButton OnClick="OpenBulk">まとめて再取得</FluentButton></div></section>
 @if(Resources.Count==0){<UiState Title="@(string.IsNullOrWhiteSpace(filter)?"収集対象はまだ登録されていません":"検索条件に一致する収集対象はありません")" Message="@(string.IsNullOrWhiteSpace(filter)?"収集処理を開始すると、発見した対象がここに表示されます。":"対象ID、提供元、収集内容を変えて検索してください。")"/>}else{<p>@Resources.Count 件を表示しています。</p><FluentDataGrid Items="@Resources.AsQueryable()" TGridItem="CollectionTaskSummary" GridTemplateColumns="1fr 1.5fr 1.2fr .8fr" aria-label="収集対象一覧"><TemplateColumn Title="対象種別">@ResourceTypeLabel(context.Resource.Type)</TemplateColumn><TemplateColumn Title="提供元 / 対象ID"><FluentButton Appearance="@Appearance.Stealth" OnClick="@(()=>SelectAsync(context))">@context.Resource.Provider / @context.Resource.Id</FluentButton></TemplateColumn><TemplateColumn Title="収集内容">@DefinitionLabel(context.Definition)</TemplateColumn><TemplateColumn Title="直近の処理">@TaskStatusLabel(context.Status)</TemplateColumn></FluentDataGrid>}
 @if(selected is not null){<FluentCard class="detail-card detail-section"><h2>@ResourceTypeLabel(selected.Resource.Type) / @selected.Resource.Id</h2><p>@DefinitionLabel(selected.Definition)（@selected.Definition.Value）</p>@if(detailLoading){<UiState Kind="loading" Title="収集対象の詳細を読み込んでいます"/>}else if(detail is null){<UiState Kind="error" Title="収集対象の詳細を取得できませんでした"/>}else if(state is null){<UiState Title="収集状態はまだ登録されていません"/>}else{<div class="detail-facts"><div><span class="object-label">収集状態</span>@StateStatusLabel(state.Status)</div><div><span class="object-label">抽出仕様</span>適用 @state.AppliedRevision / 必要 @state.RequiredRevision</div><div><span class="object-label">最終取得</span>@Time(state.LastCollectedAt)</div><div><span class="object-label">次回取得予定</span>@Time(state.NextCollectionAt)</div></div>}<h3>この対象を再取得</h3><p>通常はURLを空欄のまま実行してください。調査時に取得先を指定する場合だけ入力します。</p><FluentTextField Label="取得先URL（任意）" Placeholder="https://..." @bind-Value="explicitUrl"/><FluentButton Appearance="@Appearance.Accent" OnClick="RequestAsync" Disabled="busy">再取得を依頼</FluentButton>@if(detail is not null){<h3>取得先候補</h3>@if(detail.Locations.Count==0){<UiState Title="保存済みの取得先候補はありません" Message="実行時にURLの生成または探索を行います。"/>}else{<FluentDataGrid Items="@detail.Locations.AsQueryable()" TGridItem="ResourceLocationCandidate" aria-label="取得先候補一覧"><PropertyColumn Property="@(x=>x.Url)" Title="URL"/><TemplateColumn Title="見つけた方法">@LocationSourceLabel(context.Source)</TemplateColumn><TemplateColumn Title="利用状態">@LocationStatusLabel(context.Status)</TemplateColumn><TemplateColumn Title="最終確認">@Time(context.LastVerifiedAt)</TemplateColumn></FluentDataGrid>}<h3>収集履歴</h3><p>依頼 @detail.Requests.Count 件 ・ 処理 @detail.Tasks.Count 件 ・ 試行 @detail.Attempts.Count 件</p>@if(detail.Attempts.Count==0){<UiState Title="実行履歴はまだありません"/>}else{<FluentDataGrid Items="@detail.Attempts.AsQueryable()" TGridItem="CollectionAttemptSummary" aria-label="収集の試行履歴"><PropertyColumn Property="@(x=>x.AttemptNumber)" Title="試行回数"/><TemplateColumn Title="結果">@AttemptResultLabel(context.Result)</TemplateColumn><TemplateColumn Title="開始日時">@Time(context.StartedAt)</TemplateColumn><TemplateColumn Title="エラー">@(context.ErrorCode??"—") @context.ErrorMessage</TemplateColumn></FluentDataGrid>}}</FluentCard>}
}else if(tab=="tasks"){
 @if(tasks.Count==0){<UiState Title="収集処理はありません"/>}else{<FluentDataGrid Items="@tasks.AsQueryable()" TGridItem="CollectionTaskSummary" GridTemplateColumns="1.2fr 1.5fr 1fr .8fr .8fr" aria-label="収集処理一覧"><PropertyColumn Property="@(x=>x.TaskId)" Title="処理ID"/><TemplateColumn Title="収集対象">@ResourceTypeLabel(context.Resource.Type) / @context.Resource.Id</TemplateColumn><TemplateColumn Title="処理状態">@TaskStatusLabel(context.Status)</TemplateColumn><TemplateColumn Title="処理区分">@LaneLabel(context.Lane)</TemplateColumn><PropertyColumn Property="@(x=>x.Priority)" Title="優先度"/></FluentDataGrid>}
}else if(tab=="batches"){
 @if(batches.Count==0){<UiState Title="過去データの一括収集はありません"/>}else{<FluentDataGrid Items="@batches.AsQueryable()" TGridItem="BackfillBatchSnapshot" GridTemplateColumns="1.4fr 1fr .7fr .7fr .7fr .7fr" aria-label="過去データ一括収集一覧"><PropertyColumn Property="@(x=>x.BatchId)" Title="一括収集ID"/><TemplateColumn Title="対象期間">@context.From ～ @context.To</TemplateColumn><PropertyColumn Property="@(x=>x.Pending)" Title="待機中"/><PropertyColumn Property="@(x=>x.Running)" Title="実行中"/><PropertyColumn Property="@(x=>x.Succeeded)" Title="完了"/><PropertyColumn Property="@(x=>x.Failed)" Title="失敗"/></FluentDataGrid>}
}else{
 @if(failures.Count==0){<UiState Title="確認が必要な収集失敗はありません"/>}else{<FluentDataGrid Items="@failures.AsQueryable()" TGridItem="PendingCollectionFailureNotification" GridTemplateColumns="1.5fr 1fr .8fr 2fr" aria-label="確認が必要な収集失敗一覧"><TemplateColumn Title="収集対象">@ResourceTypeLabel(context.Resource.Type) / @context.Resource.Id</TemplateColumn><TemplateColumn Title="収集内容">@DefinitionLabel(context.Definition)</TemplateColumn><TemplateColumn Title="処理状態">@TaskStatusLabel(context.Status)</TemplateColumn><TemplateColumn Title="エラー内容">@(context.ErrorCode??"—") @context.ErrorMessage</TemplateColumn></FluentDataGrid>}
}
<FluentDialog Hidden="@(!showBulk)" HiddenChanged="@(h=>showBulk=!h)" Modal="true" TrapFocus="true" AriaLabelledby="bulk-title" Style="width:min(680px,calc(100vw - 32px));"><FluentDialogHeader ShowDismiss="true"><h2 id="bulk-title">複数の収集対象をまとめて再取得</h2></FluentDialogHeader><FluentDialogBody><p>対象を確認してから実行します。確認後に対象が増えることはありません。</p><FluentTextField Label="対象種別" @bind-Value="bulkType"/><FluentTextField Label="提供元" @bind-Value="provider"/><FluentTextField Label="収集定義ID" @bind-Value="definition"/><FluentTextField Label="必要な抽出仕様の版" @bind-Value="revision"/><FluentTextField Label="対象ID（カンマ区切り）" @bind-Value="ids"/>@if(preview is not null){<FluentMessageBar Intent="@MessageIntent.Info" Title="@($"対象は {preview.TargetCount} 件です")"/>}@if(bulkErrors.Count>0){<UiState Kind="error" Title="まとめて再取得を実行できません" Message="@string.Join(" ",bulkErrors)"/>}</FluentDialogBody><FluentDialogFooter><FluentButton OnClick="@(()=>showBulk=false)">キャンセル</FluentButton><FluentButton OnClick="PreviewAsync" Disabled="busy">対象を確認</FluentButton><FluentButton Appearance="@Appearance.Accent" OnClick="ExecuteAsync" Disabled="@(busy||preview is null)">再取得を依頼</FluentButton></FluentDialogFooter></FluentDialog>

@code{
 private readonly Dictionary<string,string> tabs=new(){{"resources","収集対象"},{"tasks","処理状況"},{"batches","過去データ収集"},{"failures","要確認"}}; private string tab="resources",query="",filter="",bulkType="Horse",provider="JRA",definition="horse-profile",revision="1",ids=""; private string? explicitUrl; private bool loading=true,busy,detailLoading,showBulk; private IReadOnlyList<string> errors=[],bulkErrors=[]; private IReadOnlyList<CollectionTaskSummary> tasks=[]; private IReadOnlyList<BackfillBatchSnapshot> batches=[]; private IReadOnlyList<PendingCollectionFailureNotification> failures=[]; private CollectionProgressSnapshot? progress; private HorseRacingPrediction.CollectionOperations.CollectionPlatform.CollectionPipelineState? pipeline; private CollectionTaskSummary? selected; private CollectionStateSnapshot? state; private CollectionResourceDetail? detail; private CollectionBulkPreview? preview;
 private IReadOnlyList<CollectionTaskSummary> Resources=>tasks.Where(x=>string.IsNullOrWhiteSpace(filter)||$"{x.Resource.Type} {ResourceTypeLabel(x.Resource.Type)} {x.Resource.Provider} {x.Resource.Id} {x.Definition.Value} {DefinitionLabel(x.Definition)}".Contains(filter,StringComparison.OrdinalIgnoreCase)).GroupBy(x=>new{x.Resource,x.Definition}).Select(g=>g.OrderByDescending(x=>x.AvailableAt).First()).ToList();
 protected override Task OnInitializedAsync()=>LoadAsync();
 private async Task LoadAsync(){loading=true;errors=[];try{var a=Api.GetCollectionProgressAsync();var b=Api.GetCollectionPipelineAsync();var c=Api.GetCollectionTasksAsync(limit:500);var d=Api.GetCollectionFailureNotificationsAsync();var e=Api.GetBackfillBatchesAsync();await Task.WhenAll(a,b,c,d,e);progress=await a;pipeline=await b;tasks=await c??[];failures=await d??[];batches=await e??[];}catch(Exception ex)when(ex is HttpRequestException or TaskCanceledException){errors=["管理APIに接続できません。APIが起動しているか確認し、もう一度更新してください。"];}finally{loading=false;}}
 private void ApplyFilter()=>filter=query.Trim(); private void ClearFilter(){query="";filter="";} private int Count(CollectionStateStatus s)=>progress?.StatesByStatus.TryGetValue(s,out var n)==true?n:0;
 private async Task SelectAsync(CollectionTaskSummary x){selected=x;state=null;detail=null;detailLoading=true;try{detail=await Api.GetCollectionResourceDetailAsync(x.Resource,x.Definition);state=detail?.State;}finally{detailLoading=false;}}
 private async Task RequestAsync(){if(selected is null)return;busy=true;try{var r=await Api.RequestCollectionAsync(new(selected.Resource.Type,selected.Resource.Provider,selected.Resource.Id,selected.Definition.Value,Math.Max(selected.RequestedRevision,state?.RequiredRevision??0),CollectionReason.ManualRefresh,selected.Lane,selected.Priority,string.IsNullOrWhiteSpace(explicitUrl)?null:explicitUrl));if(!r.Success)errors=r.Errors;else await LoadAsync();}finally{busy=false;}}
 private Task PauseAsync()=>PipelineAsync(true);private Task ResumeAsync()=>PipelineAsync(false);private async Task PipelineAsync(bool pause){busy=true;try{var r=pause?await Api.PauseCollectionPipelineAsync("管理画面から一時停止"):await Api.ResumeCollectionPipelineAsync();if(!r.Success)errors=r.Errors;else await LoadAsync();}finally{busy=false;}}
 private void OpenBulk(){showBulk=true;preview=null;bulkErrors=[];}
 private BulkCollectionOperationRequest? Bulk(IReadOnlyList<ResourceKey>? expected=null){if(!Enum.TryParse<ResourceType>(bulkType,true,out var t)||!int.TryParse(revision,out var rev)||rev<1){bulkErrors=["対象種別と抽出仕様の版を確認してください。"];return null;}var keys=ids.Split(',',StringSplitOptions.TrimEntries|StringSplitOptions.RemoveEmptyEntries).Distinct().Select(id=>new ResourceKey(t,provider.Trim(),id)).ToArray();if(keys.Length==0){bulkErrors=["対象IDを1件以上入力してください。"];return null;}return new(definition.Trim(),rev,CollectionReason.ManualRefresh,BulkCollectionSelection.SpecificResources,provider.Trim(),keys,ExpectedResources:expected);}
 private async Task PreviewAsync(){preview=null;bulkErrors=[];var q=Bulk();if(q is null)return;busy=true;try{var r=await Api.PreviewBulkCollectionAsync(q);if(r.Success)preview=r.Value;else bulkErrors=r.Errors;}finally{busy=false;}}
 private async Task ExecuteAsync(){if(preview is null)return;var q=Bulk(preview.Resources);if(q is null)return;busy=true;try{var r=await Api.ExecuteBulkCollectionAsync(q);if(r.Success){showBulk=false;await LoadAsync();}else bulkErrors=r.Errors;}finally{busy=false;}}
 private static string ResourceTypeLabel(ResourceType v)=>v switch{ResourceType.Race=>"レース",ResourceType.RaceCard=>"出馬表",ResourceType.RaceOdds=>"オッズ",ResourceType.RaceResult=>"レース結果",ResourceType.Horse=>"競走馬",ResourceType.Jockey=>"騎手",ResourceType.Trainer=>"調教師",_=>v.ToString()};
 private static string DefinitionLabel(CollectionDefinitionId v)=>v.Value switch{"race-discovery"=>"開催レースの探索","race-card"=>"出馬表","race-odds"=>"オッズ","race-result"=>"レース結果","horse-profile"=>"競走馬プロフィール","jockey-profile"=>"騎手プロフィール","trainer-profile"=>"調教師プロフィール",_=>v.Value};
 private static string StateStatusLabel(CollectionStateStatus v)=>v switch{CollectionStateStatus.Unknown=>"未確認",CollectionStateStatus.Pending=>"処理待ち",CollectionStateStatus.Collecting=>"収集中",CollectionStateStatus.Current=>"収集済み",CollectionStateStatus.RefreshDue=>"更新待ち",CollectionStateStatus.Stale=>"要再取得",CollectionStateStatus.Failed=>"失敗",CollectionStateStatus.Unavailable=>"取得不可",_=>v.ToString()};
 private static string TaskStatusLabel(CollectionTaskStatus v)=>v switch{CollectionTaskStatus.Pending=>"登録待ち",CollectionTaskStatus.Ready=>"実行待ち",CollectionTaskStatus.Running=>"実行中",CollectionTaskStatus.RetryWaiting=>"再試行待ち",CollectionTaskStatus.WaitingDiscovery=>"取得先の探索待ち",CollectionTaskStatus.Succeeded=>"完了",CollectionTaskStatus.Failed=>"失敗",CollectionTaskStatus.Cancelled=>"取消済み",CollectionTaskStatus.DeadLetter=>"要手動対応",_=>v.ToString()};
 private static string LaneLabel(CollectionLane v)=>v switch{CollectionLane.Realtime=>"リアルタイム",CollectionLane.Normal=>"通常",CollectionLane.Background=>"バックグラウンド",_=>v.ToString()};
 private static string LocationSourceLabel(ResourceLocationSource v)=>v switch{ResourceLocationSource.Explicit=>"手動指定",ResourceLocationSource.Generated=>"規則から生成",ResourceLocationSource.Discovered=>"探索で発見",ResourceLocationSource.Redirected=>"転送先",ResourceLocationSource.Manual=>"管理者登録",_=>v.ToString()};
 private static string LocationStatusLabel(ResourceLocationStatus v)=>v switch{ResourceLocationStatus.Unknown=>"未確認",ResourceLocationStatus.Active=>"利用可能",ResourceLocationStatus.Suspect=>"要再確認",ResourceLocationStatus.Invalid=>"利用不可",_=>v.ToString()};
 private static string AttemptResultLabel(CollectionAttemptResult v)=>v switch{CollectionAttemptResult.Running=>"実行中",CollectionAttemptResult.Succeeded=>"成功",CollectionAttemptResult.TransientFailure=>"一時的な失敗",CollectionAttemptResult.PermanentFailure=>"恒久的な失敗",CollectionAttemptResult.ResourceNotFound=>"対象なし",CollectionAttemptResult.ResourceNotYetAvailable=>"公開待ち",CollectionAttemptResult.ParseFailure=>"読み取り失敗",CollectionAttemptResult.ValidationFailure=>"内容検証失敗",CollectionAttemptResult.UnexpectedPage=>"別ページを検出",CollectionAttemptResult.AccessLimited=>"アクセス制限",CollectionAttemptResult.Cancelled=>"取消済み",_=>v.ToString()};
 private static string Time(DateTimeOffset? x)=>x?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")??"—";
}
