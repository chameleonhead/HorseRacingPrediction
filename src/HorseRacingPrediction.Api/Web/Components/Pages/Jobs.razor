@implements IAsyncDisposable
@page "/jobs"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsPageHeader Section="運用" Title="収集ジョブ" Description="収集処理の進行状況を対象日から絞り込み、失敗から復旧します。">
    <Actions>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@OpenRaceDayDialog" Disabled="@operating">開催日を再取得</FluentButton>
        @if (queuePaused)
        {
            <FluentButton Appearance="@Appearance.Accent" OnClick="@ResumeAsync" Disabled="@(operating || !queueStateKnown)">再開</FluentButton>
        }
        else
        {
            <FluentButton Appearance="@Appearance.Outline" OnClick="@OpenPauseDialog" Disabled="@(operating || !queueStateKnown)">すべてのジョブを一時停止</FluentButton>
        }
    </Actions>
</RaceOpsPageHeader>

@if (queuePaused)
{
    <section role="status" aria-live="polite"><h2>収集全体を停止中</h2><p>@queueState?.Reason</p>
        @if (queueState?.StoppedAt is { } stopped) { <p>@stopped.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</p> }
        @if (queueState?.JobId is { } cause) { <a href="@JobUrl(cause)">原因のジョブを見る</a> }
        <p>明示的に再開するまで新しいジョブは実行しません。失敗したジョブのリランと個別保留の解除は別に行います。</p>
    </section>
}
@if (operationErrors.Count > 0 && !showPauseDialog) { <UiState Kind="error" Title="操作を完了できませんでした" Message="@string.Join(" ", operationErrors)" /> }

<nav class="view-tabs" aria-label="収集ジョブの表示">
    @foreach (var option in views)
    {
        <button type="button" class="@(view == option.Value ? "active" : null)" aria-current="@(view == option.Value ? "page" : null)" @onclick="() => SetViewAsync(option.Value)">@option.Label</button>
    }
</nav>
<section class="filter-bar" aria-label="収集ジョブの絞り込み">
    <div class="filter-toolbar">
        <div class="filter-field filter-field-primary"><FluentTextField aria-label="収集ジョブ検索" Placeholder="対象、処理名、レースを検索" @bind-Value="keyword" /></div>
        <div class="filter-field filter-field-compact"><FluentTextField aria-label="処理種別" Placeholder="処理種別" @bind-Value="jobType" /></div>
        <div class="filter-field filter-field-compact"><FluentTextField aria-label="対象日" Placeholder="yyyy-MM-dd" @bind-Value="targetDateText" /></div>
        <div class="filter-field filter-field-compact"><FluentSelect TOption="FilterOption" aria-label="状態" Items="@statusFilters" OptionText="@(item => item.Label)" OptionValue="@(item => item.Value)" @bind-Value="statusText" /></div>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">絞り込む</FluentButton>
    </div>
    <RaceOpsFilterSummary Chips="@BuildFilterChips()" OnClearAll="@ClearFiltersAsync" />
</section>

@if (DaySummaries.Count > 0)
{
    <section class="entity-section" aria-labelledby="job-day-summary-heading">
        <div class="section-title"><h2 id="job-day-summary-heading">日別の収集状況</h2><span class="hint">対象日を選択して絞り込み</span></div>
        <div class="day-summary">
            @foreach (var summary in DaySummaries)
            {
                <a class="day-item" href="@JobsByDateUrl(summary.Date)" @onclick="() => SelectDayAsync(summary.Date)" @onclick:preventDefault>
                    <strong>@DisplayDate(summary.Date)</strong>
                    <small>@summary.Count 件の収集ジョブ</small>
                    <span class="day-progress"><span>@DayProgress(summary)</span><RaceOpsStatusBadge Label="@DayStatus(summary)" Tone="@DayStatusTone(summary)" /></span>
                </a>
            }
        </div>
    </section>
}

@if (loading) { <UiState Kind="loading" Title="収集ジョブを読み込んでいます" /> }
else if (jobs.Count == 0) { <UiState Title="該当する収集ジョブはありません" Message="条件を変更してお試しください。" /> }
else
{
    <RaceOpsObjectList Label="収集ジョブ一覧">
        @foreach (var job in jobs)
        {
            <RaceOpsObjectListItem Href="@JobUrl(job.JobId)" Title="@DisplayJobType(job.JobType)" Description="@DisplayTarget(job)" Status="@(job.IsHeld ? (job.Status == AgentJobStatus.Running ? "中断待ち" : "保留中") : StatusLabel(job.Status))" StatusTone="@StatusTone(job.Status)" Metadata="@DisplayMetadata(job)" />
        }
    </RaceOpsObjectList>
    @if (totalPages > 1) { <div class="list-pagination"><FluentButton Appearance="@Appearance.Outline" Disabled="@(page <= 1)" OnClick="@(() => GoPageAsync(page - 1))">前へ</FluentButton><span>@($"{page} / {totalPages}")</span><FluentButton Appearance="@Appearance.Outline" Disabled="@(page >= totalPages)" OnClick="@(() => GoPageAsync(page + 1))">次へ</FluentButton></div> }
}

<FluentDialog Hidden="@(!showPauseDialog)" HiddenChanged="@(hidden => showPauseDialog = !hidden)" Modal="true" TrapFocus="true" AriaLabelledby="pause-title" Style="width:min(520px, calc(100vw - 32px));">
        <FluentDialogHeader ShowDismiss="true"><h2 id="pause-title">すべてのジョブを一時停止しますか</h2></FluentDialogHeader>
        <FluentDialogBody>
            <p>新しいジョブの実行を停止します。開始済みの処理は結果を保存します。待機中のジョブと個別保留は維持されます。</p>
            @if (operationErrors.Count > 0) { <UiState Kind="error" Title="一時停止できませんでした" Message="@string.Join(' ', operationErrors)" /> }
        </FluentDialogBody>
        <FluentDialogFooter>
                <FluentButton OnClick="@ClosePauseDialog">キャンセル</FluentButton>
                <FluentButton Appearance="@Appearance.Accent" OnClick="@PauseAsync" Disabled="@(operating || !queueStateKnown)">一時停止</FluentButton>
        </FluentDialogFooter>
</FluentDialog>

<FluentDialog Hidden="@(!showRaceDayDialog)" HiddenChanged="@(hidden => showRaceDayDialog = !hidden)" Modal="true" TrapFocus="true" AriaLabelledby="race-day-reacquisition-title" Style="width:min(560px, calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="true"><h2 id="race-day-reacquisition-title">開催日の全レースを再取得</h2></FluentDialogHeader>
    <FluentDialogBody>
        <p>指定日のJRA全レースについて、基本情報、出馬表、馬主を含む出走情報、公開済み結果・払戻を再取得します。</p>
        <p>取得できなかった項目で既存値は消しません。レース単位のジョブへ分割するため、完了まで時間がかかる場合があります。</p>
        <FluentTextField Label="開催日（JST）" Placeholder="yyyy-MM-dd" Required="true" @bind-Value="raceDayText" />
        @if (raceDayErrors.Count > 0) { <UiState Kind="error" Title="再取得を開始できませんでした" Message="@string.Join(' ', raceDayErrors)" /> }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="@CloseRaceDayDialog">キャンセル</FluentButton>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@RequestRaceDayAsync" Disabled="@operating">再取得を依頼</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private IReadOnlyList<AgentJobStatusReadModel> jobs = [];
    private IReadOnlyList<AgentJobDaySummary> daySummaries = [];
    private string? keyword;
    private string? jobType;
    private string? targetDateText;
    private string statusText = string.Empty;
    private string view = "action";
    private static readonly IReadOnlyList<FilterOption> views = [
        new("action", "要対応"), new("running", "処理中"), new("ready", "待機中"), new("held", "保留中"), new("recent", "最近完了"), new("all", "すべて")];
    private static readonly IReadOnlyList<FilterOption> statusFilters = [
        new("", "すべて"), .. Enum.GetValues<AgentJobStatus>().Select(x => new FilterOption(x.ToString(), StatusLabel(x)))];
    private int page = 1;
    private const int pageSize = 50;
    private int totalPages;
    private bool loading;
    private bool operating;
    private bool queuePaused;
    private bool queueStateKnown;
    private readonly CancellationTokenSource refreshStop = new();
    private Task? refreshTask;
    private JobQueueStateResponse? queueState;
    private bool showPauseDialog;
    private bool showRaceDayDialog;
    private string? raceDayText;
    private IReadOnlyList<string> raceDayErrors = [];
    private IReadOnlyList<string> operationErrors = [];

    private string? lastSyncedQuery;
    private bool isFirstQuerySync = true;

    // Blazor はルートの再解決だけでは OnInitializedAsync を再実行しない（同一コンポーネント
    // インスタンスが再利用されるため）。日別サマリーのリンクなど、同じ /jobs 内でクエリ
    // 文字列だけが変わるナビゲーションでも絞り込み条件を反映できるよう、毎回のパラメーター
    // 設定時に呼ばれる OnParametersSetAsync で URL を読み直す。自分自身の UpdateUrl による
    // NavigateTo で二重にロードしないよう、直前に同期済みの URL と比較してから処理する。
    protected override async Task OnParametersSetAsync()
    {
        var currentQuery = Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery;
        if (currentQuery == lastSyncedQuery)
        {
            return;
        }

        lastSyncedQuery = currentQuery;

        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        // クエリ文字列が全く無い初回アクセスに限り、フィールド宣言時の既定値（view=action）
        // を維持する。以降のナビゲーションで view が未指定の場合は「すべて」を表示する
        // （対象日リンクなどは他の条件を引き継がず、その日の全ジョブを見せる想定のため）。
        var useDeclaredDefaults = isFirstQuerySync && q.Count == 0;
        isFirstQuerySync = false;

        view = q.TryGetValue("view", out var v) && !string.IsNullOrWhiteSpace(v)
            ? v!
            : (useDeclaredDefaults ? view : "all");
        page = q.TryGetValue("page", out var p) && int.TryParse(p, out var n) && n > 0 ? n : 1;
        jobType = q.TryGetValue("jobType", out var t) ? t.ToString() : null;
        keyword = q.TryGetValue("query", out var query) ? query.ToString() : null;
        targetDateText = q.TryGetValue("targetDate", out var d) ? d.ToString() : null;
        statusText = q.TryGetValue("status", out var s) ? s.ToString() : string.Empty;
        await LoadAsync();
    }
    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    // 日別サマリーのリンクは href も持たせているため中クリック等での別タブ表示は
    // 通常のナビゲーションで機能するが、通常クリックはここで直接フィルター状態を
    // 更新してから読み込む。href 経由の再ナビゲーションだけに頼ると、同一コンポー
    // ネントインスタンスの再利用や自身の UpdateUrl による置換ナビゲーションと絡み、
    // 対象日フィルターの表示が即座に切り替わらないことがあるため。
    private async Task SelectDayAsync(string date)
    {
        keyword = null;
        jobType = null;
        statusText = string.Empty;
        view = "all";
        targetDateText = date;
        page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try {
            queueState = await Api.GetJobQueueStateAsync();
            queueStateKnown = queueState is not null;
            queuePaused = queueState?.IsPaused ?? false;
            var result = await Api.SearchJobsAsync(view, keyword, targetDateText, jobType, Enum.TryParse<AgentJobStatus>(statusText, out var status) ? status : null, page, pageSize);
            jobs = result?.Items ?? [];
            daySummaries = result?.DaySummaries ?? [];
            totalPages = Math.Max(1, (int)Math.Ceiling((result?.TotalCount ?? 0) / (double)pageSize));
            if (page > totalPages) { page = totalPages; await LoadAsync(); return; }
            UpdateUrl();
            refreshTask ??= RefreshAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        { queueStateKnown = false; operationErrors = ["収集状態を取得できませんでした。再読み込みしてください。"]; }
        finally { loading = false; }
    }
    private void OpenPauseDialog() { operationErrors = []; showPauseDialog = true; }
    private void ClosePauseDialog() => showPauseDialog = false;
    private void OpenRaceDayDialog()
    {
        raceDayErrors = [];
        raceDayText = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
        showRaceDayDialog = true;
    }
    private void CloseRaceDayDialog() => showRaceDayDialog = false;
    private async Task RequestRaceDayAsync()
    {
        if (operating) return;
        if (!DateOnly.TryParseExact(raceDayText, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var raceDate))
        {
            raceDayErrors = ["開催日は yyyy-MM-dd 形式で入力してください。"];
            return;
        }

        operating = true;
        raceDayErrors = [];
        try
        {
            var result = await Api.RequestRaceDayReacquisitionAsync(raceDate, "収集ジョブ画面から開催日単位で再取得", refreshStop.Token);
            if (result.Success && !string.IsNullOrWhiteSpace(result.Value))
            {
                showRaceDayDialog = false;
                Navigation.NavigateTo(JobUrl(result.Value));
            }
            else raceDayErrors = result.Errors;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            raceDayErrors = ["再取得依頼の結果を確認できませんでした。最新のジョブ一覧を確認してください。"];
        }
        finally { operating = false; }
    }
    private Task PauseAsync() => ChangePipelineAsync(true);
    private Task ResumeAsync() => ChangePipelineAsync(false);
    private async Task ChangePipelineAsync(bool pause)
    {
        if (operating) return;
        operating = true; operationErrors = [];
        try
        {
            var result = pause ? await Api.PauseJobsAsync(refreshStop.Token) : await Api.ResumeJobsAsync(refreshStop.Token);
            if (result.Success) { showPauseDialog = false; await LoadAsync(); }
            else operationErrors = result.Errors;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        { operationErrors = ["操作結果を確認できませんでした。最新の状態を確認してください。"]; }
        finally { operating = false; }
    }
    private async Task RefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(refreshStop.Token))
                await InvokeAsync(async () =>
                {
                    if (loading || operating) return;
                    try
                    {
                        var state = await Api.GetJobQueueStateAsync(refreshStop.Token);
                        if (operating) return;
                        queueState = state; queueStateKnown = state is not null; queuePaused = state?.IsPaused ?? false;
                    }
                    catch (OperationCanceledException) when (refreshStop.IsCancellationRequested) { }
                    catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
                    { queueStateKnown = false; operationErrors = ["最新の収集状態を確認できません。次の更新で再確認します。"]; }
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (refreshStop.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        await refreshStop.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        refreshStop.Dispose();
    }
    private async Task GoPageAsync(int p) { page = p; await LoadAsync(); }
    private async Task SetViewAsync(string value) { view = value; page = 1; await LoadAsync(); }
    private static string JobUrl(string id) => $"/jobs/{Uri.EscapeDataString(id)}";
    private static string DisplayJobType(string value) => value switch { "CollectionPlanning" => "収集対象の確認", "RaceDayReacquisition" => "開催日の全レース再取得", "RaceReacquisition" => "レース情報の再取得", "RaceCardCollection" => "出馬表の収集", "RaceResultCollection" => "レース結果の収集", "ResultMonthDiscoveryRequest" => "月次レース結果の確認", "RaceResultCollectionRequest" => "レース結果の収集", "RaceCardCollectionRequest" => "出走表の収集", _ => value };
    private static string DisplayTarget(AgentJobStatusReadModel job) => ExtractTargetDate(job.DeduplicationKey) is { } targetDate ? $"対象日 {targetDate}" : "対象は詳細で確認";
    private static string DisplayMetadata(AgentJobStatusReadModel job) => $"更新 {job.UpdatedAt.ToLocalTime():yyyy/MM/dd HH:mm} ・ 試行 {job.AttemptCount} 回";
    private static string StatusTone(AgentJobStatus status) => status switch { AgentJobStatus.Succeeded => "success", AgentJobStatus.Failed or AgentJobStatus.DeadLetter => "danger", AgentJobStatus.Running => "info", _ => "warning" };
    private static string StatusLabel(AgentJobStatus status) => status switch { AgentJobStatus.Cancelled => "中断", AgentJobStatus.Succeeded => "完了", AgentJobStatus.Failed => "失敗", AgentJobStatus.DeadLetter => "要対応", AgentJobStatus.Running => "実行中", AgentJobStatus.Ready => "待機中", AgentJobStatus.WaitingDependency => "依存待ち", _ => status.ToString() };
    private void UpdateUrl() => NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/jobs", new Dictionary<string, string?> { ["view"] = view, ["page"] = page.ToString(), ["query"] = keyword, ["jobType"] = jobType, ["targetDate"] = targetDateText, ["status"] = statusText }.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string? ExtractTargetDate(string value)
    {
        var match = System.Text.RegularExpressions.Regex.Match(value, @"\d{4}-\d{2}-\d{2}");
        return match.Success ? match.Value : null;
    }

    private IReadOnlyList<AgentJobDaySummary> DaySummaries => daySummaries;
    private static string JobsByDateUrl(string date) => $"/jobs?targetDate={Uri.EscapeDataString(date)}";

    private sealed record FilterOption(string Value, string Label);
    private static string DisplayDate(string value) => DateOnly.TryParse(value, out var date) ? date.ToString("yyyy年M月d日") : value;
    private static string DayProgress(AgentJobDaySummary value)
    {
        var parts = new List<string>();
        if (value.CompletedCount > 0) parts.Add($"{value.CompletedCount}件完了");
        if (value.WaitingCount > 0) parts.Add($"{value.WaitingCount}件待機");
        if (value.AttentionCount > 0) parts.Add($"{value.AttentionCount}件要対応");
        return parts.Count == 0 ? $"{value.Count}件" : string.Join("・", parts);
    }
    private static string DayStatus(AgentJobDaySummary value) => value.AttentionCount > 0 ? "要対応" : value.WaitingCount > 0 ? "一部待機" : "完了";
    private static string DayStatusTone(AgentJobDaySummary value) => value.AttentionCount > 0 ? "danger" : value.WaitingCount > 0 ? "warning" : "success";
    private async Task ClearFiltersAsync() { keyword = null; jobType = null; targetDateText = null; statusText = string.Empty; page = 1; await LoadAsync(); }
    private List<RaceOpsFilterChip> BuildFilterChips()
    {
        var chips = new List<RaceOpsFilterChip>();
        if (!string.IsNullOrWhiteSpace(keyword))
        {
            chips.Add(new($"検索 {keyword}", async () => { keyword = null; page = 1; await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(jobType))
        {
            chips.Add(new($"処理種別 {jobType}", async () => { jobType = null; page = 1; await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(targetDateText))
        {
            chips.Add(new($"対象日 {targetDateText}", async () => { targetDateText = null; page = 1; await LoadAsync(); }));
        }
        if (!string.IsNullOrWhiteSpace(statusText))
        {
            chips.Add(new($"状態 {StatusLabel((AgentJobStatus)Enum.Parse(typeof(AgentJobStatus), statusText))}", async () => { statusText = string.Empty; page = 1; await LoadAsync(); }));
        }
        return chips;
    }
}
