@page "/jobs/operations"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<RaceOpsPageHeader Section="運用 / 収集管理" Title="収集運用" Description="障害への対応、過去データ収集、抽出仕様変更の進捗をまとめて管理します。">
    <Actions>
        <FluentButton Href="/jobs">収集状況へ戻る</FluentButton>
        <FluentButton OnClick="LoadAsync" Disabled="busy">更新</FluentButton>
    </Actions>
</RaceOpsPageHeader>

@if (loading)
{
    <UiState Kind="loading" Title="収集運用の情報を読み込んでいます" />
}
else if (loadErrors.Count > 0)
{
    <UiState Kind="error" Title="収集運用の情報を表示できません" Message="APIの稼働状況を確認して、もう一度更新してください。" />
}
else
{
    <section class="profile-facts" aria-label="収集処理の概要">
        <div class="profile-fact"><span>要対応の対象</span><strong>@failures.Sum(x => x.Count)</strong></div>
        <div class="profile-fact"><span>再試行待ち</span><strong>@progress!.RetryWaiting</strong></div>
        <div class="profile-fact"><span>実行中・待機中</span><strong>@progress.ActiveTasksByLane.Values.Sum()</strong></div>
        <div class="profile-fact"><span>過去データ収集</span><strong>@backfills.Count</strong></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <FluentMessageBar Intent="@MessageIntent.Success" Title="@successMessage" />
    }
    @if (operationErrors.Count > 0)
    {
        <UiState Kind="error" Title="操作を完了できませんでした" Message="@string.Join(" ", operationErrors)" />
    }

    <RaceOpsDetailTabs ActiveTabId="@activeTab" ActiveTabIdChanged="OnTabChanged">
        <FluentTab Label="運用状況" Id="monitoring">
            <section class="entity-section detail-section">
                <h2>処理区分ごとの待機状況</h2>
                <div class="operations-metrics">
                    @foreach (var lane in Enum.GetValues<CollectionLane>())
                    {
                        <div><span>@LaneLabel(lane)</span><strong>@Value(progress.ActiveTasksByLane, lane) 件</strong></div>
                    }
                </div>
                <h2>優先度ごとの待機状況</h2>
                <div class="operations-metrics">
                    @foreach (var item in progress.ActiveTasksByPriority.OrderByDescending(x => x.Key))
                    {
                        <div><span>@PriorityLabel(item.Key)</span><strong>@item.Value 件</strong></div>
                    }
                </div>
            </section>
        </FluentTab>

        <FluentTab Label="@($"障害対応 ({failures.Count}原因)")" Id="failures">
            <section class="entity-section detail-section">
                <h2>原因別の障害</h2>
                <p class="hint">同じ収集内容とエラーをまとめています。件数の多い原因から確認してください。</p>
                @if (FailureGroups.Count == 0)
                {
                    <UiState Title="未確認の障害通知はありません" Message="新しい障害が発生すると、原因ごとにここへ表示されます。" />
                }
                else
                {
                    <FluentDataGrid Items="@FailureGroups.AsQueryable()" TGridItem="CollectionFailureGroup" aria-label="原因別の障害一覧">
                        <PropertyColumn Property="@(x => x.Definition)" Title="収集内容" />
                        <PropertyColumn Property="@(x => x.ErrorCode)" Title="エラー分類" />
                        <PropertyColumn Property="@(x => x.Count)" Title="対象数" />
                        <TemplateColumn Title="最終発生">@Time(context.LastFailedAt)</TemplateColumn>
                        <TemplateColumn Title="対応">
                            <FluentButton OnClick="@(() => ConfirmRecovery(context))" Disabled="busy">まとめて再取得</FluentButton>
                        </TemplateColumn>
                    </FluentDataGrid>
                }
            </section>
        </FluentTab>

        <FluentTab Label="@($"過去データ収集 ({backfills.Count})")" Id="backfills">
            <section class="detail-card detail-section">
                <h2>月単位で収集を開始</h2>
                <p>存在するレースを日ごとに探索します。途中で失敗しても、成功済みの範囲を保ったまま再開できます。</p>
                <div class="operations-form-row">
                    <div class="operations-field"><FluentTextField Label="年" @bind-Value="backfillYear" /></div>
                    <div class="operations-field"><FluentTextField Label="月" @bind-Value="backfillMonth" /></div>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="CreateBackfillAsync" Disabled="busy">収集を開始</FluentButton>
                </div>
            </section>
            <section class="entity-section detail-section">
                <h2>進捗と未収集箇所</h2>
                @if (backfills.Count == 0)
                {
                    <UiState Title="過去データ収集はまだありません" Message="対象の年と月を指定して開始してください。" />
                }
                else
                {
                    <FluentDataGrid Items="@backfills.OrderByDescending(x => x.CreatedAt).AsQueryable()" TGridItem="BackfillBatchSnapshot" aria-label="過去データ収集の進捗">
                        <PropertyColumn Property="@(x => x.BatchId)" Title="対象期間" />
                        <TemplateColumn Title="探索日">@context.RegisteredDiscoveryDays / @context.ExpectedDiscoveryDays</TemplateColumn>
                        <PropertyColumn Property="@(x => x.Succeeded)" Title="成功" />
                        <PropertyColumn Property="@(x => x.Pending)" Title="待機" />
                        <PropertyColumn Property="@(x => x.Failed)" Title="失敗" />
                        <TemplateColumn Title="欠損">@context.Holes.Count 件</TemplateColumn>
                        <TemplateColumn Title="詳細"><FluentButton Href="@($"/jobs/backfills/{Uri.EscapeDataString(context.BatchId)}")">確認</FluentButton></TemplateColumn>
                    </FluentDataGrid>
                }
            </section>
        </FluentTab>

        <FluentTab Label="抽出仕様の再取得" Id="revisions">
            <section class="detail-card detail-section">
                <h2>新しい抽出仕様を登録</h2>
                <p>影響範囲を先に確認し、表示された対象だけに新しい版を適用します。</p>
                <div class="operations-form-row">
                    <div class="operations-field"><FluentTextField Label="収集内容" Placeholder="例: race-result" @bind-Value="revisionDefinition" /></div>
                    <div class="operations-field"><FluentTextField Label="版" @bind-Value="revisionText" /></div>
                    <div class="operations-field"><label class="filter-select">影響範囲<select aria-label="影響範囲" @bind="revisionScope" @bind:after="ResetRevisionPreview"><option value="All">すべて</option><option value="SpecificResources">対象IDを指定</option><option value="DateRange">日付範囲</option><option value="NamedCondition">定義済み条件</option></select></label></div>
                </div>
                @if (revisionScope == "SpecificResources") { <FluentTextArea Label="対象ID（改行またはカンマ区切り）" @bind-Value="revisionResourceIds" /> }
                else if (revisionScope == "DateRange") { <div class="operations-form-row"><FluentTextField Label="開始日 (yyyy-MM-dd)" @bind-Value="revisionFrom" /><FluentTextField Label="終了日 (yyyy-MM-dd)" @bind-Value="revisionTo" /></div> }
                else if (revisionScope == "NamedCondition") { <label class="filter-select">定義済み条件<select aria-label="定義済み条件" @bind="revisionNamedCondition" @bind:after="ResetRevisionPreview"><option value="race-result:dead-heat-before-rev5">同着を含む旧レース結果</option><option value="horse-profile:legacy-layout">旧レイアウトの競走馬情報</option></select></label> }
                <FluentTextArea Label="変更内容" Placeholder="修正した抽出項目と理由" @bind-Value="revisionDescription" />
                <div class="operations-form-row"><FluentButton OnClick="PreviewRevisionAsync" Disabled="busy">対象を確認</FluentButton><FluentButton Appearance="@Appearance.Accent" OnClick="ApplyRevisionAsync" Disabled="@(busy || revisionPreview is null)">この範囲に適用</FluentButton></div>
                @if (revisionPreview is not null)
                {
                    <div class="operations-metrics"><div><span>候補</span><strong>@revisionPreview.TotalCandidates 件</strong></div><div><span>影響対象</span><strong>@revisionPreview.AffectedResources.Count 件</strong></div></div>
                    <p class="hint">確認例: @string.Join("、", revisionPreview.AffectedResources.Take(5).Select(x => $"{x.Type}/{x.Id}"))</p>
                }
            </section>
            <section class="entity-section detail-section">
                <h2>適用済み仕様の再取得</h2>
                <p>上で指定した収集内容と版について、進捗確認または未完了対象の再取得ができます。</p>
                <FluentButton OnClick="LoadRevisionProgressAsync" Disabled="busy">進捗を確認</FluentButton>
                @if (revisionProgress is not null)
                {
                    <div class="operations-metrics" aria-label="抽出仕様の再取得進捗">
                        <div><span>影響対象</span><strong>@revisionProgress.Affected 件</strong></div>
                        <div><span>完了</span><strong>@revisionProgress.Completed 件</strong></div>
                        <div><span>待機</span><strong>@revisionProgress.Pending 件</strong></div>
                        <div><span>失敗</span><strong>@revisionProgress.Failed 件</strong></div>
                    </div>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="RecollectRevisionAsync" Disabled="busy">未完了の対象を再取得</FluentButton>
                }
            </section>
        </FluentTab>
    </RaceOpsDetailTabs>
}

<FluentDialog Hidden="@(pendingRecovery is null)" HiddenChanged="@(hidden => { if(hidden) pendingRecovery=null; })" Modal="true" TrapFocus="true" AriaLabelledby="recovery-title" Style="width:min(520px,calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="true" ShowDismissTooltip="true"><h2 id="recovery-title">障害対象をまとめて再取得</h2></FluentDialogHeader>
    <FluentDialogBody>@if(pendingRecovery is not null){<p><strong>@pendingRecovery.Count 件</strong>の「@(pendingRecovery.ErrorCode??"原因未分類")」を通常のRecovery経路へ依頼します。既に実行中の対象は二重実行せず、既存タスクへまとめられます。</p><p class="hint">収集内容: @pendingRecovery.Definition.Value<br />最終発生: @Time(pendingRecovery.LastFailedAt)</p>}</FluentDialogBody>
    <FluentDialogFooter><FluentButton OnClick="@(() => pendingRecovery=null)">キャンセル</FluentButton><FluentButton Appearance="@Appearance.Accent" OnClick="ConfirmRecoveryAsync" Disabled="busy">再取得を依頼</FluentButton></FluentDialogFooter>
</FluentDialog>

@code {
    private bool loading = true, busy;
    private CollectionProgressSnapshot? progress;
    private IReadOnlyList<CollectionFailureGroup> failures = [];
    private IReadOnlyList<BackfillBatchSnapshot> backfills = [];
    private IReadOnlyList<string> loadErrors = [], operationErrors = [];
    private string backfillYear = DateTime.Today.Year.ToString(), backfillMonth = DateTime.Today.Month.ToString();
    private string revisionDefinition = "race-result", revisionText = "1", successMessage = string.Empty;
    private string revisionScope = "All", revisionDescription = string.Empty, revisionResourceIds = string.Empty;
    private string revisionFrom = string.Empty, revisionTo = string.Empty, revisionNamedCondition = "race-result:dead-heat-before-rev5";
    private RevisionImpactPreview? revisionPreview;
    private RevisionRecollectionProgress? revisionProgress;
    private CollectionFailureGroup? pendingRecovery;
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private string activeTab = "monitoring";
    private readonly CancellationTokenSource refreshCancellation = new();

    private IReadOnlyList<CollectionFailureGroup> FailureGroups => failures.OrderByDescending(x => x.Count).ToList();

    protected override async Task OnInitializedAsync()
    {
        activeTab = Tab is "monitoring" or "failures" or "backfills" or "revisions" ? Tab : "monitoring";
        await LoadAsync();
        _ = RefreshLoopAsync(refreshCancellation.Token);
    }

    private Task OnTabChanged(string tab)
    {
        activeTab = tab;
        var basePath = Navigation.Uri.Split('?', 2)[0];
        Navigation.NavigateTo($"{basePath}?tab={Uri.EscapeDataString(tab)}", replace: true);
        return Task.CompletedTask;
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try { while (await timer.WaitForNextTickAsync(token)) if (!busy) await InvokeAsync(LoadAsync); }
        catch (OperationCanceledException) { }
    }

    public void Dispose() { refreshCancellation.Cancel(); refreshCancellation.Dispose(); }

    private async Task LoadAsync()
    {
        loading = progress is null;
        loadErrors = [];
        try
        {
            var dashboard = await Api.GetCollectionOperationsDashboardAsync();
            progress = dashboard?.Progress ?? EmptyProgress();
            failures = dashboard?.Failures ?? [];
            backfills = dashboard?.Backfills ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            loadErrors = ["収集APIへ接続できませんでした。"];
        }
        finally { loading = false; }
    }

    private async Task LoadProgressAsync() => progress = await Api.GetCollectionProgressAsync() ?? EmptyProgress();
    private async Task LoadFailuresAsync() => failures = await Api.GetCollectionFailureGroupsAsync() ?? [];
    private async Task LoadBackfillsAsync() => backfills = await Api.GetBackfillBatchesAsync() ?? [];

    private async Task CreateBackfillAsync()
    {
        operationErrors = []; successMessage = string.Empty;
        if (!int.TryParse(backfillYear, out var year) || !int.TryParse(backfillMonth, out var month) || month is < 1 or > 12)
        { operationErrors = ["正しい年と月を入力してください。"]; return; }
        await RunAsync(async () =>
        {
            var result = await Api.CreateBackfillBatchAsync(new(year, month));
            if (!result.Success) { operationErrors = result.Errors; return; }
            successMessage = $"{year}年{month}月の過去データ収集を受け付けました。";
            await LoadBackfillsAsync();
        });
    }

    private async Task RecoverFailureGroupAsync(CollectionFailureGroup group)
    {
        operationErrors = []; successMessage = string.Empty;
        await RunAsync(async () =>
        {
            var result = await Api.RecoverCollectionFailuresAsync(new(group.NotificationIds));
            if (!result.Success) { operationErrors = result.Errors; return; }
            successMessage = $"{group.Count}件の再取得を依頼しました。";
            await LoadAsync();
        });
    }
    private void ConfirmRecovery(CollectionFailureGroup group) => pendingRecovery = group;
    private async Task ConfirmRecoveryAsync(){if(pendingRecovery is null)return;var group=pendingRecovery;pendingRecovery=null;await RecoverFailureGroupAsync(group);}

    private async Task LoadRevisionProgressAsync()
    {
        operationErrors = []; successMessage = string.Empty;
        if (!int.TryParse(revisionText, out var revision) || revision < 1 || string.IsNullOrWhiteSpace(revisionDefinition))
        { operationErrors = ["収集内容と版を正しく入力してください。"]; return; }
        await RunAsync(async () => revisionProgress = await Api.GetRevisionRecollectionProgressAsync(revisionDefinition, revision));
    }

    private void ResetRevisionPreview() => revisionPreview = null;

    private bool TryBuildRevisionRequest(out RevisionImpactPreviewRequest request)
    {
        request = default!;
        if (!int.TryParse(revisionText, out var revision) || revision < 1 || string.IsNullOrWhiteSpace(revisionDefinition))
        { operationErrors = ["収集内容と版を正しく入力してください。"]; return false; }
        if (!Enum.TryParse<RevisionImpactScopeType>(revisionScope, out var scope)) return false;
        IReadOnlyList<ResourceKey>? resources = null;
        DateOnly? from = null, to = null;
        if (scope == RevisionImpactScopeType.SpecificResources)
        {
            var type = revisionDefinition switch { "horse-profile" => ResourceType.Horse, "jockey-profile" => ResourceType.Jockey, "trainer-profile" => ResourceType.Trainer, "race-odds" => ResourceType.RaceOdds, "race-result" => ResourceType.RaceResult, _ => ResourceType.RaceCard };
            resources = revisionResourceIds.Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().Select(id => new ResourceKey(type, "JRA", id)).ToList();
            if (resources.Count == 0) { operationErrors = ["対象IDを1件以上入力してください。"]; return false; }
        }
        if (scope == RevisionImpactScopeType.DateRange)
        {
            if (!DateOnly.TryParse(revisionFrom, out var parsedFrom) || !DateOnly.TryParse(revisionTo, out var parsedTo) || parsedFrom > parsedTo)
            { operationErrors = ["開始日と終了日を正しく入力してください。"]; return false; }
            from = parsedFrom; to = parsedTo;
        }
        var impact = new RevisionImpactRequest(scope, resources, from, to, scope == RevisionImpactScopeType.NamedCondition ? revisionNamedCondition : null);
        request = new(revisionDefinition.Trim(), revision, impact);
        return true;
    }

    private async Task PreviewRevisionAsync()
    {
        operationErrors = []; successMessage = string.Empty; revisionPreview = null;
        if (!TryBuildRevisionRequest(out var request)) return;
        await RunAsync(async () => { var result = await Api.PreviewRevisionImpactAsync(request); if (!result.Success) operationErrors = result.Errors; else revisionPreview = result.Value; });
    }

    private async Task ApplyRevisionAsync()
    {
        operationErrors = []; successMessage = string.Empty;
        if (revisionPreview is null || !TryBuildRevisionRequest(out var previewRequest)) return;
        if (string.IsNullOrWhiteSpace(revisionDescription)) { operationErrors = ["変更内容を入力してください。"]; return; }
        await RunAsync(async () =>
        {
            var result = await Api.ApplyRevisionAsync(new(previewRequest.DefinitionId, previewRequest.Revision, revisionDescription.Trim(), previewRequest.Impact));
            if (!result.Success) { operationErrors = result.Errors; return; }
            successMessage = $"抽出仕様 {previewRequest.DefinitionId} 版{previewRequest.Revision} を {result.Value!.Affected} 件へ適用しました。";
            revisionProgress = await Api.GetRevisionRecollectionProgressAsync(previewRequest.DefinitionId, previewRequest.Revision);
            revisionPreview = null;
        });
    }

    private async Task RecollectRevisionAsync()
    {
        if (!int.TryParse(revisionText, out var revision)) return;
        await RunAsync(async () =>
        {
            var result = await Api.RecollectRevisionAsync(revisionDefinition, revision, new());
            if (!result.Success) { operationErrors = result.Errors; return; }
            successMessage = $"抽出仕様 {revisionDefinition} 版{revision} の再取得を受け付けました。";
            revisionProgress = await Api.GetRevisionRecollectionProgressAsync(revisionDefinition, revision);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try { await action(); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        { operationErrors = ["収集APIへ接続できませんでした。時間をおいて再試行してください。"]; }
        finally { busy = false; }
    }

    private static int Value<TKey>(IReadOnlyDictionary<TKey, int> values, TKey key) where TKey : notnull
        => values.TryGetValue(key, out var value) ? value : 0;
    private static string LaneLabel(CollectionLane lane) => lane switch { CollectionLane.Realtime => "リアルタイム", CollectionLane.Normal => "通常", _ => "バックグラウンド" };
    private static string PriorityLabel(int value) => value >= 90 ? $"緊急 ({value})" : value >= 70 ? $"高 ({value})" : value <= 20 ? $"低 ({value})" : $"通常 ({value})";
    private static string Time(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    private static CollectionProgressSnapshot EmptyProgress() => new(new Dictionary<ResourceType,int>(), new Dictionary<CollectionStateStatus,int>(), new Dictionary<CollectionLane,int>(), new Dictionary<int,int>(), new Dictionary<string,int>(), 0);
}
