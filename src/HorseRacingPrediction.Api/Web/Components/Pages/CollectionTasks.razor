@page "/collection-tasks"
@inject IProcessingStateStore Store
@inject ProcessingStateStore ConcreteStore
@inject HorseRacingPrediction.Api.CollectionController.CollectionResetCoordinator ResetCoordinator

<h1>収集タスク・状態</h1>

<details class="card">
    <summary>復旧・初期化</summary>
    <p class="hint">キュー初期化は収集済みデータを保持します。完全初期化は予想・メモ・手動補正を含む全データをバックアップ後に削除します。</p>
    @if (resetPreview is not null)
    {
        <p>未配送 outbox: @resetPreview.PendingOutboxCount 件</p>
        <ul>@foreach (var item in resetPreview.JobsByStatus) { <li>@item.Key: @item.Value 件</li> }</ul>
        <details><summary>完全初期化で削除されるタスク DB</summary><ul>@foreach (var item in resetPreview.TableCounts) { <li>@item.Key: @item.Value 件</li> }</ul></details>
    }
    @if (eventStoreCounts is not null)
    {
        <details><summary>完全初期化で削除される Event Store</summary><ul>@foreach (var item in eventStoreCounts) { <li>@item.Key: @item.Value 件</li> }</ul></details>
    }
    <label>理由 <input @bind="resetReason" /></label>
    <label>確認文 <input @bind="resetConfirmation" /></label>
    <label>再認証パスワード <input type="password" @bind="resetPassword" autocomplete="current-password" /></label>
    <div class="toolbar">
        <button class="btn" @onclick="StartQueueReset" disabled="@resetBusy">キューを初期化</button>
        <button class="btn" @onclick="StartFullReset" disabled="@resetBusy">収集データを完全初期化</button>
        <button class="btn" @onclick="RefreshResetStatus">状態を更新</button>
    </div>
    @if (resetStatus is not null) { <p role="status">@resetStatus.State: @resetStatus.Message @resetStatus.BackupDirectory</p> }
</details>

<div class="toolbar">
    <label>JobType <input @bind="jobType" /></label>
    <label>キー・日付 <input @bind="keyQuery" placeholder="2026-08-15 / JRA" /></label>
    <label>
        Status
        <select @bind="status">
            <option value="">すべて</option>
            @foreach (var value in Enum.GetValues<AgentJobStatus>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <button class="btn primary" @onclick="LoadAsync">再読み込み</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p>@message</p>
}

<div class="object-list">
    @foreach (var task in PagedTasks)
    {
        <article class="object-row"><div class="object-primary"><a href="@(DetailUrl(task.JobId))"><strong>@task.JobType</strong></a><span class="hint">@task.DeduplicationKey</span>@if (!string.IsNullOrWhiteSpace(task.LastError)) { <span class="error-summary">@ErrorSummary(task.LastError)</span> }@if (HasStateMismatch(task)) { <span class="error-summary">⚠ ジョブ状態と日次状態が一致していません</span> }</div><div><span class="object-label">状態</span><span class="pill">@task.Status</span></div><div><span class="object-label">試行</span>@task.AttemptCount 回</div><div><span class="object-label">更新（JST）</span>@Format(task.UpdatedAt)</div></article>
    }
</div>
<Pagination TotalCount="tasks.Count" Page="page" PageSize="pageSize" PageChanged="GoPage" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "jobId")]
    public string? JobId { get; set; }

    private IReadOnlyList<AgentJobStatusReadModel> tasks = [];
    private string? jobType;
    private string? keyQuery;
    private string? status;
    private string? message;
    private readonly Dictionary<string, ResultDayCollectionState> resultDayStates = new(StringComparer.Ordinal);
    private int page = 1;
    private const int pageSize = 50;
    private string resetReason = string.Empty;
    private string resetConfirmation = string.Empty;
    private string resetPassword = string.Empty;
    private bool resetBusy;
    private HorseRacingPrediction.Api.CollectionController.CollectionResetStatus? resetStatus;
    private CollectionResetPreview? resetPreview;
    private IReadOnlyDictionary<string, long>? eventStoreCounts;
    private IEnumerable<AgentJobStatusReadModel> PagedTasks => tasks.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        await LoadResetPreviewAsync();
    }

    private async Task LoadAsync()
    {
        AgentJobStatus? parsed = Enum.TryParse<AgentJobStatus>(status, out var value) ? value : null;
        var loadedTasks = await Store.GetJobStatusesAsync(string.IsNullOrWhiteSpace(jobType) ? null : jobType, parsed, 200);
        if (!string.IsNullOrWhiteSpace(keyQuery))
            loadedTasks = loadedTasks.Where(x => x.DeduplicationKey.Contains(keyQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        tasks = string.IsNullOrWhiteSpace(JobId)
            ? loadedTasks
            : loadedTasks.Where(x => string.Equals(x.JobId, JobId, StringComparison.Ordinal)).ToList();
        resultDayStates.Clear();
        foreach (var task in tasks.Where(x => x.JobType == AgentJobType.ResultDayCollectionRequest))
        {
            if (!TryParseResultDayKey(task.DeduplicationKey, out var provider, out var date)) continue;
            var day = await Store.GetResultDayCollectionStatusAsync(provider, date);
            if (day is not null) resultDayStates[task.JobId] = day.Status;
        }

        if (!string.IsNullOrWhiteSpace(JobId) && tasks.Count == 0)
            message = "指定されたジョブが見つかりませんでした。";
        page = Math.Min(page, Math.Max(1, (int)Math.Ceiling(tasks.Count / (double)pageSize)));
    }

    private static string Format(DateTimeOffset? value) => value?.ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
    private static string DetailUrl(string jobId) => $"/collection-tasks/{Uri.EscapeDataString(jobId)}";
    private static string ErrorSummary(string error) => error.Length <= 100 ? error : $"{error[..100]}…";
    private Task GoPage(int value) { page = value; return Task.CompletedTask; }
    private bool HasStateMismatch(AgentJobStatusReadModel task)
    {
        if (!resultDayStates.TryGetValue(task.JobId, out var dayState)) return false;
        return task.Status switch
        {
            AgentJobStatus.Succeeded => dayState != ResultDayCollectionState.Complete,
            AgentJobStatus.Failed or AgentJobStatus.DeadLetter => dayState is ResultDayCollectionState.Running or ResultDayCollectionState.Ready,
            AgentJobStatus.WaitingDependency => dayState != ResultDayCollectionState.Running,
            _ => false
        };
    }
    private static bool TryParseResultDayKey(string key, out string provider, out DateOnly date)
    {
        const string marker = ":result-day-collection:";
        var index = key.IndexOf(marker, StringComparison.Ordinal);
        provider = index > 0 ? key[..index] : string.Empty;
        date = default;
        return index > 0 && DateOnly.TryParseExact(key[(index + marker.Length)..], "yyyy-MM-dd", out date);
    }

    private Task RefreshResetStatus()
    {
        resetStatus = ResetCoordinator.GetStatus();
        resetBusy = resetStatus.State == "Running";
        return Task.CompletedTask;
    }

    private async Task LoadResetPreviewAsync()
    {
        resetPreview = await ConcreteStore.GetResetPreviewAsync();
        eventStoreCounts = await ResetCoordinator.GetEventStoreTableCountsAsync();
        await RefreshResetStatus();
    }

    private Task StartQueueReset()
    {
        if (resetConfirmation != "キューを初期化" || string.IsNullOrWhiteSpace(resetReason))
        {
            message = "理由と確認文「キューを初期化」を入力してください。";
            return Task.CompletedTask;
        }
        resetBusy = ResetCoordinator.TryStartQueueReset("admin-ui", resetReason);
        return RefreshResetStatus();
    }

    private Task StartFullReset()
    {
        if (resetConfirmation != "収集データを完全初期化" || string.IsNullOrWhiteSpace(resetReason))
        {
            message = "理由と確認文「収集データを完全初期化」を入力してください。";
            return Task.CompletedTask;
        }
        resetBusy = ResetCoordinator.TryStartFullReset("admin-ui", resetReason, resetPassword);
        resetPassword = string.Empty;
        return RefreshResetStatus();
    }
}
