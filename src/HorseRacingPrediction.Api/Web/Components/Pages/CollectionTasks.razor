@page "/collection-tasks"
@inject IProcessingStateStore Store

<h1>収集タスク・状態</h1>

<div class="toolbar">
    <label>JobType <input @bind="jobType" /></label>
    <label>
        Status
        <select @bind="status">
            <option value="">すべて</option>
            @foreach (var value in Enum.GetValues<AgentJobStatus>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <button class="btn primary" @onclick="LoadAsync">再読み込み</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p>@message</p>
}

<div class="object-list">
    @foreach (var task in tasks)
    {
        <article class="object-row"><div class="object-primary"><strong>@task.JobType</strong><span class="hint">@task.DeduplicationKey</span></div><div><span class="object-label">状態</span><span class="pill">@task.Status</span></div><div><span class="object-label">試行</span>@task.AttemptCount 回</div><div><span class="object-label">更新</span>@Format(task.UpdatedAt)</div></article>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "jobId")]
    public string? JobId { get; set; }

    private IReadOnlyList<AgentJobStatusReadModel> tasks = [];
    private string? jobType;
    private string? status;
    private string? message;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        AgentJobStatus? parsed = Enum.TryParse<AgentJobStatus>(status, out var value) ? value : null;
        var loadedTasks = await Store.GetJobStatusesAsync(string.IsNullOrWhiteSpace(jobType) ? null : jobType, parsed, 200);
        tasks = string.IsNullOrWhiteSpace(JobId)
            ? loadedTasks
            : loadedTasks.Where(x => string.Equals(x.JobId, JobId, StringComparison.Ordinal)).ToList();

        if (!string.IsNullOrWhiteSpace(JobId) && tasks.Count == 0)
            message = "指定されたジョブが見つかりませんでした。";
    }

    private static string Format(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-";
}
