@page "/settings/horse-id-migration"
@attribute [Authorize]
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using HorseRacingPrediction.Api.Identity
@using HorseRacingPrediction.Contracts.Identity
@using HorseRacingPrediction.Contracts.Horses
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>馬ID移行の確認</PageTitle>

<RaceOpsPageHeader Section="設定" Title="馬ID移行の確認"
                   Description="候補は仮説です。保存データのプレビューを確認し、必要な場合だけ実行依頼を保存します。" />

<section class="entity-section migration-intro" aria-labelledby="migration-intro-heading">
    <h2 id="migration-intro-heading">名前だけでは同一性を確認できません</h2>
    <p>以下の対応は、表示名が一致しても本人確認にならない仮説です。生年月日やプロフィールの証拠が不足している候補があります。根拠を個別に確認し、承認できない候補は選択しないでください。</p>
    <p>プレビューは設定された保存先を読み取ります。実行依頼の保存は要求内容を別の運用ジャーナルへ記録するだけで、保存データは変更しません。保存後も処理は開始されず、保存済みの内容を確認した後に明示的に実行します。</p>
</section>

<section class="entity-section migration-diagnostics" aria-labelledby="migration-diagnostics-heading">
    <h2 id="migration-diagnostics-heading">保存先の読み取り専用診断</h2>
    <p>候補を選ばずに保存先の構造だけを確認できます。業務データは変更しません。診断が完了しても、移行プレビューの代わりにはなりません。</p>
    <div class="migration-actions">
        <FluentButton Appearance="@Appearance.Outline" OnClick="LoadSchemaDiagnosticsAsync" Disabled="@(!interactiveReady || schemaDiagnosticsLoading || busy)">
            @(schemaDiagnosticsLoading ? "診断中…" : "保存先を診断")
        </FluentButton>
        @if (schemaDiagnostics is not null)
        {
            <span>観測時刻 @schemaDiagnostics.ObservedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</span>
            <FluentButton Appearance="@Appearance.Outline" OnClick="CopySchemaDiagnosticsAsync" Disabled="@schemaDiagnosticsLoading">安全な診断JSONをコピー</FluentButton>
        }
    </div>
    @if (schemaDiagnosticsError is not null)
    {
        <p class="migration-error" role="alert">@schemaDiagnosticsError</p>
    }
    @if (schemaDiagnosticsCopiedMessage is not null)
    {
        <p role="status">@schemaDiagnosticsCopiedMessage</p>
    }
    @if (schemaDiagnosticsLoading && schemaDiagnostics is null)
    {
        <p role="status" aria-live="polite">保存先の診断を読み込んでいます…</p>
    }
    @if (schemaDiagnostics is not null)
    {
        <p class="@(schemaDiagnostics.IsComplete ? "migration-diagnostic-complete" : "migration-preview-blocked")" role="@(schemaDiagnostics.IsComplete ? "status" : "alert")">
            @(schemaDiagnostics.IsComplete
                ? "診断の読み取りは完了しました。移行可能かどうかは別途プレビューで確認してください。"
                : "診断が未完了です。結果を正常・差異なしとは扱わず、移行依頼はプレビューの判定に従ってください。")
        </p>
        <div class="migration-grid">
            <FluentDataGrid Items="@schemaDiagnostics.Surfaces.AsQueryable()" TGridItem="HorseIdentityMigrationSchemaSurfaceDiagnostic" MultiLine="true" aria-label="保存先の読み取り専用診断">
                <TemplateColumn Title="保存先">@SurfaceLabel(context.Surface.ToString())</TemplateColumn>
                <TemplateColumn Title="状態">@DiagnosticStatusLabel(context.Status)</TemplateColumn>
                <TemplateColumn Title="既知テーブル">@context.TableCount</TemplateColumn>
                <TemplateColumn Title="未知オブジェクト">@context.UnknownObjectCount</TemplateColumn>
                <TemplateColumn Title="履歴版">@HistoryVersions(context.MigrationHistoryVersions)</TemplateColumn>
                <TemplateColumn Title="差異">@context.Differences.Count</TemplateColumn>
            </FluentDataGrid>
        </div>
        <div class="migration-cards" aria-label="保存先の読み取り専用診断">
            @foreach (var surface in schemaDiagnostics.Surfaces)
            {
                <article class="migration-card">
                    <h3>@SurfaceLabel(surface.Surface.ToString())</h3>
                    <dl>
                        <dt>状態</dt><dd>@DiagnosticStatusLabel(surface.Status)</dd>
                        <dt>既知テーブル</dt><dd>@surface.TableCount</dd>
                        <dt>未知オブジェクト</dt><dd>@surface.UnknownObjectCount</dd>
                        <dt>履歴版</dt><dd>@HistoryVersions(surface.MigrationHistoryVersions)</dd>
                    </dl>
                    @if (surface.Differences.Count == 0)
                    {
                        <p>報告された差異はありません。</p>
                    }
                    else
                    {
                        <ul class="migration-differences">
                            @foreach (var difference in surface.Differences)
                            {
                                <li>
                                    <strong>@DifferenceLabel(difference.Kind)</strong> · @ObjectKindLabel(difference.ObjectKind)
                                    @if (!string.IsNullOrWhiteSpace(difference.KnownIdentifier))
                                    {
                                        <code>@difference.KnownIdentifier</code>
                                    }
                                    <dl>
                                        <dt>期待値</dt><dd>@ShapeLabel(difference.Expected)</dd>
                                        <dt>観測値</dt><dd>@ShapeLabel(difference.Observed)</dd>
                                    </dl>
                                </li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
        @if (schemaDiagnostics.IsComplete && schemaDiagnostics.Surfaces.All(surface => surface.Status is HorseIdentityMigrationSchemaStatus.Observed or HorseIdentityMigrationSchemaStatus.NotConfigured)
            && schemaDiagnostics.Surfaces.All(surface => surface.Differences.Count == 0 && surface.UnknownObjectCount == 0))
        {
            <p>構造差異は報告されていません。候補のプレビューを実行し、保存先の移行条件を確認してください。</p>
        }
        else
        {
            <p class="migration-warning">未知・未対応・未完了の構造は自動修復されません。保存内容を変更せず、表示された差異を確認してください。</p>
        }
    }
</section>

<section class="entity-section migration-candidates" aria-labelledby="migration-candidates-heading">
    <h2 id="migration-candidates-heading">確認する候補</h2>
    <p>候補はまだありません。同じ名前だけでは対応を選びません。候補を追加する場合は登録済みの旧IDを明示的に選び、JRA馬番号を入力してください。</p>
    <section class="migration-candidate-search" aria-labelledby="candidate-search-heading">
        <h3 id="candidate-search-heading">登録馬から候補を追加</h3>
        <div class="migration-candidate-search-fields">
            <FluentTextField Label="登録馬名またはIDで検索" Immediate="true" @bind-Value="horseSearchText" @bind-Value:after="OnHorseSearchTextChanged" Placeholder="馬名またはHorseId" aria-describedby="candidate-search-help" />
            <FluentButton Appearance="@Appearance.Outline" OnClick="SearchHorsesAsync" Disabled="@(!interactiveReady || horseSearchLoading || busy)">
                @(horseSearchLoading ? "検索中…" : "登録馬を検索")
            </FluentButton>
        </div>
        <p id="candidate-search-help">検索結果から旧IDを選択します。表示名は候補の自動判定には使いません。</p>
        @if (horseSearchError is not null)
        {
            <p class="migration-error" role="alert">@horseSearchError</p>
        }
        @if (horseSearchLoading)
        {
            <p role="status" aria-live="polite">登録馬を検索しています…</p>
        }
        @if (horseSearchResultsStale)
        {
            <p class="migration-warning" role="status">登録馬は同じ検索語で最後に成功した結果です。再検索が完了するまで最新の結果とは扱いません。</p>
        }
        @if (horseSearchResults is not null)
        {
            @if (horseSearchResults.Count == 0)
            {
                <p>一致する登録馬はありません。</p>
            }
            else
            {
                <FluentSelect TOption="string" Label="追加する旧ID" @bind-Value="selectedHorseId" @bind-Value:after="ClearPreviewForEdit" Disabled="@busy" aria-describedby="selected-horse-help">
                    <FluentOption TOption="string" Value="">登録馬を選択してください</FluentOption>
                    @foreach (var horse in horseSearchResults)
                    {
                        <FluentOption TOption="string" Value="@horse.HorseId">@horse.RegisteredName ・ @horse.HorseId ・ 生年月日 @(horse.BirthDate?.ToString("yyyy-MM-dd") ?? "—")</FluentOption>
                    }
                </FluentSelect>
                <p id="selected-horse-help">選択後、読み取り専用の診断で現在の登録・初回登録・source証拠を確認できます。</p>
            }
        }
        <div class="migration-candidate-search-fields">
            <FluentTextField Label="JRA馬番号（半角数字10桁）" Immediate="true" @bind-Value="jraHorseNumber" @bind-Value:after="ClearPreviewForEdit" Placeholder="例: 2024104541" aria-describedby="jra-number-help" />
            <FluentButton Appearance="@Appearance.Accent" OnClick="AddCandidate" Disabled="@(!CanAddCandidate)">候補へ追加</FluentButton>
        </div>
        <p id="jra-number-help">入力した番号からサーバー共通ルールでJRA識別子と移行先IDを導出します。任意URLや移行先IDは入力できません。追加候補を含め最大16件です。</p>
        @if (!string.IsNullOrEmpty(jraHorseNumber) && !IsCanonicalJraHorseNumber(jraHorseNumber))
        {
            <p class="migration-field-error" role="alert">JRA馬番号は半角数字ちょうど10桁で入力してください。</p>
        }
        @if (!string.IsNullOrWhiteSpace(selectedHorseId) && Candidates.Any(candidate => candidate.OldHorseId == selectedHorseId))
        {
            <p class="migration-field-error" role="alert">この旧IDは候補に登録済みです。別の登録馬を選択してください。</p>
        }
        @if (Candidates.Count >= HorseIdentityMigrationManifest.MaximumEntries)
        {
            <p class="migration-field-error" role="status">候補は最大16件です。候補を外すと追加できます。</p>
        }
        @if (candidateInputError is not null)
        {
            <p class="migration-error" role="alert">@candidateInputError</p>
        }
    </section>
    <div class="migration-grid">
        <FluentDataGrid Items="@Candidates.AsQueryable()" TGridItem="MigrationCandidate" MultiLine="true" aria-label="馬ID移行の仮説候補">
            <TemplateColumn Title="移行対象"><FluentCheckbox Value="@IsSelected(context)" ValueChanged="@(value => SetSelected(context, value))" Disabled="@(!interactiveReady || busy)" aria-label="@($"{context.Name} {context.OldHorseId} を移行対象として選択")" /></TemplateColumn>
            <TemplateColumn Title="仮説を確認"><FluentCheckbox Value="@context.HypothesisAccepted" ValueChanged="@(value => SetHypothesisAccepted(context, value))" Disabled="@(!interactiveReady || busy)" aria-label="@($"{context.Name} {context.JraIdentity} の仮説を確認")" /></TemplateColumn>
            <TemplateColumn Title="旧ID"><strong>@context.OldHorseId</strong></TemplateColumn>
            <TemplateColumn Title="仮説の対応"><span>@context.Name → @context.JraIdentity</span><small>既存の参考メモ（本人確認ではありません）: @context.EvidenceNote</small><small>@context.Limitations</small></TemplateColumn>
            <TemplateColumn Title="登録馬の証拠"><a href="@DiagnosticUrl(context.OldHorseId)" target="_top" data-enhance-nav="false">読み取り専用診断を見る</a>@if (context.SourceHorse is not null){<small>@HorseSummary(context.SourceHorse)</small>}</TemplateColumn>
            <TemplateColumn Title="候補の操作"><FluentButton Appearance="@Appearance.Outline" OnClick="@(() => RemoveCandidate(context))" Disabled="@busy">候補から外す</FluentButton></TemplateColumn>
        </FluentDataGrid>
    </div>
    <div class="migration-cards" aria-label="馬ID移行の仮説候補">
        @foreach (var candidate in Candidates)
        {
            <article class="migration-card">
                <div class="migration-card-selection">
                    <FluentCheckbox Value="@IsSelected(candidate)" ValueChanged="@(value => SetSelected(candidate, value))" Disabled="@(!interactiveReady || busy)" aria-label="@($"{candidate.Name} {candidate.OldHorseId} を移行対象として選択")" />
                    <strong>@candidate.Name</strong>
                </div>
                <dl>
                    <dt>旧ID</dt><dd>@candidate.OldHorseId</dd>
                    <dt>JRA識別子</dt><dd>@candidate.JraIdentity</dd>
                    <dt>既存の参考メモ</dt><dd>@candidate.EvidenceNote（本人確認ではありません）</dd>
                    <dt>根拠の限界</dt><dd>@candidate.Limitations</dd>
                    <dt>登録馬の証拠</dt><dd><a href="@DiagnosticUrl(candidate.OldHorseId)" target="_top" data-enhance-nav="false">読み取り専用診断を見る</a>@if (candidate.SourceHorse is not null){<span> · @HorseSummary(candidate.SourceHorse)</span>}</dd>
                </dl>
                <label class="migration-hypothesis-acceptance">
                    <FluentCheckbox Value="@candidate.HypothesisAccepted" ValueChanged="@(value => SetHypothesisAccepted(candidate, value))" Disabled="@(!interactiveReady || busy)" aria-label="@($"{candidate.Name} {candidate.JraIdentity} の未確認仮説を移行候補として確認")" />
                    未確認の対応仮説であることを理解し、この対応をプレビュー対象に含めます。
                </label>
                <FluentButton Appearance="@Appearance.Outline" OnClick="@(() => RemoveCandidate(candidate))" Disabled="@busy">候補から外す</FluentButton>
            </article>
        }
    </div>
    @if (errorMessage is not null)
    {
        <p class="migration-error" role="alert">@errorMessage</p>
    }
    @if (stageRequestRejected && !string.IsNullOrWhiteSpace(requestKeyInput))
    {
        <div class="migration-actions">
            <FluentButton Appearance="@Appearance.Outline" OnClick="AbandonRejectedStageRequest">拒否された受付キーを破棄して再プレビュー</FluentButton>
        </div>
    }
    @if (successMessage is not null)
    {
        <p class="migration-success" role="status">@successMessage</p>
    }
    @if (busy)
    {
        <p role="status" aria-live="polite">@busyMessage</p>
    }
    @if (SelectedCandidates.Any(candidate => !candidate.HypothesisAccepted))
    {
        <p class="migration-warning" role="status">選択した候補の未確認仮説を明示的に確認するまで、プレビューはできません。</p>
    }
    <div class="migration-actions">
        <span class="migration-selection-count">@SelectedCandidates.Count 件を選択 / @Candidates.Count 件（最大16件）</span>
        <FluentButton Appearance="@Appearance.Accent" OnClick="ReviewTargetsAsync" Disabled="@(!CanPreview)">
            @(busy && busyMessage == "選択した登録ルートを確認しています…" ? "確認中…" : "選択内容を確認")
        </FluentButton>
        <FluentButton Appearance="@Appearance.Outline" OnClick="FullPreviewAsync" Disabled="@(!CanPreview)">
            @(busy && busyMessage == "全件の読み取り専用プレビューを確認しています…" ? "全件確認中…" : "全件プレビュー（任意）")
        </FluentButton>
    </div>

    @if (targetReview is not null)
    {
        <section class="migration-preview" aria-labelledby="migration-target-review-heading">
            <h3 id="migration-target-review-heading">選択した登録ルートの確認</h3>
            <p class="migration-warning" role="status">全データの検証は未実施です。収集停止後、書き込み前に全件検証します。この確認は選択した旧IDと変換先の登録ルートだけを読み取り、全体状態や実行可否を示しません。</p>
            @if (targetReview.Blockers.Count > 0)
            {
                <ul class="migration-blockers" aria-label="対象確認の阻害理由">
                    @foreach (var blocker in targetReview.Blockers)
                    {
                        <li>@TargetReviewBlockerLabel(blocker)</li>
                    }
                </ul>
            }
            <ul class="migration-mappings">
                @foreach (var mapping in targetReview.Mappings)
                {
                    <li><strong>@mapping.OldHorseId</strong> → @mapping.JraIdentity <span>（変換先 @mapping.DestinationHorseId）</span></li>
                }
            </ul>
            <ul class="migration-roots" aria-label="選択した登録ルートの結果">
                @foreach (var root in targetReview.Roots)
                {
                    <li><strong>@root.OldHorseId</strong> → @root.DestinationHorseId — @TargetReviewRootLabel(root.Status)</li>
                }
            </ul>
            <div class="migration-actions">
                <FluentButton Appearance="@Appearance.Accent" OnClick="OpenStageConfirmation" Disabled="@(!CanStage)">内容を確認して依頼を保存</FluentButton>
            </div>
        </section>
    }

    @if (preview is not null)
    {
        <details class="migration-preview">
            <summary>任意の全件読み取り専用プレビュー</summary>
            <section aria-labelledby="migration-preview-heading">
            <h3 id="migration-preview-heading">全件読み取り専用プレビュー</h3>
            @if (IsPreviewReady(preview))
            {
                <p class="migration-preview-ready" role="status">表示された候補と保存状態を確認してください。プレビューは実行依頼の保存可否を示し、実行の開始やバックアップの作成を示すものではありません。</p>
            }
            else
            {
                <p class="migration-preview-blocked" role="alert">この内容は保存できません。以下の阻害理由が解消されるまで実行依頼は保存できません。</p>
            }

            @if (preview.Blockers.Count > 0)
            {
                <ul class="migration-blockers" aria-label="プレビューの阻害理由">
                    @foreach (var blocker in preview.Blockers)
                    {
                        <li>@BlockerLabel(blocker)</li>
                    }
                </ul>
            }

            @if (preview.InspectionDiagnostic is { } inspection)
            {
                var blockedByInspection = IsBlockingInspectionResult(inspection.Result);
                <p class="@(blockedByInspection ? "migration-preview-blocked" : "migration-preview-ready")" role="@(blockedByInspection ? "alert" : "status")">
                    @InspectionResultSummary(inspection.Result)
                </p>
                <details>
                    <summary>読み取り進捗の詳細を表示</summary>
                    <dl class="migration-preview-summary">
                        <dt>読み取り結果</dt><dd>@InspectionResultLabel(inspection.Result)</dd>
                        <dt>読み取り段階</dt><dd>@InspectionPhaseLabel(inspection.Phase)</dd>
                        <dt>最後に完了したページ</dt><dd>@SurfaceLabel(inspection.LastCompletedSurface?.ToString() ?? string.Empty) / @(inspection.LastCompletedTable ?? "—")</dd>
                        <dt>完了ページまでの下限行数</dt><dd>@inspection.InspectedRowsLowerBound</dd>
                        <dt>完了ページまでの下限サイズ</dt><dd>@inspection.InspectedBytesLowerBound バイト</dd>
                        <dt>経過時間</dt><dd>@inspection.ElapsedMilliseconds ミリ秒</dd>
                    </dl>
                </details>
            }

            <dl class="migration-preview-summary">
                <dt>読み取った行</dt><dd>@preview.InspectedRows</dd>
                <dt>読み取りサイズ</dt><dd>@preview.InspectedBytes バイト</dd>
                <dt>変換対象ページ</dt><dd>@preview.Pages.Count</dd>
                <dt>ページ内の対象行</dt><dd>@preview.Pages.Sum(evidencePage => evidencePage.RowCount)</dd>
            </dl>

            <h4>選択内容</h4>
            <ul class="migration-mappings">
                @foreach (var mapping in preview.Mappings)
                {
                    <li><strong>@mapping.OldHorseId</strong> → @mapping.JraIdentity <span>（変換先 @mapping.DestinationHorseId）</span></li>
                }
            </ul>

            <h4>保存先ごとの確認状態</h4>
            <div class="migration-grid">
                <FluentDataGrid Items="@preview.Stores.AsQueryable()" TGridItem="HorseIdentityMigrationPreviewStore" MultiLine="true" aria-label="保存先ごとの移行確認状態">
                    <TemplateColumn Title="保存先">@SurfaceLabel(context.Surface)</TemplateColumn>
                    <TemplateColumn Title="状態">@context.Status</TemplateColumn>
                    <TemplateColumn Title="既知オブジェクト">@context.TableCount</TemplateColumn>
                    <TemplateColumn Title="未確認オブジェクト">@context.UnknownObjectCount</TemplateColumn>
                </FluentDataGrid>
            </div>
            <div class="migration-cards" aria-label="保存先ごとの移行確認状態">
                @foreach (var store in preview.Stores)
                {
                    <article class="migration-card">
                        <h5>@SurfaceLabel(store.Surface)</h5>
                        <dl>
                            <dt>状態</dt><dd>@store.Status</dd>
                            <dt>既知オブジェクト</dt><dd>@store.TableCount</dd>
                            <dt>未確認オブジェクト</dt><dd>@store.UnknownObjectCount</dd>
                        </dl>
                    </article>
                }
            </div>

            <h4>旧IDの登録ルート</h4>
            <ul class="migration-roots">
                @foreach (var root in preview.Roots)
                {
                    <li><strong>@root.OldHorseId</strong> → @root.DestinationHorseId — @root.Status@(root.HasTargetCollision ? "（変換先の競合）" : "")</li>
                }
            </ul>

            <h4>型付きページの前後確認</h4>
            @if (preview.Pages.Count == 0)
            {
                <p>確認できた変換ページはありません。</p>
            }
            else
            {
                <div class="migration-grid">
                    <FluentDataGrid Items="@preview.Pages.AsQueryable()" TGridItem="HorseIdentityMigrationPreviewPage" MultiLine="true" aria-label="型付きページの前後確認">
                        <TemplateColumn Title="保存先">@SurfaceLabel(context.Surface)</TemplateColumn>
                        <TemplateColumn Title="型付きデータ">@context.Table</TemplateColumn>
                        <TemplateColumn Title="対象行">@context.RowCount</TemplateColumn>
                        <TemplateColumn Title="変更前 hash">@context.BeforeHash</TemplateColumn>
                        <TemplateColumn Title="期待後 hash">@context.ExpectedAfterHash</TemplateColumn>
                    </FluentDataGrid>
                </div>
                <div class="migration-cards" aria-label="型付きページの前後確認">
                    @foreach (var evidencePage in preview.Pages)
                    {
                        <article class="migration-card">
                            <h5>@SurfaceLabel(evidencePage.Surface) / @evidencePage.Table</h5>
                            <dl>
                                <dt>対象行</dt><dd>@evidencePage.RowCount</dd>
                                <dt>変更前 hash</dt><dd>@evidencePage.BeforeHash</dd>
                                <dt>期待後 hash</dt><dd>@evidencePage.ExpectedAfterHash</dd>
                            </dl>
                        </article>
                    }
                </div>
            }

            <p class="migration-warning">このプレビューは保存先ごとの現在の証拠です。実行時の一貫したバックアップを保証しません。実行依頼後の workflow が、実際の設定済み保存先と SQLite の WAL 状態を別途確認します。対象外または未対応のデータは自動推測・書換えしません。</p>
            </section>
        </details>
    }
</section>

<section class="entity-section migration-operation" aria-labelledby="migration-operation-heading">
    <h2 id="migration-operation-heading">保存済み依頼の状態を確認</h2>
    <p>GUIDまたは受付照会キーを使って、必要なときに状態を手動で確認します。再読込・再接続では自動取得や自動実行は行いません。</p>
    <div class="migration-status-form">
        <FluentTextField Label="実行依頼 GUID" @bind-Value="operationIdInput" aria-describedby="operation-id-help" />
        @if (!string.IsNullOrWhiteSpace(requestKeyInput))
        {
            <div class="migration-request-key"><span>受付照会キー</span><code>@requestKeyInput</code></div>
        }
        <FluentButton Appearance="@Appearance.Outline" OnClick="ReadStatusAsync" Disabled="@(!CanReadStatus)">状態を更新</FluentButton>
    </div>
    <p id="operation-id-help">受付結果を受け取れなかった場合は、URLに保存された受付照会キーで手動確認できます。状態確認は読み取り専用です。</p>
    @if (operationError is not null)
    {
        <p class="migration-error" role="alert">@operationError</p>
    }
    @if (operation is not null)
    {
        <section class="migration-operation-result" aria-labelledby="migration-operation-result-heading">
            <h3 id="migration-operation-result-heading">保存済み依頼</h3>
            @if (HasFailureEvidence(operation))
            {
                <div class="migration-warning" role="alert" aria-label="移行エラー概要">
                    <strong>@FailureStatusSummary(operation)</strong>
                    <p>@FailureReasonSummary(operation)</p>
                    <p>最後に確認した段階: @LastConfirmedPhaseLabel(operation.ExecutionPhase)</p>
                    @if (operationIsStale)
                    {
                        <p>最新の状態を取得できなかったため、以下は前回確認した記録です。再度「状態を更新」してください。</p>
                    }
                </div>
            }
            else if (operationIsStale)
            {
                <p class="migration-warning" role="alert">最新の状態を取得できませんでした。以下は前回確認した記録です。再度「状態を更新」してください。</p>
            }
            <dl>
                <dt>依頼 GUID</dt><dd><code>@operation.OperationId.ToString("D")</code></dd>
                <dt>状態</dt><dd><RaceOpsStatusBadge Label="@StatusLabel(operation)" Tone="@StatusTone(operation)" /></dd>
                <dt>理由</dt><dd>@OperationReasonLabel(operation.Reason)</dd>
                @if (operation.RequestKind == HorseIdentityMigrationAdmissionKind.PendingV2)
                {
                    <dt>依頼方式</dt><dd>停止後に全件検証する方式</dd>
                }
                <dt>記録更新時刻 (UTC)</dt><dd>@operation.UpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</dd>
                @if (!string.IsNullOrWhiteSpace(operation.ExecutionPhase))
                {
                    <dt>実行段階</dt><dd>@ExecutionPhaseLabel(operation.ExecutionPhase)</dd>
                    @if (operation.ExecutionUpdatedAt is { } phaseUpdatedAt)
                    {
                        <dt>段階更新時刻 (UTC)</dt><dd>@phaseUpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</dd>
                    }
                }
            </dl>
            @if (operation.SavedManifest?.Entries is { Count: > 0 } savedEntries)
            {
                <section class="migration-saved-request" aria-labelledby="migration-saved-request-heading">
                    <h4 id="migration-saved-request-heading">保存された実行内容</h4>
                    <ul class="migration-mappings">
                        @foreach (var entry in savedEntries)
                        {
                            if (entry is not null)
                            {
                                <li><strong>@entry.OldHorseId</strong> → @entry.JraIdentity</li>
                            }
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(operation.PreviewFingerprint))
                    {
                        <p>保存時のプレビュー fingerprint <code>@operation.PreviewFingerprint</code></p>
                    }
                </section>
            }
            @if (operation.RequestKind == HorseIdentityMigrationAdmissionKind.PendingV2
                && operation.ExecutionPhase != "Verified")
            {
                @if (operation.ExecutionPhase is null)
                {
                    <p class="migration-warning" role="status">全データの検証は未実施です。保存・再接続では実行を開始しません。</p>
                }
                else if (operation.ExecutionPhase is "DataSucceeded" or "Verifying")
                {
                    <p class="migration-warning" role="status">データ移行後の全件読み取り専用検証を実行中です。状態と実行段階を確認してください。</p>
                }
                else if (operation.ExecutionPhase == "Failed")
                {
                    <p class="migration-warning" role="alert">実行が失敗または停止しました。状態と実行段階を確認し、別の承認済み手順に従ってください。</p>
                }
                else
                {
                    <p class="migration-warning" role="status">全件検証は実行開始後の手順です。現在の状態と実行段階を確認してください。</p>
                }
            }
            @if (executeUncertain)
            {
                <p class="migration-warning" role="alert">実行要求の受付結果を確認できませんでした。再送はしていません。状態を手動で更新し、保存済み依頼の段階を確認してください。</p>
            }
            @if (operation.Status == "AwaitingActions" && CanExecute)
            {
                <div class="migration-actions">
                    <FluentButton Appearance="@Appearance.Accent" OnClick="OpenExecuteConfirmation">この保存済み依頼を実行</FluentButton>
                </div>
            }
            else if (operation.Status == "AwaitingActions")
            {
                <p class="migration-warning" role="alert">保存された依頼の内容・fingerprint・実行段階を確認できないため、この画面からは実行できません。手動で状態を更新してください。</p>
            }
            @if (operation.Results.Count > 0)
            {
                <h4>安全な進捗集計</h4>
                <ul>
                    @foreach (var result in operation.Results)
                    {
                        <li>@ResultCodeLabel(result.Code)@(result.Surface is null ? "" : $" · {SurfaceLabel(result.Surface)}"): @result.Count</li>
                    }
                </ul>
            }
            @if (operation.Status == "AwaitingActions" && operation.ExecutionPhase is null)
            {
                <div class="migration-warning" role="status">
                    <strong>実行開始前の依頼です。</strong>
                    <p>保存された内容と依頼 GUIDを確認してから、この画面の確認操作で開始できます。実行途中の再読込・再接続は処理を再送しません。</p>
                    <code>@operation.OperationId.ToString("D")</code>
                </div>
            }
            else if (operation.Status is "Partial" or "Interrupted")
            {
                <p class="migration-warning" role="alert">この依頼は未検証または中断状態です。この画面から再実行・再開はできません。保存状態を確認し、明示的な運用判断を行ってください。</p>
            }
        </section>
    }
</section>

<FluentDialog Hidden="@(!confirmStage)" HiddenChanged="@(hidden => confirmStage = !hidden)" Modal="true" TrapFocus="true" AriaLabelledby="migration-stage-title" Style="width:min(680px, calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="@(!busy)"><h2 id="migration-stage-title">実行依頼を保存しますか？</h2></FluentDialogHeader>
    <FluentDialogBody>
        <p>選択した @SelectedCandidates.Count 件の旧IDとJRA識別子の対応仮説を、全件検証待ちの依頼として保存します。</p>
        <p class="migration-warning">保存する依頼には全データの検証結果を含めません。この操作では元の保存データを変更せず、移行も開始しません。後で別の明示操作を行った後、書き込み前に全件検証します。</p>
        <ul>@foreach (var candidate in SelectedCandidates){<li><strong>@candidate.OldHorseId</strong> → @candidate.JraIdentity</li>}</ul>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="CloseStageConfirmation" Disabled="@busy">戻って確認</FluentButton>
        <FluentButton Appearance="@Appearance.Accent" OnClick="StageAsync" Disabled="@(!CanStage)">@(busy && busyMessage == "実行依頼を保存しています…" ? "保存中…" : "全件検証待ちとして保存")</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialog Hidden="@(!confirmExecute)" HiddenChanged="@(hidden => confirmExecute = !hidden)" Modal="true" TrapFocus="true" AriaLabelledby="migration-execute-title" Style="width:min(680px, calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="@(!busy)"><h2 id="migration-execute-title">保存済み依頼を実行しますか？</h2></FluentDialogHeader>
    <FluentDialogBody>
        <p>依頼 @operation?.OperationId.ToString("D") に保存された内容だけを実行します。画面上で編集した候補は送信しません。</p>
        @if (operation?.RequestKind == HorseIdentityMigrationAdmissionKind.PendingV2)
        {
            <p class="migration-warning">この方式では、開始後、書き込み前に停止・バックアップ・全件検証を行います。確認結果が不足または不一致なら書き込みません。</p>
        }
        <p>実行前に <a href="/jobs">収集管理</a> でパイプライン全体を明示的に一時停止してください。実行中の処理があれば、最大10分の完了待ちと、一時停止を確定してから15分間の待機が必要です。</p>
        <p>処理中はAPIが一時的に接続できなくなることがあります。同じURLへ戻ってログインし、この保存済み依頼の状態を手動で更新してください。成功後もパイプラインは停止したままです。再開や再試行は別の明示操作です。</p>
        <p>開始後は再読込や状態確認から再実行されません。通信が切れた場合は、再送せず状態を手動で確認してください。</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="CloseExecuteConfirmation" Disabled="@busy">戻って確認</FluentButton>
        <FluentButton Appearance="@Appearance.Accent" OnClick="ExecuteAsync" Disabled="@(!CanExecute)">@(busy && busyMessage == "保存済み依頼を開始しています…" ? "開始中…" : operation?.RequestKind == HorseIdentityMigrationAdmissionKind.PendingV2 ? "収集停止後に全件検証・移行" : "この依頼を実行")</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private readonly List<MigrationCandidate> Candidates = [];

    private readonly HashSet<string> selected = new(StringComparer.Ordinal);
    private HorseIdentityMigrationPreview? preview;
    private HorseIdentityMigrationTargetReview? targetReview;
    private HorseIdentityMigrationOperationResponse? operation;
    private string operationIdInput = string.Empty;
    private string requestKeyInput = string.Empty;
    private string? errorMessage;
    private string? operationError;
    private bool operationIsStale;
    private string? successMessage;
    private string? busyMessage;
    private bool busy;
    private bool confirmStage;
    private bool confirmExecute;
    private bool executeUncertain;
    private bool stageRequestRejected;
    private bool interactiveReady;
    private HorseIdentityMigrationSchemaDiagnostics? schemaDiagnostics;
    private bool schemaDiagnosticsLoading;
    private string? schemaDiagnosticsError;
    private string? schemaDiagnosticsCopiedMessage;
    private string horseSearchText = string.Empty;
    private string? selectedHorseId;
    private string jraHorseNumber = string.Empty;
    private IReadOnlyList<HorseSummaryDto>? horseSearchResults;
    private string? horseSearchResultsQuery;
    private bool horseSearchResultsStale;
    private bool horseSearchLoading;
    private string? horseSearchError;
    private string? candidateInputError;

    [SupplyParameterFromQuery(Name = "operationId")]
    public string? OperationIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "requestKey")]
    public string? RequestKeyQuery { get; set; }

    private IReadOnlyList<MigrationCandidate> SelectedCandidates => Candidates.Where(candidate => selected.Contains(candidate.OldHorseId)).ToArray();
    private bool CanPreview => interactiveReady && !busy && SelectedCandidates.Count > 0
        && SelectedCandidates.All(candidate => candidate.HypothesisAccepted && IsCanonicalJraIdentity(candidate.JraIdentity));
    private bool CanStage => interactiveReady && !busy && string.IsNullOrWhiteSpace(requestKeyInput)
        && targetReview is { CanSavePending: true }
        && SelectedCandidates.Count > 0 && SelectedCandidates.All(candidate => candidate.HypothesisAccepted);
    private bool CanReadStatus => interactiveReady && !busy
        && (Guid.TryParseExact(operationIdInput.Trim(), "D", out var id) && id != Guid.Empty
            || Guid.TryParseExact(requestKeyInput.Trim(), "D", out var requestKey) && requestKey != Guid.Empty);
    private bool CanExecute
    {
        get
        {
            var current = operation;
            return interactiveReady && !busy && !operationIsStale && !executeUncertain && string.IsNullOrWhiteSpace(requestKeyInput)
                && current is { Status: "AwaitingActions", ExecutionPhase: null }
                && (current.RequestKind == HorseIdentityMigrationAdmissionKind.PendingV2
                    ? current.PreviewFingerprint is null
                    : current.RequestKind == HorseIdentityMigrationAdmissionKind.BoundV1
                        && current.PreviewFingerprint is { Length: 64 } fingerprint
                        && fingerprint.All(Uri.IsHexDigit))
                && HorseIdentityMigrationManifestPolicy.Validate(current.SavedManifest).IsValid;
        }
    }
    private bool CanAddCandidate => interactiveReady && !busy && Candidates.Count < HorseIdentityMigrationManifest.MaximumEntries
        && !Candidates.Any(candidate => string.Equals(candidate.OldHorseId, selectedHorseId, StringComparison.Ordinal))
        && horseSearchResults?.Any(candidate => string.Equals(candidate.HorseId, selectedHorseId, StringComparison.Ordinal)) == true
        && IsCanonicalJraHorseNumber(jraHorseNumber)
        && IsCanonicalJraIdentity($"jra-horse:{jraHorseNumber}")
        && !Candidates.Any(candidate => candidate.JraIdentity == $"jra-horse:{jraHorseNumber}");

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactiveReady = true;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(OperationIdQuery)
            && Guid.TryParseExact(OperationIdQuery, "D", out var operationId)
            && operationId != Guid.Empty)
        {
            operationIdInput = operationId.ToString("D");
            requestKeyInput = string.Empty;
        }
        else if (!string.IsNullOrWhiteSpace(RequestKeyQuery)
            && Guid.TryParseExact(RequestKeyQuery, "D", out var requestKey)
            && requestKey != Guid.Empty)
        {
            operationIdInput = string.Empty;
            requestKeyInput = requestKey.ToString("D");
        }
    }

    private bool IsSelected(MigrationCandidate candidate) => selected.Contains(candidate.OldHorseId);

    private async Task LoadSchemaDiagnosticsAsync()
    {
        if (busy || schemaDiagnosticsLoading) return;
        schemaDiagnosticsLoading = true;
        schemaDiagnosticsError = null;
        schemaDiagnosticsCopiedMessage = null;
        try
        {
            schemaDiagnostics = await Api.GetHorseIdentityMigrationSchemaDiagnosticsAsync();
            if (schemaDiagnostics is null)
                schemaDiagnosticsError = "診断結果を受け取れませんでした。入力や保存データは変更されていません。必要な場合に明示的に再取得してください。";
        }
        catch (HttpRequestException exception)
        {
            schemaDiagnosticsError = exception.StatusCode switch
            {
                HttpStatusCode.TooManyRequests => "診断が混み合っています。時間をおいて明示的に再取得してください。",
                HttpStatusCode.ServiceUnavailable => "設定された保存先を診断できませんでした。",
                _ => "診断を完了できませんでした。時間をおいて明示的に再取得してください。",
            };
        }
        catch (OperationCanceledException)
        {
            schemaDiagnosticsError = "診断を完了できませんでした。必要な場合に明示的に再取得してください。";
        }
        finally
        {
            schemaDiagnosticsLoading = false;
        }
    }

    private async Task CopySchemaDiagnosticsAsync()
    {
        if (schemaDiagnostics is null || schemaDiagnosticsLoading) return;
        try
        {
            var safeJson = JsonSerializer.Serialize(schemaDiagnostics, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", safeJson);
            schemaDiagnosticsCopiedMessage = "安全な診断レポートをコピーしました。";
        }
        catch (JSException)
        {
            schemaDiagnosticsCopiedMessage = "この環境ではコピーできませんでした。画面の診断内容を確認してください。";
        }
    }

    private async Task SearchHorsesAsync()
    {
        if (busy || horseSearchLoading || string.IsNullOrWhiteSpace(horseSearchText)) return;
        var requestedQuery = horseSearchText.Trim();
        var refreshesSameQuery = horseSearchResults is not null
            && string.Equals(horseSearchResultsQuery, requestedQuery, StringComparison.Ordinal);
        if (!refreshesSameQuery)
        {
            horseSearchResults = null;
            horseSearchResultsQuery = null;
        }
        horseSearchResultsStale = refreshesSameQuery;
        horseSearchLoading = true;
        horseSearchError = null;
        selectedHorseId = null;
        ClearPreviewForEdit();
        try
        {
            var exactHorseId = IsExactHorseId(requestedQuery);
            var result = await Api.SearchHorsesAsync(new SearchHorsesRequest
            {
                Query = exactHorseId ? null : requestedQuery,
                HorseId = exactHorseId ? requestedQuery : null,
                Page = 1,
                PageSize = 50,
            });
            horseSearchResults = result?.Items ?? Array.Empty<HorseSummaryDto>();
            horseSearchResultsQuery = requestedQuery;
            horseSearchResultsStale = false;
        }
        catch (HttpRequestException)
        {
            horseSearchError = "登録馬を検索できませんでした。検索語を保持しています。必要な場合に再度検索してください。";
        }
        catch (OperationCanceledException)
        {
            horseSearchError = "登録馬の検索を完了できませんでした。検索語を保持しています。必要な場合に再度検索してください。";
        }
        finally
        {
            horseSearchLoading = false;
        }
    }

    private void OnHorseSearchTextChanged()
    {
        ClearPreviewForEdit();
        if (horseSearchResults is null || string.Equals(horseSearchResultsQuery, horseSearchText.Trim(), StringComparison.Ordinal)) return;
        horseSearchResults = null;
        horseSearchResultsQuery = null;
        horseSearchResultsStale = false;
        selectedHorseId = null;
    }

    private void AddCandidate()
    {
        candidateInputError = null;
        if (!CanAddCandidate)
        {
            candidateInputError = Candidates.Count >= HorseIdentityMigrationManifest.MaximumEntries
                ? "候補は追加分と参考候補を合わせて最大16件です。不要な候補を外してから追加してください。"
                : "登録馬を選び、半角数字10桁のJRA馬番号を入力してください。既にある旧IDは追加できません。";
            return;
        }

        var horse = horseSearchResults!.Single(candidate => string.Equals(candidate.HorseId, selectedHorseId, StringComparison.Ordinal));
        var horseNumber = jraHorseNumber;
        Candidates.Add(new MigrationCandidate(horse.HorseId, $"jra-horse:{horseNumber}", horse.RegisteredName,
            "登録馬として選択されています（JRA対応を証明するものではありません）。",
            "この対応は未確認の仮説です。保存された登録・初回登録・source証拠を確認してください。", horse));
        jraHorseNumber = string.Empty;
        selectedHorseId = null;
        candidateInputError = null;
        ClearPreviewForEdit();
    }

    private void RemoveCandidate(MigrationCandidate candidate)
    {
        if (busy) return;
        selected.Remove(candidate.OldHorseId);
        Candidates.Remove(candidate);
        ClearPreviewForEdit();
    }

    private void SetHypothesisAccepted(MigrationCandidate candidate, bool value)
    {
        candidate.HypothesisAccepted = value;
        ClearPreviewForEdit();
    }

    private void ClearPreviewForEdit()
    {
        preview = null;
        targetReview = null;
        confirmStage = false;
        errorMessage = null;
        successMessage = null;
    }

    private void SetSelected(MigrationCandidate candidate, bool value)
    {
        if (value) selected.Add(candidate.OldHorseId);
        else selected.Remove(candidate.OldHorseId);
        ClearPreviewForEdit();
    }

    private async Task ReviewTargetsAsync()
    {
        if (!CanPreview) return;
        busy = true;
        busyMessage = "選択した登録ルートを確認しています…";
        errorMessage = null;
        successMessage = null;
        targetReview = null;
        preview = null;
        try
        {
            targetReview = await Api.ReviewHorseIdentityMigrationTargetsAsync(BuildManifest());
            if (targetReview is null)
                errorMessage = "対象確認を受け取れませんでした。選択内容を保持しています。";
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode switch
            {
                HttpStatusCode.BadRequest => "入力内容を確認できませんでした。候補の選択を確認してください。",
                HttpStatusCode.TooManyRequests => "対象確認の容量上限に達したか、処理が混み合っています。選択内容は保持されています。",
                HttpStatusCode.ServiceUnavailable => "選択した登録ルートを確認できませんでした。必要な場合に明示的に再確認してください。",
                _ => "対象確認を完了できませんでした。選択内容は保持されています。",
            };
        }
        catch (OperationCanceledException)
        {
            errorMessage = "対象確認を完了できませんでした。選択内容は保持されています。必要な場合は明示的に再確認してください。";
        }
        finally
        {
            busy = false;
            busyMessage = null;
        }
    }

    private async Task FullPreviewAsync()
    {
        if (!CanPreview) return;
        busy = true;
        busyMessage = "全件の読み取り専用プレビューを確認しています…";
        errorMessage = null;
        successMessage = null;
        preview = null;
        try
        {
            preview = await Api.PreviewHorseIdentityMigrationAsync(BuildManifest());
            if (preview is null) errorMessage = "全件プレビューを受け取れませんでした。選択内容を保持しています。";
        }
        catch (HttpRequestException exception)
        {
            errorMessage = exception.StatusCode switch
            {
                HttpStatusCode.BadRequest => "入力内容を確認できませんでした。候補の選択を確認してください。",
                HttpStatusCode.TooManyRequests => "プレビューの容量上限に達したか、処理が混み合っています。選択内容は保持されています。",
                HttpStatusCode.ServiceUnavailable => "設定された保存先を確認できませんでした。時間をおいて明示的に再度プレビューしてください。",
                _ => "全件プレビューを完了できませんでした。選択内容は保持されています。",
            };
        }
        catch (OperationCanceledException)
        {
            errorMessage = "全件プレビューを完了できませんでした。選択内容は保持されています。必要な場合は明示的に再度確認してください。";
        }
        finally
        {
            busy = false;
            busyMessage = null;
        }
    }

    private void OpenStageConfirmation()
    {
        if (CanStage) confirmStage = true;
    }

    private void CloseStageConfirmation()
    {
        if (!busy) confirmStage = false;
    }

    private async Task StageAsync()
    {
        if (!CanStage || targetReview is not { CanSavePending: true }) return;
        busy = true;
        busyMessage = "実行依頼を保存しています…";
        errorMessage = null;
        successMessage = null;
        try
        {
            var requestKey = Guid.TryParseExact(requestKeyInput, "D", out var pendingRequestKey)
                ? pendingRequestKey
                : Guid.NewGuid();
            requestKeyInput = requestKey.ToString("D");
            operationIdInput = string.Empty;
            operation = null;
            stageRequestRejected = false;
            RememberRequestKey(requestKey);
            var response = await Api.StagePendingHorseIdentityMigrationAsync(BuildManifest(), requestKey);
            if (response is null)
            {
                errorMessage = "受付結果を受け取れませんでした。再送はしていません。URLに保存された受付照会キーで状態を手動確認してください。";
                confirmStage = false;
                return;
            }

            operation = response;
            operationIdInput = response.OperationId.ToString("D");
            requestKeyInput = string.Empty;
            executeUncertain = false;
            RememberOperationId(response.OperationId);
            successMessage = "実行依頼の保存結果を受け取りました。表示された状態を確認してください。";
            confirmStage = false;
        }
        catch (HttpRequestException exception)
        {
            stageRequestRejected = exception.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Conflict;
            errorMessage = exception.StatusCode switch
            {
                HttpStatusCode.BadRequest => "実行依頼の内容を受け付けられませんでした。候補とプレビューを確認し、受付照会キーで状態を手動確認してください。",
                HttpStatusCode.Conflict => "選択した登録ルートの状態が確認後に変わりました。対象をもう一度確認してください。拒否された受付照会キーを破棄して再確認できます。",
                HttpStatusCode.TooManyRequests => "実行依頼を確認できませんでした。自動再試行はしていません。受付照会キーで状態を手動確認してください。",
                HttpStatusCode.ServiceUnavailable => "実行依頼を確認できませんでした。自動再試行はしていません。受付照会キーで状態を手動確認してください。",
                _ => "実行依頼の受付結果を確認できませんでした。再送はしていません。受付照会キーで状態を手動確認してください。",
            };
            confirmStage = false;
        }
        catch (OperationCanceledException)
        {
            errorMessage = "受付結果を確認できませんでした。自動再送はしていません。URLに保存された受付照会キーで状態を手動確認してください。";
            confirmStage = false;
        }
        finally
        {
            busy = false;
            busyMessage = null;
        }
    }

    private void AbandonRejectedStageRequest()
    {
        if (!stageRequestRejected || string.IsNullOrWhiteSpace(requestKeyInput)) return;
        stageRequestRejected = false;
        requestKeyInput = string.Empty;
        operationIdInput = string.Empty;
        operation = null;
        preview = null;
        confirmStage = false;
        errorMessage = "受付は拒否され、保存済み依頼はありません。候補を確認し、選択した対象を再確認してください。";
        successMessage = null;
        ClearRequestLocatorFromUrl();
    }

    private async Task ReadStatusAsync()
    {
        if (!CanReadStatus) return;
        var useRequestKey = Guid.TryParseExact(requestKeyInput.Trim(), "D", out var requestKey)
            && requestKey != Guid.Empty;
        Guid operationId = Guid.Empty;
        if (!useRequestKey && (!Guid.TryParseExact(operationIdInput.Trim(), "D", out operationId) || operationId == Guid.Empty)) return;
        busy = true;
        busyMessage = "保存済み依頼の状態を読み取っています…";
        operationError = null;
        try
        {
            if (useRequestKey)
            {
                operation = await Api.GetHorseIdentityMigrationRequestAsync(requestKey);
            }
            else
            {
                RememberOperationId(operationId);
                operation = await Api.GetHorseIdentityMigrationOperationAsync(operationId);
            }

            if (operation is null)
            {
                operationIsStale = false;
                operationError = useRequestKey
                    ? "この受付照会キーの依頼を見つけられませんでした。キーは保持されています。"
                    : "このGUIDの依頼を見つけられませんでした。入力を確認してください。";
            }
            else
            {
                operationIsStale = false;
                executeUncertain = false;
                operationIdInput = operation.OperationId.ToString("D");
                requestKeyInput = string.Empty;
                stageRequestRejected = false;
                RememberOperationId(operation.OperationId);
            }
        }
        catch (HttpRequestException exception)
        {
            operationIsStale = operation is not null;
            operationError = exception.StatusCode switch
            {
                HttpStatusCode.NotFound => "このGUIDの依頼を見つけられませんでした。入力を確認してください。",
                HttpStatusCode.TooManyRequests => "状態確認が混み合っています。必要な場合に手動で再度確認してください。",
                HttpStatusCode.ServiceUnavailable => "依頼状態を読み取れませんでした。保存データは変更されていません。",
                _ => "依頼状態を読み取れませんでした。入力を確認し、必要な場合に手動で再度確認してください。",
            };
        }
        catch (OperationCanceledException)
        {
            operationIsStale = operation is not null;
            operationError = "状態を読み取れませんでした。必要な場合に手動で再度確認してください。";
        }
        finally
        {
            busy = false;
            busyMessage = null;
        }
    }

    private void OpenExecuteConfirmation()
    {
        if (CanExecute) confirmExecute = true;
    }

    private void CloseExecuteConfirmation()
    {
        if (!busy) confirmExecute = false;
    }

    private async Task ExecuteAsync()
    {
        if (!CanExecute || operation is null) return;
        var operationId = operation.OperationId;
        busy = true;
        busyMessage = "保存済み依頼を開始しています…";
        operationError = null;
        executeUncertain = false;
        try
        {
            var response = await Api.ExecuteHorseIdentityMigrationAsync(operationId);
            if (response is null)
            {
                executeUncertain = true;
                operationError = "開始結果を受け取れませんでした。再送はしていません。状態を手動で確認してください。";
                confirmExecute = false;
                return;
            }

            operation = response;
            operationIdInput = response.OperationId.ToString("D");
            RememberOperationId(response.OperationId);
            confirmExecute = false;
        }
        catch (HttpRequestException)
        {
            executeUncertain = true;
            operationError = "開始結果を確認できませんでした。再送はしていません。状態を手動で確認してください。";
            confirmExecute = false;
        }
        catch (OperationCanceledException)
        {
            executeUncertain = true;
            operationError = "開始結果を確認できませんでした。再送はしていません。状態を手動で確認してください。";
            confirmExecute = false;
        }
        finally
        {
            busy = false;
            busyMessage = null;
        }
    }

