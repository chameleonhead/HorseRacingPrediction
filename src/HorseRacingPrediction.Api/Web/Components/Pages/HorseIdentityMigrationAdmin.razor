    private static string FailureStatusSummary(HorseIdentityMigrationOperationResponse value)
    {
        var category = FailureCategories(value).FirstOrDefault();
        if (value.Status == "Succeeded")
            return category == "通常APIの起動に失敗"
                ? "移行データの成功記録は保持されています。通常APIを起動できませんでした。"
                : "成功記録は保持されています。後続の処理でエラーが記録されています。";
        if (category is not null) return $"移行処理の停止: {category}";
        return "移行処理が停止または一部未確認です。原因は記録から確認できません。";
    }

    private static string FailureReasonSummary(HorseIdentityMigrationOperationResponse value)
    {
        var categories = FailureCategories(value).Distinct(StringComparer.Ordinal).ToArray();
        return categories.Length > 0
            ? string.Join("、", categories.Select(category => FailureReason(category)))
            : "詳しい原因は安全な形式で記録されていません。";
    }

    private static IEnumerable<string> FailureCategories(HorseIdentityMigrationOperationResponse value)
    {
        foreach (var result in value.Results)
        {
            var category = FailureCategory(result.Code);
            if (category is not null) yield return category;
        }

        var reasonCategory = FailureCategory(value.Reason);
        if (reasonCategory is not null) yield return reasonCategory;
    }

