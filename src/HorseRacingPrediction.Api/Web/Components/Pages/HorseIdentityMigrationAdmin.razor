        "StoppingApi" => "API停止中",
        "ApiExited" => "API終了済み",
        "BackedUp" => "バックアップ確認済み",
        "Applying" => "データ移行中",
        "DataSucceeded" => "データ移行済み・検証待ち",
        "Verifying" => "読み取り専用検証中",
        "Verified" => "検証済み",
        _ => "記録から確認できません",
    };

    private static string OperationReasonLabel(string? reason) => reason switch
    {
        "None" => "なし",
        "CapacityExceeded" => "処理容量の上限",
        "OwnershipBusy" => "別の処理が保存先を使用中",
        "RequestConflict" => "依頼内容の競合",
        "StaleOperation" => "依頼時の前提が古い状態",
        "UnverifiedPages" => "未検証のデータが残っています",
        "OperationInterrupted" => "処理が中断しました",
        "PreparationFailed" or "BackupFailed" or "InspectionFailed" or "ApplyFailed"
            or "VerificationFailed" or "ChildFailed" or "StartupFailed" => FailureReason(FailureCategory(reason)!),
        _ => "詳しい原因は記録されていません",
    };

    private static string ResultCodeLabel(string? code) => code switch
    {
        "PlanIncomplete" => "移行計画の検証未完了",
        "DestinationCollision" => "移行先の競合",
        "PageMismatch" => "ページ検証の不一致",
        "CapacityExceeded" => "処理容量の上限",
        "OperationInterrupted" => "処理の中断",
        "PreparationFailed" or "BackupFailed" or "InspectionFailed" or "ApplyFailed"
            or "VerificationFailed" or "ChildFailed" or "StartupFailed" => FailureCategory(code)!,
        _ => "確認できない結果",
    };

    private sealed record MigrationCandidate(string OldHorseId, string JraIdentity, string Name,
        string EvidenceNote, string Limitations, HorseSummaryDto? SourceHorse)
    {
        public bool HypothesisAccepted { get; set; }
    }
}
