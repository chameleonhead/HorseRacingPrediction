    private void RememberOperationId(Guid operationId)
    {
        var current = Navigation.ToAbsoluteUri(Navigation.Uri);
        IEnumerable<KeyValuePair<string, string?>> query = current.Query is { Length: > 1 }
            ? QueryHelpers.ParseQuery(current.Query)
                .Where(pair => !string.Equals(pair.Key, "operationId", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(pair.Key, "requestKey", StringComparison.OrdinalIgnoreCase))
                .SelectMany(pair => pair.Value.Select(value => new KeyValuePair<string, string?>(pair.Key, value)))
            : Enumerable.Empty<KeyValuePair<string, string?>>();
        var updated = QueryHelpers.AddQueryString(current.GetLeftPart(UriPartial.Path),
            query.Append(new KeyValuePair<string, string?>("operationId", operationId.ToString("D"))));
        if (!string.Equals(current.AbsoluteUri, updated, StringComparison.Ordinal))
            Navigation.NavigateTo(updated, replace: true);
    }

