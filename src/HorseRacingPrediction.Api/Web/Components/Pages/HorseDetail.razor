@page "/horses/{HorseId}"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>馬詳細</h1>
<p class="hint"><a href="horses">← 馬検索へ戻る</a></p>

@if (loading) { <p>読み込み中…</p> }
else if (horse is null) { <p>HorseId「@HorseId」の馬は見つかりませんでした。</p> }
else
{
    <section class="card">
        <h2>@horse.RegisteredName</h2>
        <dl class="meta">
            <dt>HorseId</dt><dd><code>@horse.HorseId</code></dd>
            <dt>正規化名</dt><dd>@horse.NormalizedName</dd>
            <dt>性</dt><dd>@horse.SexCode</dd>
            <dt>生年月日</dt><dd>@(horse.BirthDate?.ToString("yyyy年M月d日") ?? "未登録")</dd>
            <dt>馬主</dt><dd>@(string.IsNullOrWhiteSpace(horse.OwnerName) ? "未登録" : horse.OwnerName)</dd>
        </dl>
    </section>

    @if (relationships.Count > 0)
    {
        <section class="entity-section">
            <h3>この馬に関係する人</h3>
            <div class="relationship-grid">
                @foreach (var relationship in relationships)
                {
                    <a class="relationship-link" href="@relationship.Url">
                        <span class="relationship-kind">@relationship.Kind</span>
                        <strong>@relationship.Name</strong>
                        <span class="hint">@relationship.Evidence</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="entity-section">
        <h3>出走履歴</h3>
        @if (raceHistory is null || raceHistory.Entries.Count == 0)
        {
            <p class="hint">出走履歴はありません。</p>
        }
        else
        {
            <ol class="history-list">
                @foreach (var entry in raceHistory.Entries.OrderByDescending(x => x.RaceDate))
                {
                    var race = Race(entry.RaceId);
                    <li class="history-item">
                        <div class="history-event">
                            <a class="history-race" href="@($"races/{Uri.EscapeDataString(entry.RaceId)}")">@(entry.RaceDate?.ToString("yyyy/MM/dd") ?? "日付未登録") @Display(entry.RacecourseCode)</a>
                            <span class="hint">@(race?.RaceName ?? FormatRaceConditions(entry.SurfaceCode, entry.DistanceMeters))</span>
                        </div>
                        <div class="history-result"><strong>@FormatFinish(entry.FinishPosition)</strong><span class="hint">@(entry.DeclaredWeight is null ? "馬体重 —" : $"馬体重 {entry.DeclaredWeight}kg")</span></div>
                        <div class="history-relations">
                            <div class="history-field"><span class="relationship-kind">騎手</span>@EntityLink("jockeys", entry.JockeyId, JockeyName(entry.JockeyId))</div>
                            <div class="history-field"><span class="relationship-kind">調教師</span>@EntityLink("trainers", entry.TrainerId, TrainerName(entry.TrainerId))</div>
                            <div class="history-field"><span class="relationship-kind">レース時点の馬主</span><span>@(RaceEntry(entry.RaceId)?.OwnerName ?? "—")</span></div>
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    @if (horse.Aliases.Count > 0)
    {
        <section class="card">
            <h3>別名</h3>
            <ul>
                @foreach (var a in horse.Aliases)
                {
                    <li><span class="pill">@a.AliasType</span> @a.AliasValue <span class="hint">(出典: @a.SourceName@(a.IsPrimary ? " / 主別名" : ""))</span></li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <h3>プロフィール更新</h3>
        <div class="form-grid">
            <label>登録名<input @bind="editRegisteredName" /></label>
            <label>正規化名<input @bind="editNormalizedName" /></label>
            <label>性<input @bind="editSexCode" /></label>
            <label>生年月日<input type="date" @bind="editBirthDate" /></label>
            <label>馬主<input @bind="editOwnerName" /></label>
        </div>
        <div class="toolbar">
            <button class="btn primary small" @onclick="UpdateProfileAsync" disabled="@updating">更新</button>
        </div>
        @if (updateErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in updateErrors) { <li>@e</li> }</ul>
        }
    </section>

    <section class="card">
        <h3>別名の追加・統合</h3>
        <div class="form-grid">
            <label>種別<input @bind="aliasType" placeholder="例: netkeiba" /></label>
            <label>値<input @bind="aliasValue" /></label>
            <label>出典<input @bind="aliasSourceName" /></label>
            <label><input type="checkbox" @bind="aliasIsPrimary" /> 主別名にする</label>
        </div>
        <div class="toolbar">
            <button class="btn primary small" @onclick="MergeAliasAsync" disabled="@mergingAlias">追加</button>
        </div>
        @if (aliasErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in aliasErrors) { <li>@e</li> }</ul>
        }
    </section>

    <section class="card">
        <h3>データ訂正</h3>
        <p class="hint">誤登録されたデータの訂正用です。理由の記録が残ります。</p>
        <div class="form-grid">
            <label>登録名<input @bind="correctRegisteredName" /></label>
            <label>正規化名<input @bind="correctNormalizedName" /></label>
            <label>性<input @bind="correctSexCode" /></label>
            <label>生年月日<input type="date" @bind="correctBirthDate" /></label>
            <label>訂正理由<input @bind="correctReason" /></label>
        </div>
        <div class="toolbar">
            <button class="btn primary small" @onclick="CorrectAsync" disabled="@correcting">訂正を保存</button>
        </div>
        @if (correctErrors.Count > 0)
        {
            <ul class="error-list">@foreach (var e in correctErrors) { <li>@e</li> }</ul>
        }
    </section>

    <MemoPanel SubjectType="Horse" SubjectId="@HorseId" />
}

@code {
    [Parameter] public string HorseId { get; set; } = string.Empty;

    private bool loading;
    private HorseProfileResponse? horse;
    private HorseRacingPrediction.Contracts.HorseRaceHistoryReadModel? raceHistory;
    private IReadOnlyDictionary<string, string> jockeyNames = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string> trainerNames = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, RaceResponse> races = new Dictionary<string, RaceResponse>();
    private IReadOnlyList<RelationshipItem> relationships = Array.Empty<RelationshipItem>();

    private string? editRegisteredName;
    private string? editNormalizedName;
    private string? editSexCode;
    private DateOnly? editBirthDate;
    private string? editOwnerName;
    private bool updating;
    private IReadOnlyList<string> updateErrors = Array.Empty<string>();

    private string? aliasType;
    private string? aliasValue;
    private string? aliasSourceName;
    private bool aliasIsPrimary;
    private bool mergingAlias;
    private IReadOnlyList<string> aliasErrors = Array.Empty<string>();

    private string? correctRegisteredName;
    private string? correctNormalizedName;
    private string? correctSexCode;
    private DateOnly? correctBirthDate;
    private string? correctReason;
    private bool correcting;
    private IReadOnlyList<string> correctErrors = Array.Empty<string>();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var profileTask = Api.GetHorseAsync(HorseId);
            var historyTask = Api.GetHorseRaceHistoryAsync(HorseId);
            await Task.WhenAll(profileTask, historyTask);
            horse = await profileTask;
            raceHistory = await historyTask;
            jockeyNames = await LoadJockeyNamesAsync(raceHistory);
            trainerNames = await LoadTrainerNamesAsync(raceHistory);
            races = await LoadRacesAsync(raceHistory?.Entries.Select(x => x.RaceId));
            relationships = BuildRelationships();
            if (horse is not null)
            {
                editRegisteredName = horse.RegisteredName;
                editNormalizedName = horse.NormalizedName;
                editSexCode = horse.SexCode;
                editBirthDate = horse.BirthDate;
                editOwnerName = horse.OwnerName;
            }
        }
        finally
        {
            loading = false;
        }
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private string JockeyName(string? jockeyId)
        => !string.IsNullOrWhiteSpace(jockeyId) && jockeyNames.TryGetValue(jockeyId, out var name) ? name : jockeyId ?? "—";

    private string TrainerName(string? trainerId)
        => !string.IsNullOrWhiteSpace(trainerId) && trainerNames.TryGetValue(trainerId, out var name) ? name : trainerId ?? "—";

    private RaceResponse? Race(string raceId) => races.GetValueOrDefault(raceId);
    private RaceEntryResponse? RaceEntry(string raceId) => Race(raceId)?.Entries.FirstOrDefault(x => x.HorseId == HorseId);

    private static string FormatFinish(int? position) => position is null ? "結果 —" : $"{position}着";
    private static string FormatRaceConditions(string? surface, int? distance)
        => $"{Display(surface)} / {(distance is null ? "距離未登録" : $"{distance}m")}";

    private RenderFragment EntityLink(string segment, string? id, string label) => builder =>
    {
        if (string.IsNullOrWhiteSpace(id)) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", $"{segment}/{Uri.EscapeDataString(id)}");
        builder.AddContent(3, label);
        builder.CloseElement();
    };

    private async Task<IReadOnlyDictionary<string, string>> LoadJockeyNamesAsync(
        HorseRacingPrediction.Contracts.HorseRaceHistoryReadModel? history)
    {
        if (history is null)
            return new Dictionary<string, string>();

        var ids = history.Entries
            .Select(x => x.JockeyId)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var profiles = await Task.WhenAll(ids.Select(id => Api.GetJockeyAsync(id)));
        return profiles
            .Where(x => x is not null)
            .ToDictionary(x => x!.JockeyId, x => x!.DisplayName, StringComparer.Ordinal);
    }

    private async Task<IReadOnlyDictionary<string, string>> LoadTrainerNamesAsync(HorseRacingPrediction.Contracts.HorseRaceHistoryReadModel? history)
    {
        var ids = history?.Entries.Select(x => x.TrainerId).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!).Distinct(StringComparer.Ordinal).ToList() ?? [];
        var profiles = await Task.WhenAll(ids.Select(id => Api.GetTrainerAsync(id)));
        return profiles.Where(x => x is not null).ToDictionary(x => x!.TrainerId, x => x!.DisplayName, StringComparer.Ordinal);
    }

    private async Task<IReadOnlyDictionary<string, RaceResponse>> LoadRacesAsync(IEnumerable<string>? raceIds)
    {
        var ids = raceIds?.Distinct(StringComparer.Ordinal).ToList() ?? [];
        var values = await Task.WhenAll(ids.Select(id => Api.GetRaceAsync(id)));
        return values.Where(x => x is not null).Select(x => x!).ToDictionary(x => x.RaceId, StringComparer.Ordinal);
    }

    private IReadOnlyList<RelationshipItem> BuildRelationships()
    {
        var entries = raceHistory?.Entries ?? [];
        var result = new List<RelationshipItem>();
        result.AddRange(entries.Where(x => !string.IsNullOrWhiteSpace(x.JockeyId)).GroupBy(x => x.JockeyId!).OrderByDescending(x => x.Count()).Take(3)
            .Select(x => new RelationshipItem("騎乗した騎手", JockeyName(x.Key), $"{x.Count()}戦", $"jockeys/{Uri.EscapeDataString(x.Key)}")));
        result.AddRange(entries.Where(x => !string.IsNullOrWhiteSpace(x.TrainerId)).GroupBy(x => x.TrainerId!).OrderByDescending(x => x.Count()).Take(3)
            .Select(x => new RelationshipItem("レース時点の調教師", TrainerName(x.Key), $"{x.Count()}戦", $"trainers/{Uri.EscapeDataString(x.Key)}")));
        return result;
    }

    private sealed record RelationshipItem(string Kind, string Name, string Evidence, string Url);

    private async Task UpdateProfileAsync()
    {
        updating = true;
        try
        {
            var result = await Api.UpdateHorseProfileAsync(HorseId, new UpdateHorseProfileRequest(
                editRegisteredName, editNormalizedName, editSexCode, editBirthDate, editOwnerName));
            updateErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success) await LoadAsync();
        }
        finally
        {
            updating = false;
        }
    }

    private async Task MergeAliasAsync()
    {
        if (string.IsNullOrWhiteSpace(aliasType) || string.IsNullOrWhiteSpace(aliasValue) || string.IsNullOrWhiteSpace(aliasSourceName))
        {
            aliasErrors = new[] { "種別・値・出典はすべて必須です。" };
            return;
        }

        mergingAlias = true;
        try
        {
            var result = await Api.MergeHorseAliasAsync(HorseId, new MergeAliasRequest(
                aliasType!, aliasValue!, aliasSourceName!, aliasIsPrimary));
            aliasErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success)
            {
                aliasType = null; aliasValue = null; aliasSourceName = null; aliasIsPrimary = false;
                await LoadAsync();
            }
        }
        finally
        {
            mergingAlias = false;
        }
    }

    private async Task CorrectAsync()
    {
        correcting = true;
        try
        {
            var result = await Api.CorrectHorseDataAsync(HorseId, new CorrectHorseDataRequest(
                correctRegisteredName, correctNormalizedName, correctSexCode, correctBirthDate, correctReason));
            correctErrors = result.Success ? Array.Empty<string>() : result.Errors;
            if (result.Success)
            {
                correctRegisteredName = null; correctNormalizedName = null; correctSexCode = null;
                correctBirthDate = null; correctReason = null;
                await LoadAsync();
            }
        }
        finally
        {
            correcting = false;
        }
    }
}
