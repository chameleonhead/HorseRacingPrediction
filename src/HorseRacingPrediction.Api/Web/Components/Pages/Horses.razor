@page "/horses"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsPageHeader Section="データ" Title="馬" Description="収集済みの馬プロフィールを検索します。" />

<FluentCard class="filter-card">
    <div class="filter-grid">
        <FluentTextField Label="キーワード" @bind-Value="query" Placeholder="馬名 / ID" />
        <label>性<select @bind="sexCode"><option value="">指定なし</option><option value="M">牡</option><option value="F">牝</option><option value="G">セン</option></select></label>
        <label>年齢（以上）<input type="number" @bind="minAge" min="0" max="40" /></label>
        <label>年齢（以下）<input type="number" @bind="maxAge" min="0" max="40" /></label>
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">検索</FluentButton>
    </div>
</FluentCard>

@if (loading && result is null) { <UiState Kind="loading" Title="馬を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する馬はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading) { <p class="hint">検索中… 直前の結果を表示しています。</p> }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <RaceOpsObjectList Label="馬一覧">
        @foreach (var h in result.Items)
        {
            <RaceOpsObjectListItem Href="@HorseUrl(h.HorseId)" Title="@h.RegisteredName" Description="@h.HorseId" Metadata="@HorseMetadata(h)" />
        }
    </RaceOpsObjectList>
    <Pagination TotalCount="result.TotalCount" Page="page" PageSize="pageSize" PageChanged="GoAsync" />
}

@code {
    private string? query;
    private string? sexCode;
    private int? minAge;
    private int? maxAge;
    private int page = 1;
    private const int pageSize = 50;
    private bool loading;
    private PagedResponse<HorseSummaryResponse>? result;

    protected override async Task OnInitializedAsync()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        query = ParseText(q, "query");
        sexCode = ParseText(q, "sex");
        if (int.TryParse(ParseText(q, "minAge"), out var requestedMinAge) && requestedMinAge >= 0) minAge = requestedMinAge;
        if (int.TryParse(ParseText(q, "maxAge"), out var requestedMaxAge) && requestedMaxAge >= 0) maxAge = requestedMaxAge;
        if (int.TryParse(ParseText(q, "page"), out var p) && p > 0) page = p;
        await LoadAsync();
    }

    private async Task SearchAsync() { page = 1; await LoadAsync(); }
    private async Task LoadAsync()
    {
        UpdateUrl();
        loading = true;
        try { result = await Api.SearchHorsesAsync(new SearchHorsesRequest { Query = query, SexCode = sexCode, BirthDateFrom = BirthDateFrom, BirthDateTo = BirthDateTo, Page = page, PageSize = pageSize }); }
        finally { loading = false; }
    }
    private async Task GoAsync(int value) { page = value; await LoadAsync(); }
    private void UpdateUrl() => NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/horses", new Dictionary<string, string?> { ["query"] = query, ["sex"] = sexCode, ["minAge"] = minAge?.ToString(), ["maxAge"] = maxAge?.ToString(), ["page"] = page.ToString() }.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    private DateOnly? BirthDateFrom => maxAge is null ? null : DateOnly.FromDateTime(DateTime.Today).AddYears(-(maxAge.Value + 1)).AddDays(1);
    private DateOnly? BirthDateTo => minAge is null ? null : DateOnly.FromDateTime(DateTime.Today).AddYears(-minAge.Value);
    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string? ParseText(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> q, string key) => q.TryGetValue(key, out var value) ? value.ToString() : null;
    private void OpenHorse(string id) => Navigation.NavigateTo(HorseUrl(id));
    private void OpenHorseFromKey(KeyboardEventArgs e, string id) { if (e.Key is "Enter" or " ") OpenHorse(id); }
    private static string HorseUrl(string id) => $"/horses/{Uri.EscapeDataString(id)}";
    private static string HorseMetadata(HorseSummaryResponse horse) => $"性 {horse.SexCode ?? "—"} · 生年月日 {(horse.BirthDate?.ToString("yyyy/MM/dd") ?? "—")} · 別名 {horse.AliasCount} 件";
}
