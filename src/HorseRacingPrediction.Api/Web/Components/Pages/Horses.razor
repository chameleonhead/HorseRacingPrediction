@page "/horses"
@attribute [Authorize]
@inject AdminApiClient Api

<h1>馬検索</h1>
<div class="toolbar">
    <label>キーワード: <input @bind="query" placeholder="馬名 / ID" /></label>
    <label>
        性:
        <select @bind="sexCode">
            <option value="">(指定なし)</option>
            <option value="M">牡</option>
            <option value="F">牝</option>
            <option value="G">セン</option>
        </select>
    </label>
    <button class="btn primary" @onclick="LoadAsync">検索</button>
</div>

@if (loading && result is null) { <UiState Kind="loading" Title="馬を読み込んでいます" /> }
else if (result is null || result.Items.Count == 0) { <UiState Title="該当する馬はありません" Message="検索条件を変更してお試しください。" /> }
else
{
    @if (loading)
    {
        <p class="hint">検索中… 直前の結果を表示しています。</p>
    }
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <div class="object-list">
        @foreach (var h in result.Items)
        {
            <article class="object-row">
                <div class="object-primary"><a href="@($"horses/{Uri.EscapeDataString(h.HorseId)}")">@h.RegisteredName</a><span class="hint">@h.HorseId</span></div>
                <div><span class="object-label">性</span>@(h.SexCode ?? "—")</div>
                <div><span class="object-label">生年月日</span>@(h.BirthDate?.ToString("yyyy/MM/dd") ?? "—")</div>
                <div><span class="object-label">別名</span>@h.AliasCount 件</div>
            </article>
        }
    </div>
    <div class="toolbar">
        <button class="btn" disabled="@(page <= 1)" @onclick="() => GoAsync(page - 1)">前</button>
        <span>@(page) / @result.TotalPages</span>
        <button class="btn" disabled="@(page >= result.TotalPages)" @onclick="() => GoAsync(page + 1)">次</button>
    </div>
}

@code {
    private string? query;
    private string? sexCode;
    private int page = 1;
    private int pageSize = 50;
    private bool loading;
    private PagedResponse<HorseSummaryResponse>? result;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            result = await Api.SearchHorsesAsync(new SearchHorsesRequest
            {
                Query = query,
                SexCode = sexCode,
                Page = page,
                PageSize = pageSize
            });
        }
        finally
        {
            loading = false;
        }
    }

    private async Task GoAsync(int p) { page = p; await LoadAsync(); }
}
