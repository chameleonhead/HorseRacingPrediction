@page "/jobs/{JobId}"
@attribute [Authorize]
@inject AdminApiClient Api
@using System.Text.Json

@if (loading) { <UiState Kind="loading" Title="収集ジョブを読み込んでいます" /> }
else if (job is null) { <UiState Kind="error" Title="収集ジョブが見つかりません" Message="@NotFoundMessage" /> }
else
{
    <RaceOpsObjectHeader BackHref="/jobs" BackLabel="← 収集ジョブ一覧に戻る" Title="@DisplayJobType(job.JobType)" Section="運用 / 収集ジョブ" Description="@HeaderDescription" Status="@StatusLabel(job.Status)" StatusTone="@StatusTone(job.Status)">
        <Actions>
            @if (CanRerun) { <FluentButton Appearance="@Appearance.Accent" OnClick="@(() => showRerunDialog = true)">リラン</FluentButton> }
        </Actions>
    </RaceOpsObjectHeader>
    @if (!string.IsNullOrWhiteSpace(job.LastError))
    {
        <RaceOpsAlert Title="最新の実行に失敗しました" Message="@job.LastError" />
    }
    <FluentCard class="detail-card detail-section"><h2>基本情報</h2><dl class="detail-grid"><dt>状態</dt><dd>@StatusLabel(job.Status)</dd><dt>優先度</dt><dd>@job.Priority</dd><dt>試行回数</dt><dd>@job.AttemptCount</dd><dt>更新日時</dt><dd>@job.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></dl></FluentCard>
    <section class="entity-section detail-section"><h2>関連</h2>
        <div class="relationship-list">
            @if (TargetRaceId is not null)
            {
                <div class="relationship-row"><span>対象レース</span><a href="@RaceUrl(TargetRaceId)">対象レースを見る</a><span class="hint">@TargetRaceId</span></div>
            }
            @if (TargetDate is not null)
            {
                <div class="relationship-row"><span>対象日</span><a href="@JobsByDateUrl(TargetDate)">同じ対象日の収集ジョブを見る</a><span class="hint">@TargetDate</span></div>
            }
            <div class="relationship-row"><span>診断</span><FluentButton Appearance="@Appearance.Stealth" OnClick="@ShowTechnicalDetails">技術情報を確認</FluentButton><span class="hint">Job ID、payload、error</span></div>
        </div>
    </section>
    <FluentCard class="detail-card detail-section"><h2>ジョブの関係</h2>
        <div class="job-map" aria-label="ジョブの関連">
            @{ var hasGeneratedRelation = (job.ParentJob is not null && job.ParentRelationType == JobRelationType.GeneratedBy) || GeneratedChildren.Count > 0; }
            @if (hasGeneratedRelation)
            {
                <section class="job-map-group">
                    <h3>生成経路</h3>
                    <p>生成元はこのジョブを作成しますが、完了は待ちません。</p>
                    @if (job.ParentJob is not null && job.ParentRelationType == JobRelationType.GeneratedBy)
                    {
                        <a class="job-map-link" href="@JobUrl(job.ParentJob.JobId)"><span><strong>@DisplayJobType(job.ParentJob.JobType)</strong><small>生成元</small></span><span class="badge @StatusClass(job.ParentJob.Status)">@StatusLabel(job.ParentJob.Status)</span></a>
                    }
                    @foreach (var child in GeneratedChildren)
                    {
                        <a class="job-map-link" href="@JobUrl(child.JobId)"><span><strong>@DisplayJobType(child.JobType)</strong><small>生成したジョブ・生成元の完了条件ではありません</small></span><span class="badge @StatusClass(child.Status)">@StatusLabel(child.Status)</span></a>
                    }
                </section>
                <div class="job-map-connector generated"><span>生成</span></div>
            }
            <section class="job-map-current">
                <p class="eyebrow">現在のジョブ@(job.ParentRelationType == JobRelationType.AggregatedBy || AggregatedChildren.Count > 0 ? "・集約親" : hasGeneratedRelation ? "・生成元" : string.Empty)</p>
                <strong>@DisplayJobType(job.JobType)</strong>
                <small>@job.DeduplicationKey</small>
                <span class="badge @StatusClass(job.Status)">@StatusLabel(job.Status)</span>
            </section>
            @{ var hasAggregateRelation = (job.ParentJob is not null && job.ParentRelationType == JobRelationType.AggregatedBy) || AggregatedChildren.Count > 0; }
            @if (hasAggregateRelation)
            {
                <div class="job-map-connector aggregate"><span>完了待ち</span></div>
                <section class="job-map-group">
                    <h3>集約依存関係</h3>
                    <p>すべての対象が終端状態になるまで、現在のジョブは完了しません。</p>
                    @if (job.ParentJob is not null && job.ParentRelationType == JobRelationType.AggregatedBy)
                    {
                        <a class="job-map-link" href="@JobUrl(job.ParentJob.JobId)"><span><strong>@DisplayJobType(job.ParentJob.JobType)</strong><small>集約元</small></span><span class="badge @StatusClass(job.ParentJob.Status)">@StatusLabel(job.ParentJob.Status)</span></a>
                    }
                    @if (AggregatedChildren.Count > 0)
                    {
                        <div class="job-map-summary">
                            <span>全@AggregatedChildren.Count件</span>
                            <span><strong>@AggregatedChildren.Count(x => x.Status == AgentJobStatus.Succeeded)件</strong> 完了</span>
                            <span><strong>@AggregatedChildren.Count(x => x.Status is AgentJobStatus.Failed or AgentJobStatus.DeadLetter)件</strong> 要対応</span>
                        </div>
                        <div class="job-map-children">
                            @foreach (var child in AggregatedChildren)
                            {
                                <a class="job-map-link" href="@JobUrl(child.JobId)"><span><strong>@DisplayJobType(child.JobType)</strong><small>集約対象</small></span><span class="badge @StatusClass(child.Status)">@StatusLabel(child.Status)</span></a>
                            }
                        </div>
                    }
                    else { <p class="hint">完了を待つ子ジョブはありません。</p> }
                    <p class="hint">集約対象がある親ジョブだけをリラン対象にします。子ジョブ単独のリランは表示しません。</p>
                </section>
            }
        </div>
    </FluentCard>
    <section class="entity-section detail-section"><h2>最新の試行</h2>
        @if (LatestAttempt is null) { <p class="hint">試行履歴はありません。</p> }
        else { <article class="attempt-list"><strong>試行 @LatestAttempt.AttemptNumber</strong><span class="badge @StatusClass(LatestAttempt.Status)">@StatusLabel(LatestAttempt.Status)</span><time>@LatestAttempt.StartedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</time>@if (!string.IsNullOrWhiteSpace(LatestAttempt.Error)) { <p>@LatestAttempt.Error</p> }</article> }
        <details><summary>すべての試行を表示（@job.Attempts.Count 件）</summary><div class="attempt-list">@foreach (var attempt in job.Attempts) { <article><strong>試行 @attempt.AttemptNumber</strong><span class="badge @StatusClass(attempt.Status)">@StatusLabel(attempt.Status)</span><time>@attempt.StartedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</time>@if (!string.IsNullOrWhiteSpace(attempt.Error)) { <pre>@attempt.Error</pre> }</article> }</div></details>
    </section>
    <FluentCard id="technical-details" class="detail-card detail-section"><h2>技術情報</h2><details open="@technicalDetailsOpen"><summary>Job ID、payload、完全なエラーを表示</summary><dl class="detail-grid"><dt>Job ID</dt><dd><code>@job.JobId</code></dd><dt>JobType</dt><dd><code>@job.JobType</code></dd><dt>DeduplicationKey</dt><dd><code>@job.DeduplicationKey</code></dd><dt>AvailableAt</dt><dd>@job.AvailableAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd><dt>Lease</dt><dd>@job.LeaseExpiresAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</dd></dl><pre class="payload">@job.Payload</pre>@if (!string.IsNullOrWhiteSpace(job.LastError)) { <pre class="payload">@job.LastError</pre> }</details></FluentCard>
    @if (!CanRerun && (job.Status is AgentJobStatus.Failed or AgentJobStatus.DeadLetter) && job.ParentRelationType == JobRelationType.AggregatedBy)
    { <p class="hint">このジョブは集約対象です。集約元ジョブから復旧してください。</p> }
}

<FluentDialog Hidden="@(!showRerunDialog || job is null)" HiddenChanged="@(hidden => showRerunDialog = !hidden)" Modal="true" TrapFocus="true" AriaLabelledby="rerun-title" Style="width:min(520px, calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="true"><h2 id="rerun-title">この収集ジョブをリランしますか</h2></FluentDialogHeader>
    <FluentDialogBody><p>親ジョブが必要な対象を再確認し、失敗した対象と前回未作成だった対象を投入します。成功済み・実行中・待機中の対象は維持します。</p><FluentTextArea Label="理由（任意）" @bind-Value="reason" /></FluentDialogBody>
    <FluentDialogFooter><FluentButton OnClick="@(() => showRerunDialog = false)">キャンセル</FluentButton><FluentButton Appearance="@Appearance.Accent" OnClick="@RerunAsync">リラン</FluentButton></FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter] public string JobId { get; set; } = string.Empty;
    private string NotFoundMessage => $"Job ID「{JobId}」は削除されたか、URLが正しくありません。";
    private AgentJobDetailReadModel? job;
    private bool loading = true;
    private bool showRerunDialog;
    private bool technicalDetailsOpen;
    private string? reason;
    protected override async Task OnParametersSetAsync() { loading = true; job = await Api.GetJobAsync(JobId); loading = false; }
    private IReadOnlyList<AgentRelatedJobReadModel> GeneratedChildren => job?.ChildJobs.Where(x => x.RelationType == JobRelationType.GeneratedBy).ToList() ?? [];
    private IReadOnlyList<AgentRelatedJobReadModel> AggregatedChildren => job?.ChildJobs.Where(x => x.RelationType == JobRelationType.AggregatedBy).ToList() ?? [];
    private JobAttemptReadModel? LatestAttempt => job?.Attempts.OrderByDescending(x => x.AttemptNumber).FirstOrDefault();
    private string? TargetRaceId => TryGetPayloadValue("RaceId") ?? TryGetPayloadValue("RequestedByRaceId");
    private string? TargetDate => TryGetPayloadValue("RaceDate") ?? TryGetPayloadValue("TargetDate") ?? ExtractTargetDate(job?.DeduplicationKey);
    private bool CanRerun => job is not null
        && job.Status is AgentJobStatus.Failed or AgentJobStatus.DeadLetter
        && job.ParentRelationType != JobRelationType.AggregatedBy;
    private async Task RerunAsync() { if (job is null) return; var result = await Api.RerunJobAsync(job.JobId, job.UpdatedAt, reason); if (result.Success) { showRerunDialog = false; job = await Api.GetJobAsync(job.JobId); } }
    private void ShowTechnicalDetails() => technicalDetailsOpen = true;
    private static string JobUrl(string id) => $"/jobs/{Uri.EscapeDataString(id)}";
    private static string RaceUrl(string id) => $"/races/{Uri.EscapeDataString(id)}";
    private static string JobsByDateUrl(string date) => $"/jobs?targetDate={Uri.EscapeDataString(date)}";
    private string HeaderDescription => TargetDate is { } date ? $"対象日 {date}・更新 {job?.UpdatedAt.ToLocalTime():yyyy/MM/dd HH:mm}" : $"更新 {job?.UpdatedAt.ToLocalTime():yyyy/MM/dd HH:mm}";
    private static string DisplayJobType(string value) => value switch { "ResultMonthDiscoveryRequest" => "月次レース結果の確認", "RaceResultCollectionRequest" => "レース結果の収集", "RaceCardCollectionRequest" => "出走表の収集", _ => value.Replace('-', ' ') };
    private static string StatusClass(AgentJobStatus status) => status switch { AgentJobStatus.Succeeded => "ok", AgentJobStatus.Failed or AgentJobStatus.DeadLetter => "bad", AgentJobStatus.Running => "info", _ => "warn" };
    private static string StatusLabel(AgentJobStatus status) => status switch { AgentJobStatus.Succeeded => "完了", AgentJobStatus.Failed => "失敗", AgentJobStatus.DeadLetter => "要対応", AgentJobStatus.Running => "実行中", AgentJobStatus.Ready => "待機中", AgentJobStatus.WaitingDependency => "依存待ち", _ => status.ToString() };
    private static string StatusTone(AgentJobStatus status) => status switch { AgentJobStatus.Succeeded => "success", AgentJobStatus.Failed or AgentJobStatus.DeadLetter => "danger", AgentJobStatus.Running => "info", AgentJobStatus.WaitingDependency => "warning", _ => "neutral" };
    private string? TryGetPayloadValue(string propertyName)
    {
        if (job is null || string.IsNullOrWhiteSpace(job.Payload)) return null;
        try
        {
            using var document = JsonDocument.Parse(job.Payload);
            if (document.RootElement.TryGetProperty(propertyName, out var value))
                return value.ValueKind == JsonValueKind.String ? value.GetString() : value.ToString();
        }
        catch (JsonException) { }

        return null;
    }

    private static string? ExtractTargetDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var match = System.Text.RegularExpressions.Regex.Match(value, @"\d{4}-\d{2}-\d{2}");
        return match.Success ? match.Value : null;
    }
}
