@page "/jobs/{ResourceTypeName}/{Provider}/{ResourceId}/{DefinitionId}"
@attribute [Authorize]
@inject AdminApiClient Api
@inject IJSRuntime JS

<RaceOpsObjectHeader BackHref="@BackHref" BackLabel="← 収集管理に戻る" Title="@DefinitionLabel" Section="運用 / 収集管理" Description="@ResourceDescription" Status="@StatusLabel" StatusTone="@StatusTone">
    <Actions><FluentButton OnClick="LoadAsync" Disabled="busy">更新</FluentButton><FluentButton Appearance="@Appearance.Accent" OnClick="RequestAsync" Disabled="@(busy || detail is null)">通常の方法で再取得</FluentButton></Actions>
</RaceOpsObjectHeader>

@if (loading) { <UiState Kind="loading" Title="収集詳細を読み込んでいます" /> }
else if (errors.Count > 0) { <UiState Kind="error" Title="収集詳細を表示できません" Message="@string.Join(" ", errors)" /> }
else if (detail is not null)
{
    @if (!string.IsNullOrWhiteSpace(operationMessage))
    {
        <FluentMessageBar Intent="@MessageIntent.Success" Title="@operationMessage" />
    }
    @if (operationErrors.Count > 0)
    {
        <UiState Kind="error" Title="操作を完了できません" Message="@string.Join(" ", operationErrors)" />
    }
    <section class="profile-facts" aria-label="収集処理の概要">
        <div class="profile-fact"><span>現在の処理</span><strong>@CurrentTaskLabel</strong></div>
        <div class="profile-fact"><span>保存データ</span><strong>@StoredDataLabel</strong></div>
        <div class="profile-fact"><span>障害対応</span><strong>@ActiveFailureLabel</strong></div>
        <div class="profile-fact"><span>抽出仕様</span><strong>適用 @(detail.State?.AppliedRevision ?? 0) / 必要 @(detail.State?.RequiredRevision ?? LatestTask?.RequestedRevision ?? 1)</strong></div>
        <div class="profile-fact"><span>最終取得</span><strong>@Time(detail.State?.LastCollectedAt)</strong></div>
        <div class="profile-fact"><span>次回予定</span><strong>@Time(detail.State?.NextCollectionAt)</strong></div>
    </section>
    @if (LatestTask is { } currentTask && IsActive(currentTask.Status))
    {
        <FluentMessageBar Intent="@MessageIntent.Info" Title="@ActiveTaskTitle(currentTask.Status)">
            @if (detail.State?.LastCollectedAt is not null)
            {
                <span>前回取得済みのデータは利用できます。最終取得: @Time(detail.State.LastCollectedAt)</span>
            }
            else
            {
                <span>初回の取得が完了するまでお待ちください。</span>
            }
        </FluentMessageBar>
    }
    @if (DomainUrl is not null)
    {
        <div class="action-row"><FluentButton Href="@DomainUrl">@ResourceTypeLabel の業務データを開く</FluentButton></div>
    }

    @if (ActiveFailure is { } activeFailure)
    {
        var failedAttempt = ActiveFailureAttempt;
        var advice = CollectionErrorPresentation.Describe(activeFailure.ErrorCode, activeFailure.ErrorMessage);
        <section class="latest-error @(activeFailure.ResolutionStatus == CollectionFailureResolutionStatus.RecoveryInProgress ? "recovery" : null)" aria-labelledby="latest-error-title">
            <div class="latest-error-heading"><div><span class="eyebrow">未解決の障害</span><h2 id="latest-error-title">@advice.Title</h2></div><RaceOpsStatusBadge Label="@FailureStatusLabel(activeFailure.ResolutionStatus)" Tone="@(activeFailure.ResolutionStatus == CollectionFailureResolutionStatus.Open ? "danger" : "warning")" /></div>
            <p>@advice.Explanation</p>
            <div class="suggested-action"><strong>推奨する対応</strong><span>@advice.SuggestedAction</span></div>
            <div class="url-evidence"><UrlEvidence Label="要求URL" Value="@failedAttempt?.RequestedUrl" /><UrlEvidence Label="最終URL" Value="@failedAttempt?.FinalUrl" /></div>
            <details><summary>技術情報を表示</summary><dl class="technical-details"><dt>エラーコード</dt><dd><code>@(activeFailure.ErrorCode ?? "—")</code></dd><dt>詳細</dt><dd><pre>@(activeFailure.ErrorMessage ?? "—")</pre></dd><dt>HTTP</dt><dd>@(failedAttempt?.HttpStatusCode?.ToString() ?? "—")</dd><dt>ページ判定</dt><dd>@(failedAttempt?.PageIdentification ?? "—")</dd><dt>実行バッチ</dt><dd>@(failedAttempt?.ExecutionBatchId?.ToString("D") ?? "—")</dd></dl></details>
        </section>
    }

    <RaceOpsDetailTabs>
        <FluentTab Label="概要" Id="overview"><section class="detail-card detail-section"><h2>収集対象</h2><dl class="meta"><dt>種類</dt><dd>@ResourceTypeLabel</dd><dt>提供元</dt><dd>@Provider</dd><dt>対象ID</dt><dd><code>@ResourceId</code></dd><dt>収集内容</dt><dd>@DefinitionLabel</dd><dt>処理区分</dt><dd>@(LatestTask is null ? "—" : LaneLabel(LatestTask.Lane))</dd><dt>優先度</dt><dd>@(LatestTask?.Priority.ToString() ?? "—")</dd></dl></section></FluentTab>
        <FluentTab Label="@($"依頼履歴 ({detail.RequestTotal})")" Id="requests"><section class="entity-section detail-section"><h2>収集依頼の履歴</h2><p class="section-description">この情報が、いつ、どの理由で収集対象になったかを確認できます。</p>@if(detail.Requests.Count==0){<UiState Title="収集依頼はまだありません" />}else{<FluentDataGrid Items="@detail.Requests.AsQueryable()" TGridItem="CollectionRequestSummary" aria-label="収集依頼の履歴"><TemplateColumn Title="依頼日時">@Time(context.RequestedAt)</TemplateColumn><TemplateColumn Title="理由">@ReasonLabel(context.Reason)</TemplateColumn><TemplateColumn Title="抽出仕様">版 @context.RequestedRevision</TemplateColumn><TemplateColumn Title="Backfill">@(context.BatchId??"—")</TemplateColumn><TemplateColumn Title="取得先指定">@if(string.IsNullOrWhiteSpace(context.ExplicitUrl)){<span>なし</span>}else{<span class="history-url"><a href="@context.ExplicitUrl" target="_blank" rel="noopener noreferrer">@context.ExplicitUrl</a><FluentButton Appearance="@Appearance.Stealth" OnClick="@(() => CopyUrlAsync(context.ExplicitUrl!))">コピー</FluentButton></span>}</TemplateColumn></FluentDataGrid>}@if(RequestHistoryPages>1){<nav class="pagination" aria-label="依頼履歴ページ"><FluentButton OnClick="PreviousRequestHistoryAsync" Disabled="@(busy || requestHistoryPage<=1)">前へ</FluentButton><span>@requestHistoryPage / @RequestHistoryPages ページ</span><FluentButton OnClick="NextRequestHistoryAsync" Disabled="@(busy || requestHistoryPage>=RequestHistoryPages)">次へ</FluentButton></nav>}</section></FluentTab>
        <FluentTab Label="@($"タスク履歴 ({detail.TaskTotal})")" Id="tasks"><section class="entity-section detail-section"><h2>実行タスクの履歴</h2><p class="section-description">現在の実行状態と、同じ対象に対して作成された過去のタスクを確認できます。</p>@if(detail.Tasks.Count==0){<UiState Title="実行タスクはまだありません" />}else{<FluentDataGrid Items="@detail.Tasks.AsQueryable()" TGridItem="CollectionTaskSummary" aria-label="実行タスクの履歴"><TemplateColumn Title="状態">@TaskStatusLabel(context.Status)</TemplateColumn><TemplateColumn Title="実行可能日時">@Time(context.AvailableAt)</TemplateColumn><TemplateColumn Title="処理区分">@LaneLabel(context.Lane)</TemplateColumn><TemplateColumn Title="優先度">@context.Priority</TemplateColumn><TemplateColumn Title="試行回数">@context.AttemptCount</TemplateColumn><TemplateColumn Title="操作">@if(IsActive(context.Status)){<FluentButton OnClick="@(() => CancelAsync(context))" Disabled="busy">このタスクを取り消す</FluentButton>}else{<span>—</span>}</TemplateColumn></FluentDataGrid>}@if(TaskHistoryPages>1){<nav class="pagination" aria-label="タスク履歴ページ"><FluentButton OnClick="PreviousTaskHistoryAsync" Disabled="@(busy || taskHistoryPage<=1)">前へ</FluentButton><span>@taskHistoryPage / @TaskHistoryPages ページ</span><FluentButton OnClick="NextTaskHistoryAsync" Disabled="@(busy || taskHistoryPage>=TaskHistoryPages)">次へ</FluentButton></nav>}</section></FluentTab>
        <FluentTab Label="@($"試行履歴 ({detail.AttemptTotal})")" Id="attempts"><section class="entity-section detail-section"><h2>失敗・試行履歴</h2>@if(detail.Attempts.Count==0){<UiState Title="実行履歴はまだありません" />}else{<FluentDataGrid Items="@detail.Attempts.AsQueryable()" TGridItem="CollectionAttemptSummary" aria-label="試行履歴"><PropertyColumn Property="@(x=>x.AttemptNumber)" Title="回" /><TemplateColumn Title="結果">@AttemptResultLabel(context.Result)</TemplateColumn><TemplateColumn Title="開始">@Time(context.StartedAt)</TemplateColumn><TemplateColumn Title="処理時間">@Duration(context)</TemplateColumn><TemplateColumn Title="HTTP">@(context.HttpStatusCode?.ToString()??"—")</TemplateColumn><TemplateColumn Title="詳細"><details class="attempt-detail"><summary>確認</summary><dl><dt>要求URL</dt><dd>@(context.RequestedUrl??"記録なし")</dd><dt>最終URL</dt><dd>@(context.FinalUrl??"記録なし")</dd><dt>ページ判定</dt><dd>@(context.PageIdentification??"記録なし")</dd><dt>エラー</dt><dd><pre>@($"{context.ErrorCode ?? "未分類"}\n{context.ErrorMessage}")</pre></dd><dt>実行バッチ</dt><dd>@if(context.ExecutionBatchId is { } batchId){<a href="@BatchUrl(batchId)" title="@BatchTrace(context)">@ShortId(batchId)（@(context.BatchTaskOrdinal ?? 0)/@(context.BatchTaskCount ?? 0)）</a>}else{<span>記録なし</span>}</dd></dl></details></TemplateColumn></FluentDataGrid>}@if(AttemptHistoryPages>1){<nav class="pagination" aria-label="試行履歴ページ"><FluentButton OnClick="PreviousAttemptHistoryAsync" Disabled="@(busy || attemptHistoryPage<=1)">前へ</FluentButton><span>@attemptHistoryPage / @AttemptHistoryPages ページ</span><FluentButton OnClick="NextAttemptHistoryAsync" Disabled="@(busy || attemptHistoryPage>=AttemptHistoryPages)">次へ</FluentButton></nav>}</section></FluentTab>
        <FluentTab Label="@($"障害履歴 ({detail.Failures?.Count ?? 0})")" Id="failures"><section class="entity-section detail-section"><h2>障害対応の履歴</h2><p class="section-description">通知の配信とは別に、障害が要対応・対応中・解決済みのどこにあるかを確認できます。</p>@if(detail.Failures is not { Count: > 0 }){<UiState Title="障害履歴はありません" />}else{<FluentDataGrid Items="@detail.Failures.AsQueryable()" TGridItem="PendingCollectionFailureNotification" aria-label="障害対応の履歴"><TemplateColumn Title="対応状態">@FailureStatusLabel(context.ResolutionStatus)</TemplateColumn><TemplateColumn Title="発生日時">@Time(context.FailedAt)</TemplateColumn><TemplateColumn Title="エラー">@(context.ErrorCode??"—") @context.ErrorMessage</TemplateColumn><TemplateColumn Title="対応開始">@Time(context.RecoveryStartedAt)</TemplateColumn><TemplateColumn Title="解決日時">@Time(context.ResolvedAt)</TemplateColumn></FluentDataGrid>}</section></FluentTab>
        <FluentTab Label="@($"取得先 ({detail.Locations.Count})")" Id="locations"><section class="entity-section detail-section"><h2>取得先候補</h2>@if(detail.Locations.Count==0){<UiState Title="保存済みの取得先候補はありません" Message="実行時にURLの生成または探索を行います。" />}else{<FluentDataGrid Items="@detail.Locations.AsQueryable()" TGridItem="ResourceLocationCandidate" aria-label="取得先候補"><PropertyColumn Property="@(x=>x.Url)" Title="URL" /><TemplateColumn Title="発見方法">@LocationSourceLabel(context.Source)</TemplateColumn><TemplateColumn Title="状態">@LocationStatusLabel(context.Status)</TemplateColumn><TemplateColumn Title="最終確認">@Time(context.LastVerifiedAt)</TemplateColumn></FluentDataGrid>}</section></FluentTab>
        <FluentTab Label="管理" Id="management"><section class="detail-card detail-section"><h2>取得先を指定して再取得</h2><p>保存済みの取得先や自動探索を使わず、調査対象のURLを明示したい場合だけ使用します。通常の再取得はページ上部から依頼してください。</p><FluentTextField Label="取得先URL" Placeholder="https://..." @bind-Value="explicitUrl" /><div class="action-row"><FluentButton Appearance="@Appearance.Accent" OnClick="RequestWithExplicitUrlAsync" Disabled="@(busy || string.IsNullOrWhiteSpace(explicitUrl))">指定したURLで再取得</FluentButton></div>@if(requestErrors.Count>0){<UiState Kind="error" Title="再取得を依頼できません" Message="@string.Join(" ",requestErrors)" />}</section></FluentTab>
    </RaceOpsDetailTabs>
}

@code {
    [Parameter] public string ResourceTypeName { get; set; } = string.Empty;
    [Parameter] public string Provider { get; set; } = string.Empty;
    [Parameter] public string ResourceId { get; set; } = string.Empty;
    [Parameter] public string DefinitionId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private bool loading, busy; private int requestHistoryPage=1,taskHistoryPage=1,attemptHistoryPage=1; private const int HistoryPageSize=25; private CollectionResourceDetail? detail; private string? explicitUrl, operationMessage; private IReadOnlyList<string> errors=[],requestErrors=[],operationErrors=[];
    private ResourceType? Type=>Enum.TryParse<ResourceType>(ResourceTypeName,true,out var value)?value:null;
    private CollectionTaskSummary? LatestTask=>detail?.LatestTask;
    private PendingCollectionFailureNotification? ActiveFailure=>detail?.Failures?.Where(x=>x.ResolutionStatus is CollectionFailureResolutionStatus.Open or CollectionFailureResolutionStatus.RecoveryInProgress).OrderByDescending(x=>x.FailedAt).FirstOrDefault();
    private CollectionAttemptSummary? ActiveFailureAttempt=>ActiveFailure is null?null:detail?.Attempts.Where(x=>x.TaskId==ActiveFailure.TaskId).OrderByDescending(x=>x.StartedAt).FirstOrDefault();
    private string ResourceTypeLabel=>Type switch{ResourceType.Race=>"レース",ResourceType.RaceCard=>"出馬表",ResourceType.RaceOdds=>"オッズ",ResourceType.RaceResult=>"レース結果",ResourceType.Horse=>"競走馬",ResourceType.Jockey=>"騎手",ResourceType.Trainer=>"調教師",_=>ResourceTypeName};
    private string DefinitionLabel=>DefinitionId switch{"race-discovery"=>"開催レースの探索","race-card"=>"出馬表の収集","race-odds"=>"オッズの収集","race-result"=>"レース結果の収集","horse-profile"=>"競走馬情報の収集","jockey-profile"=>"騎手情報の収集","trainer-profile"=>"調教師情報の収集",_=>DefinitionId};
    private string ResourceDescription=>$"{ResourceTypeLabel} ・ {Provider} ・ {ResourceId}";
    private string? DomainUrl=>Type switch{ResourceType.Horse=>$"/horses/{Uri.EscapeDataString(ResourceId)}",ResourceType.Jockey=>$"/jockeys/{Uri.EscapeDataString(ResourceId)}",ResourceType.Trainer=>$"/trainers/{Uri.EscapeDataString(ResourceId)}",_=>null};
    private string BackHref=>!string.IsNullOrWhiteSpace(ReturnUrl)&&ReturnUrl.StartsWith("/jobs",StringComparison.Ordinal)&&!ReturnUrl.StartsWith("//",StringComparison.Ordinal)?ReturnUrl:"/jobs";
    private string StatusLabel=>LatestTask is { } task&&IsActive(task.Status)?TaskStatusLabel(task.Status):ActiveFailure is { } failure?FailureStatusLabel(failure.ResolutionStatus):StoredDataLabel;
    private string StatusTone=>LatestTask is { } task&&IsActive(task.Status)?"info":ActiveFailure?.ResolutionStatus==CollectionFailureResolutionStatus.Open?"danger":StoredDataIsCurrent?"success":"warning";
    private string CurrentTaskLabel=>LatestTask is null?"実行タスクなし":TaskStatusLabel(LatestTask.Status);
    private bool StoredDataIsCurrent=>detail?.State is { LastCollectedAt: not null } state&&state.AppliedRevision>=state.RequiredRevision;
    private string StoredDataLabel=>detail?.State switch{{LastCollectedAt:not null} when StoredDataIsCurrent=>"取得済み",{LastCollectedAt:not null,Status:CollectionStateStatus.Stale}=>"要再取得",{LastCollectedAt:not null}=>"取得履歴あり",_=>"未取得"};
    private string ActiveFailureLabel=>ActiveFailure is null?"未解決なし":FailureStatusLabel(ActiveFailure.ResolutionStatus);
    private int RequestHistoryPages=>Pages(detail?.RequestTotal??0);
    private int TaskHistoryPages=>Pages(detail?.TaskTotal??0);
    private int AttemptHistoryPages=>Pages(detail?.AttemptTotal??0);
    protected override Task OnParametersSetAsync()=>LoadAsync();
    private async Task LoadAsync(){loading=true;errors=[];if(Type is null){errors=["収集対象の種類が正しくありません。"];loading=false;return;}try{detail=await Api.GetCollectionResourceDetailAsync(new(Type.Value,Provider,ResourceId),new(DefinitionId),requestHistoryPage,taskHistoryPage,attemptHistoryPage,HistoryPageSize);if(detail is null)errors=["指定された収集対象は見つかりませんでした。"]; }catch(Exception ex)when(ex is HttpRequestException or TaskCanceledException){errors=["管理APIに接続できません。もう一度お試しください。"]; }finally{loading=false;}}
    private static int Pages(int total)=>Math.Max(1,(int)Math.Ceiling(total/(double)HistoryPageSize));
    private async Task PreviousRequestHistoryAsync(){if(requestHistoryPage<=1)return;requestHistoryPage--;await LoadAsync();}
    private async Task NextRequestHistoryAsync(){if(requestHistoryPage>=RequestHistoryPages)return;requestHistoryPage++;await LoadAsync();}
    private async Task PreviousTaskHistoryAsync(){if(taskHistoryPage<=1)return;taskHistoryPage--;await LoadAsync();}
    private async Task NextTaskHistoryAsync(){if(taskHistoryPage>=TaskHistoryPages)return;taskHistoryPage++;await LoadAsync();}
    private async Task PreviousAttemptHistoryAsync(){if(attemptHistoryPage<=1)return;attemptHistoryPage--;await LoadAsync();}
    private async Task NextAttemptHistoryAsync(){if(attemptHistoryPage>=AttemptHistoryPages)return;attemptHistoryPage++;await LoadAsync();}
    private Task RequestAsync()=>SubmitRequestAsync(null);
    private Task RequestWithExplicitUrlAsync()=>SubmitRequestAsync(explicitUrl?.Trim());
    private async Task SubmitRequestAsync(string? requestedUrl){if(Type is null||detail is null)return;requestErrors=[];operationErrors=[];operationMessage=null;busy=true;try{var task=LatestTask;var revision=Math.Max(task?.RequestedRevision??1,detail.State?.RequiredRevision??1);var result=await Api.RequestCollectionAsync(new(Type.Value,Provider,ResourceId,DefinitionId,revision,CollectionReason.ManualRefresh,task?.Lane??CollectionLane.Normal,task?.Priority??50,string.IsNullOrWhiteSpace(requestedUrl)?null:requestedUrl));if(result.Success&&result.Value is not null){explicitUrl=null;operationMessage=result.Value.CreatedTask?$"収集依頼を受け付けました。タスク {ShortId(result.Value.TaskId)} を作成しました。":$"収集依頼を受け付けました。実行中のタスク {ShortId(result.Value.TaskId)} にまとめました。";await LoadAsync();}else requestErrors=result.Errors;}catch(Exception ex)when(ex is HttpRequestException or TaskCanceledException){requestErrors=["管理APIに接続できません。入力内容を保持しています。しばらくしてからもう一度お試しください。"]; }finally{busy=false;}}
    private async Task CancelAsync(CollectionTaskSummary task){operationErrors=[];operationMessage=null;busy=true;try{var result=await Api.CancelCollectionTaskAsync(task.TaskId);if(result.Success){operationMessage=$"タスク {ShortId(task.TaskId)} を取り消しました。";await LoadAsync();}else operationErrors=result.Errors;}catch(Exception ex)when(ex is HttpRequestException or TaskCanceledException){operationErrors=["管理APIに接続できないため、タスクを取り消せませんでした。もう一度お試しください。"]; }finally{busy=false;}}
    private static bool IsActive(CollectionTaskStatus value)=>value is CollectionTaskStatus.Pending or CollectionTaskStatus.Ready or CollectionTaskStatus.Running or CollectionTaskStatus.RetryWaiting or CollectionTaskStatus.WaitingDiscovery;
    private static string ActiveTaskTitle(CollectionTaskStatus value)=>value==CollectionTaskStatus.Running?"再取得を実行しています":"再取得を待っています";
    private static string ShortId(Guid value)=>value.ToString("D")[..8];
    private string BatchUrl(Guid value)=>$"/jobs/execution-batches/{value:D}?returnUrl={Uri.EscapeDataString(NavigationPath)}";
    private string NavigationPath=>$"/jobs/{Uri.EscapeDataString(ResourceTypeName)}/{Uri.EscapeDataString(Provider)}/{Uri.EscapeDataString(ResourceId)}/{Uri.EscapeDataString(DefinitionId)}";
    private static string BatchTrace(CollectionAttemptSummary value)=>$"実行バッチ: {value.ExecutionBatchId}; Envelope: {value.DispatchEnvelopeId}; Queue message: {value.QueueMessageId}; Lambda request: {value.LambdaRequestId}";
    private static string ReasonLabel(CollectionReason value)=>value switch{CollectionReason.Initial=>"初回収集",CollectionReason.Backfill=>"過去データ収集",CollectionReason.Discovery=>"関連情報の発見",CollectionReason.ScheduledRefresh=>"定期更新",CollectionReason.DefinitionChanged=>"抽出仕様の変更",CollectionReason.ManualRefresh=>"手動再取得",CollectionReason.Recovery=>"失敗からの復旧",_=>value.ToString()};
    private static string TaskStatusLabel(CollectionTaskStatus value)=>value switch{CollectionTaskStatus.Pending=>"登録待ち",CollectionTaskStatus.Ready=>"実行待ち",CollectionTaskStatus.Running=>"実行中",CollectionTaskStatus.RetryWaiting=>"再試行待ち",CollectionTaskStatus.WaitingDiscovery=>"取得先の探索待ち",CollectionTaskStatus.Succeeded=>"完了",CollectionTaskStatus.Failed=>"失敗",CollectionTaskStatus.Cancelled=>"中断",CollectionTaskStatus.DeadLetter=>"要対応",_=>value.ToString()};
    private static string LaneLabel(CollectionLane value)=>value switch{CollectionLane.Realtime=>"リアルタイム",CollectionLane.Normal=>"通常",CollectionLane.Background=>"バックグラウンド",_=>value.ToString()};
    private static string AttemptResultLabel(CollectionAttemptResult value)=>value switch{CollectionAttemptResult.Running=>"実行中",CollectionAttemptResult.Succeeded=>"成功",CollectionAttemptResult.TransientFailure=>"一時的な失敗",CollectionAttemptResult.PermanentFailure=>"恒久的な失敗",CollectionAttemptResult.ResourceNotFound=>"対象なし",CollectionAttemptResult.ResourceNotYetAvailable=>"公開待ち",CollectionAttemptResult.ParseFailure=>"読み取り失敗",CollectionAttemptResult.ValidationFailure=>"内容検証失敗",CollectionAttemptResult.UnexpectedPage=>"別ページを検出",CollectionAttemptResult.AccessLimited=>"アクセス制限",CollectionAttemptResult.Cancelled=>"中断",_=>value.ToString()};
    private static string FailureStatusLabel(CollectionFailureResolutionStatus value)=>value switch{CollectionFailureResolutionStatus.Open=>"要対応",CollectionFailureResolutionStatus.RecoveryInProgress=>"再取得処理中",CollectionFailureResolutionStatus.Resolved=>"解決済み",CollectionFailureResolutionStatus.Superseded=>"新しい障害へ更新",_=>value.ToString()};
    private static string LocationSourceLabel(ResourceLocationSource value)=>value switch{ResourceLocationSource.Explicit=>"手動指定",ResourceLocationSource.Generated=>"規則から生成",ResourceLocationSource.Discovered=>"探索で発見",ResourceLocationSource.Redirected=>"転送先",ResourceLocationSource.Manual=>"管理者登録",_=>value.ToString()};
    private static string LocationStatusLabel(ResourceLocationStatus value)=>value switch{ResourceLocationStatus.Unknown=>"未確認",ResourceLocationStatus.Active=>"利用可能",ResourceLocationStatus.Suspect=>"要再確認",ResourceLocationStatus.Invalid=>"利用不可",_=>value.ToString()};
    private static string Time(DateTimeOffset? value)=>value?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")??"—";
    private static string Duration(CollectionAttemptSummary value)=>value.FinishedAt is null?"実行中":$"{Math.Max(0,(value.FinishedAt.Value-value.StartedAt).TotalSeconds):0.0} 秒";
    private async Task CopyUrlAsync(string value){try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",value);operationMessage="URLをクリップボードへコピーしました。";}catch(JSException){operationErrors=["URLをコピーできませんでした。表示されたURLを選択してコピーしてください。"];}}
}
