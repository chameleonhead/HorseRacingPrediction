@page "/owners"
@attribute [Authorize]
@inject AdminApiClient Api
@inject NavigationManager Navigation

<RaceOpsPageHeader Section="データ" Title="馬主" Description="馬主名または登録表記で検索します。" />

<FluentCard class="filter-card">
    <div class="filter-grid">
        <FluentTextField Label="馬主名・表記" @bind-Value="query" />
        <FluentButton Appearance="@Appearance.Accent" OnClick="@SearchAsync">検索</FluentButton>
    </div>
</FluentCard>

@if (loading && items.Count == 0) { <UiState Kind="loading" Title="馬主を読み込んでいます" /> }
else if (items.Count == 0) { <UiState Title="該当する馬主はありません" Message="表記の一部を変えて検索してください。" /> }
else
{
    @if (loading) { <p class="hint">検索中… 直前の結果を表示しています。</p> }
    <RaceOpsObjectList Label="馬主一覧">
        @foreach (var owner in PagedItems)
        {
            <RaceOpsObjectListItem
                Href="@OwnerUrl(owner.OwnerId)"
                Title="@owner.DisplayName"
                Description="@($"表記 {owner.NameVariants.Count} 件")"
                Metadata="@DisplayMetadata(owner)" />
        }
    </RaceOpsObjectList>
    <Pagination TotalCount="items.Count" Page="page" PageSize="pageSize" PageChanged="GoPage" />
}

@code {
    private string? query;
    private bool loading;
    private IReadOnlyList<OwnerSummaryResponse> items = [];
    private int page = 1;
    private const int pageSize = 50;
    private IEnumerable<OwnerSummaryResponse> PagedItems => items.Skip((page - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        query = q.TryGetValue("query", out var value) ? value.ToString() : null;
        if (int.TryParse(q.TryGetValue("page", out var p) ? p.ToString() : null, out var n) && n > 0) page = n;
        await LoadAsync(resetPage: false);
    }

    private Task SearchAsync() => LoadAsync(resetPage: true);

    private async Task LoadAsync(bool resetPage)
    {
        if (resetPage) page = 1;
        UpdateUrl();
        loading = true;
        try { items = await Api.SearchOwnersAsync(query); }
        finally { loading = false; }
    }

    private Task GoPage(int value)
    {
        page = value;
        UpdateUrl();
        return Task.CompletedTask;
    }

    private void UpdateUrl() => NavigateIfChanged(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/owners", new Dictionary<string, string?> { ["query"] = query, ["page"] = page.ToString() }.Where(x => !string.IsNullOrWhiteSpace(x.Value))));
    private void NavigateIfChanged(string uri)
    {
        if (Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery == Navigation.ToAbsoluteUri(uri).PathAndQuery) return;
        Navigation.NavigateTo(uri, replace: true);
    }
    private static string OwnerUrl(string id) => $"/owners/{Uri.EscapeDataString(id)}";
    private static string DisplayMetadata(OwnerSummaryResponse owner) => $"現在の所有馬 {owner.CurrentHorseCount} 頭 ・ 出走 {owner.ParticipationCount} 戦 ・ 最終出走 {(owner.LastParticipationDate?.ToString("yyyy/MM/dd") ?? "—")}";
}
