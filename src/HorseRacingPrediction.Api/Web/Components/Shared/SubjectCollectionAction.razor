@implements IAsyncDisposable
@inject AdminApiClient Api

<div class="subject-collection-action">
    <FluentButton @ref="requestButton" Appearance="@Appearance.Outline" Disabled="@(checking || sending || Active)" OnClick="@(() => { retry=false; showDialog=true; })">@ButtonLabel</FluentButton>
    @if (Failed)
    {
        <FluentButton Appearance="@Appearance.Outline" Disabled="@sending" OnClick="@(() => { retry=true; showDialog=true; })">失敗分を再試行</FluentButton>
    }
    <div role="status" aria-live="polite">
        @if (status is not null)
        {
            <span>@(History?"過去レース取得":"再取得"): @StatusLabel</span>
            @if (History) { <span>完了 @status.Completed / 発見 @status.Discovered / 失敗 @status.Failed / 対象外 @status.Excluded</span> }
            <a href="@($"/jobs/{Uri.EscapeDataString(status.Job.JobId)}")">処理の詳細</a>
        }
    </div>
    @if (Failed) { <p role="alert">@status!.Job.LastError</p> }
    @if (error is not null) { <p role="alert">@error</p> }
    @if (status?.ExclusionReasons.Count > 0)
    {
        <details><summary>対象外の履歴（@status.Excluded 件）</summary><ul>@foreach(var reason in status.ExclusionReasons) { <li>@reason</li> }</ul></details>
    }
</div>
<div @onkeydown="HandleKey">
<FluentDialog Hidden="@(!showDialog)" HiddenChanged="@(hidden => { if(hidden) Close(); })" Modal="true" TrapFocus="true" AriaLabel="@DialogTitle" Style="width:min(520px, calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="false"><h2>@DialogTitle</h2></FluentDialogHeader>
    <FluentDialogBody>
        <p>@SubjectName</p>
        @if (retry) { <p>@(History ? "完了済みのレースを維持して、失敗した処理から再試行します。" : "失敗したプロフィールの取得を再試行します。")</p> }
        else if (History) { <p>JRAで公開されている出走履歴を辿り、各レースの全出走馬・結果・払戻を取得します。保存済みのレースも、変更点をすべて更新します。</p> }
        else { <p>JRAの公開プロフィールを再取得し、変更点をすべて更新します。</p> }
        <p>取得できなかった項目は、保存済みの情報を残します。</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="Close" Disabled="@sending">キャンセル</FluentButton>
        <FluentButton Appearance="@Appearance.Accent" OnClick="RequestAsync" Disabled="@sending">@(sending?"依頼中…":"取得を依頼")</FluentButton>
    </FluentDialogFooter>
</FluentDialog>
</div>

@code {
    [Parameter,EditorRequired] public string SubjectType { get; set; }="Horse";
    [Parameter,EditorRequired] public string SubjectId { get; set; }="";
    [Parameter,EditorRequired] public string SubjectName { get; set; }="";
    [Parameter] public string Operation { get; set; }="profile";
    [Parameter] public EventCallback OnCompleted { get; set; }
    private SubjectCollectionStatus? status;
    private bool checking=true,sending,showDialog,retry,restoreFocus;
    private string? loadedKey,error;
    private FluentButton? requestButton;
    private CancellationTokenSource lifetime=new();
    private Task? polling;
    private bool History=>Operation=="history";
    private bool Active=>status?.Job.Status is AgentJobStatus.Ready or AgentJobStatus.Pending or AgentJobStatus.Running or AgentJobStatus.WaitingDependency;
    private bool Failed=>status?.Job.Status is AgentJobStatus.Failed or AgentJobStatus.DeadLetter;
    private string ButtonLabel=>sending?"依頼中…":Active?"取得を依頼済み":History?"過去レースを取得":"JRAから再取得";
    private string DialogTitle=>retry?"失敗した処理を再試行":History?"この馬の過去レースを取得":"JRAからプロフィールを再取得";
    private string StatusLabel=>status?.Job.Status switch
    { AgentJobStatus.Running or AgentJobStatus.WaitingDependency=>"取得中",AgentJobStatus.Succeeded=>"完了",AgentJobStatus.Failed or AgentJobStatus.DeadLetter=>"失敗",AgentJobStatus.Cancelled=>"取消済み",_=>"受付済み" };
    private void Close() { if(!sending) {showDialog=false;restoreFocus=true;} }
    private void HandleKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if(showDialog && e.Key=="Escape") Close(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if(restoreFocus && requestButton is not null) {restoreFocus=false;await requestButton.Element.FocusAsync();} }
    protected override async Task OnParametersSetAsync()
    {
        var key=$"{SubjectType}/{SubjectId}/{Operation}";
        if(loadedKey==key) return;
        await StopAsync(); lifetime=new(); loadedKey=key;status=null;checking=true;error=null;showDialog=false;retry=false;
        try {await RefreshAsync(lifetime.Token);}
        catch(Exception ex) when(ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) {error="取得の状態を確認できませんでした。";}
        finally {checking=false;}
        polling=PollAsync(lifetime.Token);
    }
    private async Task RequestAsync()
    {
        if(sending || Active) return;
        sending=true;error=null;
        try
        {
            var response=await Api.RequestSubjectCollectionAsync(SubjectType,SubjectId,Operation,retry,lifetime.Token);
            if(!response.Success) {error="取得を依頼できませんでした。処理状況を確認してお試しください。";return;}
            showDialog=false;await RefreshAsync(lifetime.Token);
        }
        catch(Exception ex) when(ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) {error="通信に失敗しました。処理状況を確認してお試しください。";}
        finally {sending=false;}
    }
    private async Task RefreshAsync(CancellationToken token)
    {
        var previous=status;
        var latest=await Api.GetSubjectCollectionAsync(SubjectType,SubjectId,Operation,token);
        token.ThrowIfCancellationRequested();status=latest;
        if(error=="状態の更新に失敗しました。再接続を待っています。") error=null;
        if(status?.Job.Status is AgentJobStatus.Succeeded or AgentJobStatus.Failed or AgentJobStatus.DeadLetter
            && (sending || (previous is not null && (previous.Job.JobId!=status.Job.JobId || previous.Job.Status!=status.Job.Status))))
            await OnCompleted.InvokeAsync();
    }
    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer=new PeriodicTimer(TimeSpan.FromSeconds(5));
            while(await timer.WaitForNextTickAsync(token)) await InvokeAsync(async()=>
            {
                try {await RefreshAsync(token);}
                catch(Exception ex) when(ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) {error="状態の更新に失敗しました。再接続を待っています。";}
                StateHasChanged();
            });
        }
        catch(OperationCanceledException) when(token.IsCancellationRequested) { }
    }
    private async Task StopAsync() {await lifetime.CancelAsync();if(polling is not null) await polling;lifetime.Dispose();}
    public async ValueTask DisposeAsync()=>await StopAsync();
}
