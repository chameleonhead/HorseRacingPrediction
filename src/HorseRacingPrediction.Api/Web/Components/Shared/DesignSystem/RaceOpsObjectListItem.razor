<a href="@Href" class="object-list-item @LayoutClass">
    <span class="object-list-main">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <span>@Description</span>
        }
    </span>
    @if (!string.IsNullOrWhiteSpace(Status))
    {
        <RaceOpsStatusBadge Label="@Status" Tone="@StatusTone" />
    }
    @if (!string.IsNullOrWhiteSpace(Metadata))
    {
        <span class="object-list-meta">@Metadata</span>
    }
    <span class="object-list-affordance">詳細</span>
</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public string StatusTone { get; set; } = "neutral";
    [Parameter] public string? Metadata { get; set; }
    private string LayoutClass => $"{(string.IsNullOrWhiteSpace(Status) ? "without-status" : string.Empty)} {(string.IsNullOrWhiteSpace(Metadata) ? "without-metadata" : string.Empty)}";
}
