@implements IAsyncDisposable
@inject AdminApiClient Api

<div class="reacquisition-action">
    <FluentButton @ref="requestButton" Appearance="@Appearance.Outline" Disabled="@(sending || checking || Active || !Eligible)" OnClick="@(() => showDialog = true)">
        @(sending ? "依頼中…" : Active ? "再取得を依頼済み" : "JRAから再取得")
    </FluentButton>
    <div role="status" aria-live="polite">
        @if (!Eligible) { <span>JRAの開催日・競馬場・レース番号を確認できません。</span> }
        @if (job is not null)
        {
            <span>再取得: @StatusLabel</span>
            <a href="@JobNavigation.DetailUrl(job.JobId)">処理の詳細</a>
        }
    </div>
    @if (error is not null) { <p role="alert">@error</p> }
</div>

<div @onkeydown="HandleDialogKey">
<FluentDialog Hidden="@(!showDialog)" HiddenChanged="@(hidden => { if (hidden) CloseDialog(); })" Modal="true" TrapFocus="true" AriaLabelledby="race-reacquisition-title" Style="width:min(520px, calc(100vw - 32px));">
    <FluentDialogHeader ShowDismiss="false"><h2 id="race-reacquisition-title">JRAからレース情報を再取得</h2></FluentDialogHeader>
    <FluentDialogBody>
        <p>@(Race.RaceDate?.ToString("yyyy/MM/dd")) @Race.RacecourseCode @(Race.RaceNumber)R @Race.RaceName</p>
        <p>基本情報・出走情報・公開済みの結果と払戻を再取得します。変更が見つかった項目はすべてJRAの情報で更新します。</p>
        <p>取得できなかった項目は、保存済みの情報を残します。</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton OnClick="CloseDialog" Disabled="@sending">キャンセル</FluentButton>
        <FluentButton Appearance="@Appearance.Accent" OnClick="RequestAsync" Disabled="@(sending || Active)">再取得を依頼</FluentButton>
    </FluentDialogFooter>
</FluentDialog>
</div>

@code {
    [Parameter, EditorRequired] public RaceResponse Race { get; set; } = default!;
    [Parameter] public EventCallback OnCompleted { get; set; }
    private string? loadedRaceId;
    private AgentJobDetailReadModel? job;
    private bool sending, checking = true, showDialog;
    private string? error;
    private CancellationTokenSource lifetime = new();
    private Task? polling;
    private FluentButton? requestButton;
    private bool restoreFocus;
    private void CloseDialog() { if (!sending) { showDialog = false; restoreFocus = true; } }
    private void HandleDialogKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) { if (showDialog && e.Key == "Escape") CloseDialog(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoreFocus && requestButton is not null) { restoreFocus = false; await requestButton.Element.FocusAsync(); }
    }
    private bool Eligible => Race.RaceDate is not null && Race.RaceNumber is >= 1 and <= 12
        && CollectionController.RaceReacquisitionEndpointExtensions.ResolveCourse(Race.RacecourseCode) is not null;
    private bool Active => job?.Status is AgentJobStatus.Pending or AgentJobStatus.Ready or AgentJobStatus.Running or AgentJobStatus.WaitingDependency;
    private string StatusLabel => job?.Status switch
    {
        AgentJobStatus.Ready when job.LastError == "公開待ち" => "公開待ち",
        AgentJobStatus.Running => "取得中",
        AgentJobStatus.Succeeded => "完了",
        AgentJobStatus.Failed or AgentJobStatus.DeadLetter => "失敗。処理の詳細を確認して再依頼できます。",
        AgentJobStatus.Cancelled => "取消済み",
        _ => "受付済み"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loadedRaceId == Race.RaceId) return;
        await StopPollingAsync();
        lifetime = new();
        loadedRaceId = Race.RaceId;
        job = null; error = null; showDialog = false; checking = true;
        try { await RefreshStatusAsync(lifetime.Token); }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) { error = "再取得の状態を確認できませんでした。"; }
        finally { checking = false; }
        polling = PollAsync(lifetime.Token);
    }

    private async Task RequestAsync()
    {
        if (sending || Active || !Eligible) return;
        sending = true; error = null;
        try
        {
            var response = await Api.RequestRaceReacquisitionAsync(Race.RaceId, lifetime.Token);
            if (!response.Success) { error = "再取得を依頼できませんでした。時間をおいてお試しください。"; return; }
            showDialog = false;
            await RefreshStatusAsync(lifetime.Token);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) { error = "通信に失敗しました。処理状況を確認してからお試しください。"; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { sending = false; }
    }

    private async Task RefreshStatusAsync(CancellationToken token)
    {
        var previous = job;
        var latest = await Api.GetRaceReacquisitionAsync(Race.RaceId, token);
        token.ThrowIfCancellationRequested();
        job = latest;
        if (error == "状態の更新に失敗しました。再接続を待っています。") error = null;
        if (job?.Status == AgentJobStatus.Succeeded
            && ((previous is not null && (previous.Status != AgentJobStatus.Succeeded || previous.JobId != job.JobId)) || sending))
            await OnCompleted.InvokeAsync();
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    try { await RefreshStatusAsync(token); }
                    catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException) { error = "状態の更新に失敗しました。再接続を待っています。"; }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task StopPollingAsync()
    {
        await lifetime.CancelAsync();
        if (polling is not null) await polling;
        lifetime.Dispose();
    }
    public async ValueTask DisposeAsync() => await StopPollingAsync();
}
