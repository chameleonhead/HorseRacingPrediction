<section class="ui-state @CssClass" role="@Role" aria-live="polite" aria-busy="@(Kind == "loading")">
    <strong>@Title</strong>
    @if (!string.IsNullOrWhiteSpace(Message)) { <span>@Message</span> }
</section>

@code {
    [Parameter] public string Kind { get; set; } = "empty";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    private string CssClass => $"ui-state-{Kind}";
    private string Role => Kind == "error" ? "alert" : "status";
}
