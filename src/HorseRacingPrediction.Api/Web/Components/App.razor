@namespace HorseRacingPrediction.Api.Web.Components
@inject IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>競馬DB管理画面</title>
    <style>@((MarkupString)CriticalCss)</style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <FluentDesignTheme Mode="@DesignThemeModes.Light" CustomColor="#0F6B52" StorageName="raceops-theme">
        <FluentDialogProvider />
        <FluentToastProvider />
        <Routes @rendermode="InteractiveServer" />
    </FluentDesignTheme>
    <script src="_framework/blazor.web.js"></script>
    <script src="raceops.js?v=20260902"></script>
</body>
</html>

@code {
    // 外部<link>だと、レスポンシブな回線の遅さやF5リロードのたびに追加の往復が発生し、
    // その間だけ基本的なCSS（見出しのフォントサイズなど）すら効いていない状態が見えてしまう。
    // 同じHTMLレスポンスに含めることで、初回描画から確実にスタイルが効くようにする。
    private static string? cachedCriticalCss;

    private string CriticalCss => cachedCriticalCss ??= LoadCriticalCss();

    private string LoadCriticalCss()
    {
        var builder = new System.Text.StringBuilder();
        foreach (var path in new[]
        {
            "_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css",
            "HorseRacingPrediction.Api.styles.css",
            "app.css",
        })
        {
            var file = Env.WebRootFileProvider.GetFileInfo(path);
            if (!file.Exists)
            {
                continue;
            }

            using var stream = file.CreateReadStream();
            using var reader = new System.IO.StreamReader(stream);
            builder.AppendLine(reader.ReadToEnd());
        }

        return builder.ToString();
    }
}
