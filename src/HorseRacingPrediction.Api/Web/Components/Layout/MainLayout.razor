@namespace HorseRacingPrediction.Api.Web.Components.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="page">
    <FluentButton class="mobile-menu-button" Appearance="@Appearance.Stealth" aria-expanded="@navOpen" aria-label="メニュー" OnClick="() => navOpen = !navOpen"><span class="hamburger-icon" aria-hidden="true"><i></i><i></i><i></i></span><span>メニュー</span></FluentButton>
    @if (navOpen) { <button class="nav-backdrop" type="button" aria-label="メニューを閉じる" @onclick="() => navOpen = false"></button> }
    <aside class="sidebar @(navOpen ? "open" : null)">
        <div class="brand">
            <span class="brand-text">競馬DB管理</span>
        </div>
        <NavMenu />
        <form method="post" action="/logout" class="logout-form">
            <FluentButton Appearance="@Appearance.Outline" Type="@ButtonType.Submit">ログアウト</FluentButton>
        </form>
    </aside>
    <main class="content">
        <article class="content-inner">
            <ErrorBoundary>
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="exception">
                    <FluentCard class="ui-state ui-state-error" role="alert"><strong>画面を読み込めませんでした</strong><span>通信状態を確認して、もう一度お試しください。</span><FluentButton Appearance="@Appearance.Outline" Href="">再読み込み</FluentButton><details><summary>技術情報</summary><code>@exception.Message</code></details></FluentCard>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    private bool navOpen;

    protected override void OnInitialized()
        => Navigation.LocationChanged += HandleLocationChanged;

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (!navOpen) return;
        navOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Navigation.LocationChanged -= HandleLocationChanged;
}
