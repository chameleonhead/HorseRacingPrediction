@page "/races/{RaceId}"
@inject ApiBrowseClient Api
@inject HorseRacingPrediction.Agents.Workflow.JraRaceCardCollectionWorkflow RaceCardWorkflow
@inject HorseRacingPrediction.Agents.Workflow.JraRaceResultCollectionWorkflow RaceResultWorkflow

<h1>レース詳細</h1>
<p class="hint"><a href="races">← レース検索へ戻る</a></p>

@if (loading) { <p>読み込み中…</p> }
else if (race is null) { <p>RaceId「@RaceId」のレースは見つかりませんでした。</p> }
else
{
    <section class="card">
        <div class="toolbar" style="justify-content: space-between; align-items: flex-start;">
            <div>
                <h2>@(race.RaceName ?? race.RaceId)</h2>
                @if (!string.IsNullOrWhiteSpace(refreshMessage))
                {
                    <p class="hint">@refreshMessage</p>
                }
            </div>
            <button class="btn primary" @onclick="RefreshAsync" disabled="@refreshing">
                @(refreshing ? "再取得中…" : "情報再取得")
            </button>
        </div>
        <dl class="meta">
            <dt>RaceId</dt><dd><code>@race.RaceId</code></dd>
            <dt>日付</dt><dd>@race.RaceDate</dd>
            <dt>競馬場 / R</dt><dd>@race.RacecourseCode / @race.RaceNumber</dd>
            <dt>状態</dt><dd>@race.Status</dd>
            <dt>距離 / 馬場</dt><dd>@FormatDistanceSurface(race.DistanceMeters, race.SurfaceCode, race.DirectionCode)</dd>
            <dt>Grade</dt><dd>@(string.IsNullOrWhiteSpace(race.GradeCode) ? "未設定" : race.GradeCode)</dd>
            <dt>結果確定</dt><dd>@race.ResultDeclaredAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
            <dt>勝ち馬</dt>
            <dd>
                @if (!string.IsNullOrEmpty(race.WinningHorseId))
                {
                    <a href="@($"horses/{Uri.EscapeDataString(race.WinningHorseId!)}")">@race.WinningHorseName</a>
                }
                else { @race.WinningHorseName }
            </dd>
        </dl>
    </section>

    @if (race.Entries.Count > 0)
    {
        <section class="card">
            <h3>出走表</h3>
            <table class="data">
                <thead>
                    <tr>
                        <th>枠番</th>
                        <th>馬番</th>
                        <th>馬名</th>
                        <th>性齢</th>
                        <th>負担体重</th>
                        <th>馬体重</th>
                        <th>騎手</th>
                        <th>調教師</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in race.Entries.OrderBy(x => x.HorseNumber))
                    {
                        <tr>
                            <td>@e.GateNumber</td>
                            <td>@e.HorseNumber</td>
                            <td><a href="@($"horses/{Uri.EscapeDataString(e.HorseId)}")">@(e.HorseName ?? e.HorseId)</a></td>
                            <td>@e.SexCode @e.Age</td>
                            <td>@e.AssignedWeight</td>
                            <td>@FormatBodyWeight(e.DeclaredWeight, e.DeclaredWeightDiff)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(e.JockeyId))
                                {
                                    var claimNote = GetJockeyAllowanceNote(e.JockeyName);
                                    <a href="@($"jockeys/{Uri.EscapeDataString(e.JockeyId!)}")" title="@claimNote">@NormalizeJockeyName(e.JockeyName)</a>
                                }
                            </td>
                            <td>@if (!string.IsNullOrEmpty(e.TrainerId)) { <a href="@($"trainers/{Uri.EscapeDataString(e.TrainerId!)}")">@e.TrainerName</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (race.EntryResults.Count > 0)
    {
        <section class="card">
            <h3>結果</h3>
            <table class="data">
                <thead>
                    <tr>
                        <th>着順</th>
                        <th>枠番</th>
                        <th>馬番</th>
                        <th>馬名</th>
                        <th>タイム</th>
                        <th>着差</th>
                        <th>上り3F</th>
                        <th>賞金</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in race.EntryResults.OrderBy(x => x.FinishPosition ?? int.MaxValue))
                    {
                        <tr>
                            <td>@r.FinishPosition</td>
                            <td>@GetGateNumberByHorseNumber(r.HorseNumber)</td>
                            <td>@r.HorseNumber</td>
                            <td><a href="@($"horses/{Uri.EscapeDataString(r.HorseId)}")">@(r.HorseName ?? r.HorseId)</a></td>
                            <td>@r.OfficialTime</td>
                            <td>@r.MarginText</td>
                            <td>@r.LastThreeFurlongTime</td>
                            <td>@r.PrizeMoney</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(race.StewardReportText))
    {
        <section class="card">
            <h3>レース概況</h3>
            <pre class="payload">@race.StewardReportText</pre>
        </section>
    }
}

@code {
    [Parameter] public string RaceId { get; set; } = string.Empty;

    private bool loading;
    private bool refreshing;
    private RaceDetailDto? race;
    private string? refreshMessage;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            race = await Api.GetRaceAsync(RaceId);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (race is null || refreshing)
        {
            return;
        }

        if (race.RaceDate is null || string.IsNullOrWhiteSpace(race.RacecourseCode) || race.RaceNumber is null)
        {
            refreshMessage = "レース日付・競馬場コード・レース番号が不足しているため再取得できません。";
            return;
        }

        refreshing = true;
        refreshMessage = null;

        try
        {
            var cardResult = await RaceCardWorkflow.CollectRaceAsync(
                race.RaceDate.Value,
                race.RacecourseCode,
                race.RaceNumber.Value);

            HorseRacingPrediction.Agents.Workflow.JraRaceResultCollectionResult? resultResult = null;
            if (race.Status >= HorseRacingPrediction.Agents.Contracts.RaceStatus.ResultDeclared)
            {
                resultResult = await RaceResultWorkflow.CollectRaceAsync(
                    race.RaceDate.Value,
                    race.RacecourseCode,
                    race.RaceNumber.Value);
            }

            var savedCount = cardResult.SavedRaceIds.Count + (resultResult?.SavedRaceIds.Count ?? 0);
            var errorCount = cardResult.Errors.Count + (resultResult?.Errors.Count ?? 0);
            refreshMessage = $"再取得を完了しました。保存: {savedCount} 件 / エラー: {errorCount} 件";

            await LoadAsync();
        }
        catch (Exception ex)
        {
            refreshMessage = $"再取得に失敗しました。{ex.Message}";
        }
        finally
        {
            refreshing = false;
        }
    }

    private int? GetGateNumberByHorseNumber(int horseNumber)
    {
        if (race is null || horseNumber <= 0)
        {
            return null;
        }

        return race.Entries.FirstOrDefault(x => x.HorseNumber == horseNumber)?.GateNumber;
    }

    private static string NormalizeJockeyName(string? jockeyName)
    {
        if (string.IsNullOrWhiteSpace(jockeyName))
        {
            return string.Empty;
        }

        var trimmed = jockeyName.Trim();
        return trimmed.Length > 0 && trimmed[0] is '▲' or '△' or '☆' or '★' or '◇'
            ? trimmed.Substring(1).TrimStart()
            : trimmed;
    }

    private static string? GetJockeyAllowanceNote(string? jockeyName)
    {
        if (string.IsNullOrWhiteSpace(jockeyName))
        {
            return null;
        }

        return jockeyName.Trim()[0] switch
        {
            '▲' => "見習騎手の減量記号（3kg減）",
            '△' => "見習騎手の減量記号（2kg減）",
            '☆' => "見習騎手の減量記号（1kg減）",
            '★' => "女性騎手の減量記号（4kg減）",
            '◇' => "女性騎手の減量記号（2kg減）",
            _ => null,
        };
    }

    private static string FormatBodyWeight(decimal? bodyWeight, decimal? bodyWeightDiff)
    {
        if (!bodyWeight.HasValue)
        {
            return string.Empty;
        }

        if (!bodyWeightDiff.HasValue || bodyWeightDiff.Value == 0m)
        {
            return bodyWeight.Value.ToString("0.#");
        }

        var diffPrefix = bodyWeightDiff.Value > 0m ? "+" : string.Empty;
        return $"{bodyWeight.Value:0.#} ({diffPrefix}{bodyWeightDiff.Value:0.#})";
    }

    private static string FormatDistanceSurface(int? distanceMeters, string? surfaceCode, string? directionCode)
    {
        var distance = distanceMeters.HasValue ? $"{distanceMeters.Value}m" : "未設定";
        var surface = string.IsNullOrWhiteSpace(surfaceCode) ? "未設定" : surfaceCode;
        var direction = string.IsNullOrWhiteSpace(directionCode) ? string.Empty : $" {directionCode}";
        return $"{distance} / {surface}{direction}";
    }
}
