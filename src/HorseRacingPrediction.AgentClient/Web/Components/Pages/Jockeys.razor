@page "/jockeys"
@inject ApiBrowseClient Api

<h1>騎手検索</h1>
<div class="toolbar">
    <label>キーワード: <input @bind="query" placeholder="騎手名 / ID" /></label>
    <button class="btn primary" @onclick="LoadAsync">検索</button>
</div>

@if (loading) { <p>読み込み中…</p> }
else if (result is null || result.Items.Count == 0) { <p>該当データはありません。</p> }
else
{
    <p class="hint">@result.TotalCount 件中 @((page - 1) * pageSize + 1) – @Math.Min(page * pageSize, result.TotalCount) 件目</p>
    <table class="data">
        <thead>
            <tr><th>騎手名</th><th>所属</th><th>別名数</th></tr>
        </thead>
        <tbody>
            @foreach (var j in result.Items)
            {
                <tr>
                    <td><a href="@($"jockeys/{Uri.EscapeDataString(j.JockeyId)}")">@j.DisplayName</a></td>
                    <td>@j.AffiliationCode</td>
                    <td>@j.AliasCount</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="toolbar">
        <button class="btn" disabled="@(page <= 1)" @onclick="() => GoAsync(page - 1)">前</button>
        <span>@(page) / @result.TotalPages</span>
        <button class="btn" disabled="@(page >= result.TotalPages)" @onclick="() => GoAsync(page + 1)">次</button>
    </div>
}

@code {
    private string? query;
    private int page = 1;
    private int pageSize = 50;
    private bool loading;
    private PagedResultDto<JockeySummaryDto>? result;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try { result = await Api.SearchJockeysAsync(query, page, pageSize); }
        finally { loading = false; }
    }

    private async Task GoAsync(int p) { page = p; await LoadAsync(); }
}
