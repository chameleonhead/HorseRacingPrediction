{
  "ApiClient": {
    "BaseUrl": "http://localhost:5177",
    "ApiKey": "dev-api-key"
  },
  "AgentProcessing": {
    "Enabled": true,
    "StateDirectory": "",
    "JobStoreFileName": "processing-jobs.db",
    "ScrapingIntervalMinutes": 180,
    "CollectionExecutionIntervalMinutes": 5,
    "CollectionBatchSize": 5,
    "MaxConcurrentJobs": 1,
    "CollectionLeaseMinutes": 30,
    "EnablePredictionExecution": true,
    "PredictionIntervalMinutes": 60,
    "PredictionMinAgeMinutes": 10,
    "PredictionLeaseMinutes": 30,
    "PredictionBatchSize": 10,
    "BlockPredictionWhileHistoricalRequestsPending": true,
    "HistoricalRequestRetryDelayMinutes": 15,
    "HistoricalRequestExecutionIntervalMinutes": 5,
    "HistoricalRequestBatchSize": 5,
    "HistoricalRequestLeaseMinutes": 30,
    "HistoricalRequestMaxAttempts": 3,
    "InitialResultBackfillYears": 3,
    "ResultLookbackDays": 1,
    "LiveResultLookbackDays": 0,
    "PreRaceResultLookbackDays": 1,
    "ResultLookaheadDays": 0,
    "EnableScheduleCollection": true,
    "EnableRaceCardCollection": true,
    "ScheduleLookaheadDays": 14,
    "PreRaceLeadDays": 1,
    "EnableRaceResultCollection": true,
    "SuppressHistoricalBackfillDuringLive": true,
    "EnableTextInsightCollection": true,
    "TextInsightQueryTemplates": [
      "{RaceDate} {RacecourseCode} {RaceNumber}R {RaceName} 展望"
    ]
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
