{
  "ApiClient": {
    // クラウド API のベース URL (例: https://your-api.example.com)
    "BaseUrl": "",
    // API キー (X-Api-Key ヘッダーに設定されます)
    "ApiKey": ""
  },
  "AgentProcessing": {
    "Enabled": true,
    "StateDirectory": "",
    "ScrapingIntervalMinutes": 180,
    "PredictionIntervalMinutes": 60,
