    "TextInsightQueryTemplates": [
      "{RaceDate} {RacecourseCode} {RaceNumber}R {RaceName} 展望",
      "{RaceDate} {RacecourseCode} {RaceNumber}R 馬場傾向",
      "{RaceDate} {RacecourseCode} {RaceNumber}R 注目馬"
    ]
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o"
  },
  "WebFetch": {
    "AllowedDomains": [
      "www.jra.go.jp",
      "db.netkeiba.com",
      "race.netkeiba.com",
      "www.netkeiba.com",
      "duckduckgo.com"
    ],
    "SearchBaseUrl": "https://duckduckgo.com/?q=",
    "SearchResultsToFetch": 3
