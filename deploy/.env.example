IMAGE_NAME=ghcr.io/your-github-user/horse-racing-prediction-api
IMAGE_TAG=latest
# Required: a real hostname Caddy can obtain a trusted certificate for (not empty, not a bare IP).
# Without your own domain, use sslip.io: "<LIGHTSAIL_HOST with dots replaced by dashes>.sslip.io".
DOMAIN_NAME=203-0-113-10.sslip.io
ACME_EMAIL=
HORSE_RACING_API_KEY=replace-with-production-api-key
COLLECTION_MONITORING_ENABLED=true
COLLECTION_MONITORING_CHANGE_RECORD_ENABLED=true
COLLECTION_MONITORING_RECOVERY_ENABLED=true
COLLECTION_MONITORING_MAINTENANCE_MODE=false
COLLECTION_MONITORING_CANARY_LIMIT=5
LIGHTSAIL_HOST=203.0.113.10
