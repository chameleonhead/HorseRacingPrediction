#!/bin/sh
set -eu

. "${COLLECTOR_TEMP_HELPER:-/var/runtime/collector-temp-lifecycle.sh}"
collector_temp_initialize

current_invocation_dir=''
collector_pid=''
collector_pgid=''
collector_group_valid='false'
collector_descendant_file=''
descendant_monitor_pid=''
collector_session_command="${COLLECTOR_SESSION_COMMAND:-/usr/bin/setsid}"
cleanup_current_invocation() {
  if [ -n "$current_invocation_dir" ]; then
    collector_temp_log_diagnostic pre-delete "$current_invocation_dir" false >&2
    finished_invocation_dir="$current_invocation_dir"
    collector_temp_finish_invocation "$current_invocation_dir"
    current_invocation_dir=''
    collector_temp_log_diagnostic post-delete "$finished_invocation_dir" false >&2
  fi
}
collector_group_is_safe() {
  case "$collector_pgid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$collector_group_valid" = 'true' ] || return 1
  [ "$collector_pgid" -gt 1 ] || return 1
  [ "$collector_pgid" -ne "$$" ] || return 1
  bootstrap_pgid="$(awk '{ print $5 }' "/proc/$$/stat" 2>/dev/null || true)"
  [ -n "$bootstrap_pgid" ] && [ "$collector_pgid" -ne "$bootstrap_pgid" ]
}
collector_group_is_alive() {
  collector_group_is_safe && kill -0 "-$collector_pgid" 2>/dev/null
}
record_descendants() {
  parent_pid="$1"
  output_file="$2"
  children_file="/proc/$parent_pid/task/$parent_pid/children"
  [ -r "$children_file" ] || return 0
  for descendant_pid in $(cat "$children_file" 2>/dev/null || true); do
    descendant_start="$(awk '{ print $22 }' "/proc/$descendant_pid/stat" 2>/dev/null || true)"
    case "$descendant_pid" in ''|*[!0-9]*) continue ;; esac
    case "$descendant_start" in ''|*[!0-9]*) continue ;; esac
    if ! grep -q "^$descendant_pid $descendant_start$" "$output_file" 2>/dev/null; then
      printf '%s %s\n' "$descendant_pid" "$descendant_start" >>"$output_file"
    fi
    record_descendants "$descendant_pid" "$output_file"
  done
}
monitor_collector_descendants() {
  root_pid="$1"
  output_file="$2"
  : >"$output_file"
  while kill -0 "$root_pid" 2>/dev/null; do
    record_descendants "$root_pid" "$output_file"
    sleep 0.02
  done
  record_descendants "$root_pid" "$output_file"
}
stop_descendant_monitor() {
  if [ -n "$descendant_monitor_pid" ]; then
    kill -TERM "$descendant_monitor_pid" 2>/dev/null || true
    wait "$descendant_monitor_pid" 2>/dev/null || true
    descendant_monitor_pid=''
  fi
}
log_descendant_diagnostic() {
  phase="$1"
  captured=0
  alive=0
  outside_group=0
  deleted_fds=0
  if [ -n "$collector_descendant_file" ] && [ -f "$collector_descendant_file" ]; then
    while read -r descendant_pid descendant_start; do
      case "$descendant_pid" in ''|*[!0-9]*) continue ;; esac
      case "$descendant_start" in ''|*[!0-9]*) continue ;; esac
      captured=$((captured + 1))
      current_start="$(awk '{ print $22 }' "/proc/$descendant_pid/stat" 2>/dev/null || true)"
      [ "$current_start" = "$descendant_start" ] || continue
      alive=$((alive + 1))
      descendant_pgid="$(awk '{ print $5 }' "/proc/$descendant_pid/stat" 2>/dev/null || true)"
      if [ -n "$collector_pgid" ] && [ "$descendant_pgid" != "$collector_pgid" ]; then
        outside_group=$((outside_group + 1))
      fi
      for fd in "/proc/$descendant_pid/fd"/*; do
        [ -L "$fd" ] || continue
        fd_target="$(readlink "$fd" 2>/dev/null || true)"
        case "$fd_target" in
          *' (deleted)') deleted_fds=$((deleted_fds + 1)) ;;
        esac
      done
    done <"$collector_descendant_file"
  fi
  printf 'Collector descendant diagnostic. Phase=%s Captured=%s Alive=%s OutsideGroup=%s DeletedFds=%s\n' \
    "$phase" "$captured" "$alive" "$outside_group" "$deleted_fds" >&2
}
terminate_collector_group() {
  collector_group_is_safe || return 0
  group_alive=false
  collector_group_is_alive && group_alive=true
  if [ -n "$current_invocation_dir" ]; then
    collector_temp_log_diagnostic pre-group-termination "$current_invocation_dir" "$group_alive" >&2
  fi
  log_descendant_diagnostic pre-group-termination
  kill -TERM "-$collector_pgid" 2>/dev/null || true
  attempts=0
  while kill -0 "-$collector_pgid" 2>/dev/null && [ "$attempts" -lt 20 ]; do
    sleep 0.05
    attempts=$((attempts + 1))
  done
  if kill -0 "-$collector_pgid" 2>/dev/null; then
    kill -KILL "-$collector_pgid" 2>/dev/null || true
  fi
  group_alive=false
  kill -0 "-$collector_pgid" 2>/dev/null && group_alive=true
  if [ -n "$current_invocation_dir" ]; then
    collector_temp_log_diagnostic post-group-termination "$current_invocation_dir" "$group_alive" >&2
  fi
  log_descendant_diagnostic post-group-termination
  collector_group_valid='false'
  collector_pgid=''
}
terminate_bootstrap() {
  exit_status="$1"
  stop_descendant_monitor
  if [ -n "$collector_pid" ]; then
    if collector_group_is_safe; then
      terminate_collector_group
    else
      kill -TERM "$collector_pid" 2>/dev/null || true
    fi
    wait "$collector_pid" 2>/dev/null || true
    collector_pid=''
  fi
  exit "$exit_status"
}
trap cleanup_current_invocation EXIT
trap 'terminate_bootstrap 129' HUP
trap 'terminate_bootstrap 130' INT
trap 'terminate_bootstrap 143' TERM

run_collector() {
  invocation_dir="$1"
  shift
  session_ready="$invocation_dir/.session-ready"
  session_go="$invocation_dir/.session-go"
  [ -x "$collector_session_command" ] || {
    echo 'Collector session command is unavailable; refusing to run without process-group isolation.' >&2
    return 1
  }
  collector_group_valid='false'
  collector_pgid=''
  HOME="$invocation_dir/home" \
  XDG_CACHE_HOME="$invocation_dir/cache" \
  XDG_CONFIG_HOME="$invocation_dir/config" \
  TMPDIR="$invocation_dir/tmp" \
    "$collector_session_command" sh -c '
      ready="$1"
      go="$2"
      shift 2
      printf "%s\n" "$$" >"$ready"
      while [ ! -e "$go" ]; do sleep 0.01; done
      ulimit -c 0
      exec "$@"
    ' sh "$session_ready" "$session_go" \
      "${COLLECTOR_EXECUTABLE:-/var/task/HorseRacingPrediction.Collector}" "$@" &
  collector_pid=$!
  attempts=0
  while [ ! -s "$session_ready" ] && kill -0 "$collector_pid" 2>/dev/null && [ "$attempts" -lt 100 ]; do
    sleep 0.01
    attempts=$((attempts + 1))
  done
  session_pid=''
  if [ -s "$session_ready" ]; then
    session_pid="$(cat "$session_ready")"
  fi
  session_pgid="$(awk '{ print $5 }' "/proc/$collector_pid/stat" 2>/dev/null || true)"
  if [ "$session_pid" != "$collector_pid" ] || [ "$session_pgid" != "$collector_pid" ]; then
    echo 'Collector process-group isolation could not be verified; refusing to start the collector.' >&2
    kill -TERM "$collector_pid" 2>/dev/null || true
    wait "$collector_pid" 2>/dev/null || true
    collector_pid=''
    return 1
  fi
  collector_pgid="$collector_pid"
  collector_group_valid='true'
  collector_descendant_file="$invocation_dir/.descendant-pids"
  : >"$session_go"
  monitor_collector_descendants "$collector_pid" "$collector_descendant_file" &
  descendant_monitor_pid=$!
  collector_status=0
  wait "$collector_pid" || collector_status=$?
  stop_descendant_monitor
  terminate_collector_group
  collector_pid=''
  collector_descendant_file=''
  return "$collector_status"
}

if [ -z "${AWS_LAMBDA_RUNTIME_API:-}" ]; then
  current_invocation_dir="$(collector_temp_begin_invocation)"
  collector_temp_log_metrics start >&2
  collector_status=0
  run_collector "$current_invocation_dir" --once || collector_status=$?
  cleanup_current_invocation
  collector_temp_log_metrics finish >&2
  exit "$collector_status"
fi

while true; do
  current_invocation_dir="$(collector_temp_begin_invocation)"
  collector_temp_log_metrics start >&2
  headers_file="$current_invocation_dir/lambda-headers"
  event_file="$current_invocation_dir/lambda-event.json"
  curl -sS -D "$headers_file" -o "$event_file" \
    "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/next"
  request_id="$(sed -n 's/\r$//; s/^[Ll]ambda-[Rr]untime-[Aa]ws-[Rr]equest-[Ii]d:[[:space:]]*//p' "$headers_file")"
  deadline_ms="$(sed -n 's/\r$//; s/^[Ll]ambda-[Rr]untime-[Dd]eadline-[Mm]s:[[:space:]]*//p' "$headers_file")"
  if [ -z "$request_id" ] || [ -z "$deadline_ms" ]; then
    echo 'Lambda invocation headers were incomplete; refusing to run the collector.' >&2
    exit 1
  fi

  failure_reason_file="$current_invocation_dir/collector-failure-reason.txt"
  response_file="$current_invocation_dir/collector-response.json"

  if COLLECTOR_EVENT_PATH="$event_file" COLLECTOR_RESPONSE_PATH="$response_file" \
      AWS_LAMBDA_REQUEST_ID="$request_id" AWS_LAMBDA_DEADLINE_MS="$deadline_ms" \
      run_collector "$current_invocation_dir" --once; then
    response_json='{"batchItemFailures":[]}'
    if [ -s "$response_file" ]; then
      response_json="$(cat "$response_file")"
    fi
    curl -sS -X POST \
      "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/${request_id}/response" \
      -H 'Content-Type: application/json' -d "$response_json" >/dev/null
  else
    # Collectorが原因を特定できた場合（例: 内部デッドラインのタイムアウト）は
    # /tmp/collector-failure-reason.txt に理由を書き出しているので、それを
    # CloudWatch Logsで判別できるようエラーメッセージに反映する。
    error_message="Collector execution failed"
    if [ -s "$failure_reason_file" ]; then
      error_message="$(cat "$failure_reason_file")"
    fi
    error_message_json=$(printf '%s' "$error_message" | sed 's/\\/\\\\/g; s/"/\\"/g')
    curl -sS -X POST \
      "http://${AWS_LAMBDA_RUNTIME_API}/2018-06-01/runtime/invocation/${request_id}/error" \
      -H 'Content-Type: application/json' -d "{\"errorMessage\":\"${error_message_json}\"}" >/dev/null
  fi
  cleanup_current_invocation
  collector_temp_log_metrics finish >&2
  if [ "${COLLECTOR_BOOTSTRAP_TEST_ONCE:-}" = "1" ]; then
    exit 0
  fi
done
