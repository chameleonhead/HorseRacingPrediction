# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash logs
crash.log
crash.*.log