FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .
RUN dotnet publish src/HorseRacingPrediction.Collector/HorseRacingPrediction.Collector.csproj \
    -c Release -o /opt/collector /p:UseAppHost=false

FROM mcr.microsoft.com/playwright/dotnet:v1.60.0-noble
WORKDIR /var/task

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/collector ./
COPY deploy/lambda-bootstrap /var/runtime/bootstrap
RUN chmod 0755 /var/runtime/bootstrap /var/task/.playwright/node/linux-x64/node \
    && test -x /var/task/.playwright/node/linux-x64/node

ENV ASPNETCORE_URLS=http://127.0.0.1:8080
ENTRYPOINT ["/var/runtime/bootstrap"]
